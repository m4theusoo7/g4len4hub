local function findKeyTool()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "key", 1, true) then
                return item, true
            end
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and string.find(string.lower(item.Name), "key", 1, true) then
                return item, false
            end
        end
    end

    return nil, false
end

local function equipKey()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local keyTool, isEquipped = findKeyTool()
    if keyTool and not isEquipped and hum then
        hum:EquipTool(keyTool)
    end
    return keyTool
end

local function isDoorAlreadyUsed()
    if not CommF then return false end
    local ok, prog = pcall(function()
        return CommF:InvokeServer("DressrosaQuestProgress")
    end)
    if ok and type(prog) == "table" and prog.UsedKey then
        return true
    end
    return false
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(character, enabled)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")

    if hum and enabled then
        hum.Sit = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaDoorBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaDoorBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
            if not enabled then
                part.CanTouch = true
            end
        end
    end
end

local function tweenTo(hrp, targetPos)
    local dist = (hrp.Position - targetPos).Magnitude
    if dist <= 3.5 then
        cancelTween()
        return true
    end

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetPos).Magnitude <= 4 then
        return false
    end

    cancelTween()
    LastTweenTarget = targetPos
    local duration = math.max(dist / Config.TweenSpeed, 0.1)
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    CurrentTween:Play()
    return false
end

local function useExitPortal(hrp, portalPart, fallbackPos)
    local targetPos = (portalPart and portalPart.Position) or fallbackPos
    if (hrp.Position - targetPos).Magnitude > 14 then
        tweenTo(hrp, targetPos + Vector3.new(0, 2, 0))
        return
    end

    cancelTween()
    local t = os.clock()
    local offset = Vector3.new(math.cos(t * 6) * 2.5, math.sin(t * 8) * 2, math.sin(t * 6) * 2.5)
    hrp.CFrame = CFrame.new(targetPos + offset)
    hrp.AssemblyLinearVelocity = Vector3.zero

    if (t - LastPortalTouch) >= 0.3 then
        LastPortalTouch = t
        if portalPart and firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, portalPart, 0)
                task.wait(0.03)
                firetouchinterest(hrp, portalPart, 1)
            end)
        end
    end
end

local function moveTo(hrp, targetPos)
    local map = workspace:FindFirstChild("Map")

    if hrp.Position.Y > 4000 then
        local skyArea2 = map and map:FindFirstChild("SkyArea2")
        local exitPart = skyArea2 and skyArea2:FindFirstChild("Exit")
        useExitPortal(hrp, exitPart, Config.SkyArea2ExitPos)
        return false
    end

    if hrp.Position.X > 50000 then
        local tpSpawn = map and map:FindFirstChild("TeleportSpawn")
        local exitPart = tpSpawn and tpSpawn:FindFirstChild("Exit")
        useExitPortal(hrp, exitPart, Config.UnderwaterExitPos)
        return false
    end

    return tweenTo(hrp, targetPos)
end

-- Localiza a ancora da caverna usando o spawn do Ice Admiral ou Frozen Village
local function getCaveAnchorPos()
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")

    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if sp:IsA("BasePart") and string.find(string.lower(sp.Name), "ice admiral", 1, true) then
                return sp.Position
            end
        end
    end

    local locations = worldOrigin and worldOrigin:FindFirstChild("Locations")
    if locations then
        for _, loc in ipairs(locations:GetChildren()) do
            if loc:IsA("BasePart") then
                local low = string.lower(loc.Name)
                if string.find(low, "frozen", 1, true) or string.find(low, "ice", 1, true) then
                    return loc.Position + Vector3.new(0, 20, 0)
                end
            end
        end
    end

    return Config.CaveDoorFallback
end

-- Procura dinamicamente a porta de madeira na caverna de Frozen Village
local function findCaveDoor(anchorPos)
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end

    -- 1. Busca direta em pastas da ilha de gelo
    for _, folder in ipairs(map:GetChildren()) do
        local low = string.lower(folder.Name)
        if string.find(low, "ice", 1, true) or string.find(low, "frozen", 1, true) then
            for _, obj in ipairs(folder:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local objLow = string.lower(obj.Name)
                    if objLow == "door" or string.find(objLow, "door", 1, true) then
                        return obj
                    end
                end
            end
        end
    end

    -- 2. Busca por proximidade ao spawn do Ice Admiral (ignora baus)
    local bestDoor = nil
    local bestDist = 180

    for _, folder in ipairs(map:GetChildren()) do
        for _, obj in ipairs(folder:GetDescendants()) do
            if obj:IsA("BasePart") then
                local fullLow = string.lower(obj:GetFullName())
                local isChest = string.find(fullLow, "chest", 1, true)
                local hasInteract = obj:FindFirstChildOfClass("TouchTransmitter") or obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildOfClass("ClickDetector")
                local isDoorName = string.find(string.lower(obj.Name), "door", 1, true)

                if not isChest and (isDoorName or hasInteract) then
                    local d = (obj.Position - anchorPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestDoor = obj
                    end
                end
            end
        end
    end

    return bestDoor
end

