_G.OmegaSea2_AbrirPorta = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    PrisonPos = Vector3.new(4854.17, 25.00, 740.19),
    IceAdmiralPos = Vector3.new(1347.70, 37.30, -1385.00),
    TweenSpeed = 225
}

local CurrentTween = nil
local LastTweenTarget = nil

-- Barra de status no topo
local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaDoorUnlockUI") then
    parentGui.OmegaDoorUnlockUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaDoorUnlockUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 52)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Chave + Porta] Verificando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Chave + Porta] " .. msg
    if color then StatusBox.TextColor3 = color end
end

local function findKey()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    for _, c in ipairs({ char, bp }) do
        if c then
            for _, item in ipairs(c:GetChildren()) do
                if item:IsA("Tool") and string.find(string.lower(item.Name), "key", 1, true) then
                    return item
                end
            end
        end
    end
    return nil
end

local function getProgress()
    if not CommF then return nil end
    local ok, res = pcall(function()
        return CommF:InvokeServer("DressrosaQuestProgress")
    end)
    return (ok and type(res) == "table") and res or nil
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaDoorBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaDoorBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = not enabled
        end
    end
end

local function tweenTo(hrp, targetPos)
    local dist = (hrp.Position - targetPos).Magnitude
    if dist <= 4 then
        cancelTween()
        return true
    end
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetPos).Magnitude <= 4 then
        return false
    end
    cancelTween()
    LastTweenTarget = targetPos
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.1), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    CurrentTween:Play()
    return false
end

local function findCaveDoor()
    local map = workspace:FindFirstChild("Map")
    if not map then return nil end
    local best, bestDist = nil, 250
    for _, obj in ipairs(map:GetDescendants()) do
        if obj:IsA("BasePart") and string.find(string.lower(obj.Name), "door", 1, true) then
            local d = (obj.Position - Config.IceAdmiralPos).Magnitude
            if d < bestDist then
                bestDist = d
                best = obj
            end
        end
    end
    return best
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_AbrirPorta then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while _G.OmegaSea2_AbrirPorta do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            cancelTween()
            task.wait(0.5)
        else
            setPhysics(char, true)

            local prog = getProgress()
            local door = findCaveDoor()

            -- Verifica se a porta ja sumiu ou o servidor confirmou UsedKey
            if (prog and prog.UsedKey) or (door and door.Transparency >= 0.9 and not door.CanCollide) then
                cancelTween()
                setStatus("PORTA ABERTA! Agora o Ice Admiral toma dano normalmente. Rode a Missao 3!", Color3.fromRGB(120, 255, 160))
                break
            end

            local keyTool = findKey()
            if not keyTool then
                -- ETAPA A: Ir ate a Prison pegar a Key com o Military Detective
                local npcs = workspace:FindFirstChild("NPCs")
                local detective = npcs and npcs:FindFirstChild("Military Detective")
                local detHrp = detective and detective:FindFirstChild("HumanoidRootPart")

                if not detHrp then
                    setStatus("Indo ate a Prison buscar a Key...", Color3.fromRGB(255, 215, 90))
                    tweenTo(hrp, Config.PrisonPos)
                    if (hrp.Position - Config.PrisonPos).Magnitude <= 90 then
                        pcall(function() LocalPlayer:RequestStreamAroundAsync(Config.PrisonPos) end)
                    end
                else
                    local talkPos = detHrp.Position + Vector3.new(0, 2, 3.5)
                    if not tweenTo(hrp, talkPos) then
                        setStatus("Aproximando do Military Detective...", Color3.fromRGB(255, 215, 90))
                    else
                        setStatus("Falando com Military Detective...", Color3.fromRGB(120, 200, 255))
                        if CommF then
                            pcall(function() CommF:InvokeServer("DressrosaQuestProgress") end)
                            task.wait(0.15)
                            pcall(function() CommF:InvokeServer("DressrosaQuestProgress", "Detective") end)
                        end
                        task.wait(0.6)
                    end
                end
            else
                -- ETAPA B: Levar a Key ate a porta de madeira em Frozen Village
                local doorPos = door and door.Position or (Config.IceAdmiralPos + Vector3.new(0, 0, 55))
                if not tweenTo(hrp, doorPos + Vector3.new(0, 1, 3)) then
                    setStatus("Levando a Key ate a porta de madeira em Frozen Village...", Color3.fromRGB(255, 215, 90))
                else
                    setStatus("Equipando Key e abrindo a porta...", Color3.fromRGB(120, 200, 255))
                    if keyTool.Parent ~= char then
                        hum:EquipTool(keyTool)
                        task.wait(0.15)
                    end
                    hrp.CFrame = CFrame.new(doorPos)
                    pcall(function() keyTool:Activate() end)
                    if door and firetouchinterest then
                        pcall(function()
                            firetouchinterest(hrp, door, 0)
                            task.wait(0.05)
                            firetouchinterest(hrp, door, 1)
                        end)
                    end
                    if CommF then
                        pcall(function() CommF:InvokeServer("DressrosaQuestProgress", "UseKey") end)
                    end
                    task.wait(0.5)
                end
            end

            RunService.Heartbeat:Wait()
        end
    end

    _G.OmegaSea2_AbrirPorta = false
    if noclipConn then noclipConn:Disconnect() end
    cancelTween()
    setPhysics(LocalPlayer.Character, false)
end)
