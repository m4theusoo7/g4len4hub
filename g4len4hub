            -- O segredo está aqui: string.find resolve o problema do nome!
            if enemy.Name:find(mobName) and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (myPos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
