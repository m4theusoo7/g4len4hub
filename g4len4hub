-- ====================================================
-- Blox Fruits Auto Farm - Frozen Village (Lv. 90 - 120)
-- Estilo de UI e Automação idêntico ao vídeo (Stop Tween / Auto Quest / Tween)
-- Compatível com Delta Executor
-- ====================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

getgenv().AutoFarmFrozen = true

-- Criar UI Flutuante com "Stop Tween" (idêntico ao vídeo)
local ScreenGui = Instance.new("ScreenGui")
local StopButton = Instance.new("TextButton")

ScreenGui.Name = "AutoFarmUI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

StopButton.Name = "StopTweenButton"
StopButton.Parent = ScreenGui
StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
StopButton.Position = UDim2.new(0, 20, 0, 50)
StopButton.Size = UDim2.new(0, 110, 0, 45)
StopButton.Font = Enum.Font.SourceSansBold
StopButton.Text = "Stop Tween"
StopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
StopButton.TextSize = 16
StopButton.Active = true
StopButton.Draggable = true

StopButton.MouseButton1Click:Connect(function()
    getgenv().AutoFarmFrozen = not getgenv().AutoFarmFrozen
    if getgenv().AutoFarmFrozen then
        StopButton.Text = "Stop Tween"
        StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    else
        StopButton.Text = "Resumir Farm"
        StopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Anti-AFK para evitar desconexão
local connections = getconnections(LocalPlayer.Idled)
for _, connection in ipairs(connections) do
    connection:Disable()
end

-- Função para alternar o alvo e a missão de acordo com a progressão de nível (90 a 120+)
local function getTargetData()
    local level = LocalPlayer.Data.Level.Value
    if level < 100 then
        return {
            Name = "Snow Bandit",
            QuestName = "SnowQuest",
            QuestIndex = 1,
            CFrame = CFrame.new(1385, 105, -1300) -- NPC / Spawn dos Bandidos da Neve
        }
    elseif level < 110 then
        return {
            Name = "Snow Trooper",
            QuestName = "SnowQuest",
            QuestIndex = 2,
            CFrame = CFrame.new(1150, 145, -1540) -- NPC / Spawn dos Snow Troopers
        }
    else
        return {
            Name = "Yeti",
            QuestName = "SnowQuest",
            QuestIndex = 3,
            CFrame = CFrame.new(1185, 110, -1580) -- Chefe Yeti
        }
    end
end

-- Loop Principal de Auto Farm
task.spawn(function()
    while task.wait(0.1) do
        if getgenv().AutoFarmFrozen then
            pcall(function()
                local target = getTargetData()
                
                -- Ativar Haki (Buso) automaticamente
                if not LocalPlayer.Character.HumanoidRootPart:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end

                -- Verificar se a UI de Quest está visível (se precisa pegar missão)
                local questGui = LocalPlayer.PlayerGui.Main.Quest
                if not questGui.Visible then
                    local rootPart = LocalPlayer.Character.HumanoidRootPart
                    local dist = (rootPart.Position - target.CFrame.Position).Magnitude
                    local tweenInfo = TweenInfo.new(dist / 250, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = target.CFrame})
                    tween:Play()
                    tween.Completed:Wait()
                    
                    task.wait(0.5)
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", target.QuestName, target.QuestIndex)
                    task.wait(1)
                else
                    -- Procurar inimigo ativo no Workspace
                    local enemyFolder = Workspace.Enemies:FindFirstChild(target.Name)
                    if enemyFolder and enemyFolder:FindFirstChild("HumanoidRootPart") and enemyFolder:FindFirstChild("Humanoid") then
                        if enemyFolder.Humanoid.Health > 0 then
                            local rootPart = LocalPlayer.Character.HumanoidRootPart
                            local enemyRoot = enemyFolder.HumanoidRootPart
                            local dist = (rootPart.Position - enemyRoot.Position).Magnitude
                            
                            if dist > 15 then
                                local tweenInfo = TweenInfo.new(dist / 250, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = enemyRoot.CFrame * CFrame.new(0, 25, 3)})
                                tween:Play()
                                tween.Completed:Wait()
                            else
                                rootPart.CFrame = enemyRoot.CFrame * CFrame.new(0, 15, 2)
                                
                                -- Executar ataques básicos e habilidades (Z, X, C, V)
                                local vim = game:GetService("VirtualInputManager")
                                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                task.wait(0.05)
                                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                
                                vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                                vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                                vim:SendKeyEvent(true, Enum.KeyCode.C, false, game)
                                vim:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                            end
                        end
                    else
                        -- Se o mob não estiver visível, reposiciona no ponto padrão
                        local rootPart = LocalPlayer.Character.HumanoidRootPart
                        rootPart.CFrame = target.CFrame
                        task.wait(1)
                    end
                end
            end)
        end
    end
end)
