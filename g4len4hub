local function GetUpperSkylandsTaskForLevel()
    local level = GetLevel()
    local tasks = GetAllSkylandsTasks()

    if level >= 575 and IsBossAvailable("Thunder God") then
        return tasks.ThunderGod
    elseif level >= 550 then
        return tasks.RoyalSoldier
    elseif level >= 525 then
        return tasks.RoyalSquad
    elseif level >= 500 and IsBossAvailable("Wysper") then
        return tasks.Wysper
    elseif level >= 475 then
        return tasks.Shanda
    else
        return tasks.GodsGuard
    end
end

local function SetPhysicsState(character, enabled)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")

    if hum and enabled then
        hum.Sit = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("FarmBodyVelocity")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "FarmBodyVelocity"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
            if not enabled then
                part.CanTouch = true
            end
        end
    end
end

NoClipConnection = RunService.Stepped:Connect(function()
    if not _G.AutoFarmUpperSkylands then
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end
        return
    end

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if character then
        -- Bloqueia CanTouch perto dos portais de nuvem para impedir que o portal puxe o boneco de volta
        local nearPortal = false
        if hrp and not NeedExitTouch then
            local distLower = (hrp.Position - Config.LowerEntrancePos).Magnitude
            local distUpper = (hrp.Position - Config.UpperEntrancePos).Magnitude
            nearPortal = (distLower <= 80) or (distUpper <= 45)
        end

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if part.CanCollide then
                    part.CanCollide = false
                end
                part.CanTouch = not nearPortal
            end
        end
    end
end)

