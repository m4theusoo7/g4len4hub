local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

_G.AutoFarmKingdomOfRose = true

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    MaxLevel = 850,
    TweenSpeed = 230,
    DistanceFarm = 8,
    BringMobRadius = 250,
    AttackDelay = 0.12
}

local CurrentTween = nil
local LastTweenTargetPos = nil

local function GetLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    return level and level.Value or 700
end

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTargetPos = nil
end

local function GetTask()
    local level = GetLevel()
    if level >= 800 then
        return {
            QuestName = "Area2Quest",
            QuestLevel = 2,
            QuestPos = Vector3.new(632.69, 73.10, 918.66),
            TargetMob = "Factory Staff",
            WaitPos = Vector3.new(295.00, 73.00, -56.00)
        }
    elseif level >= 775 then
        return {
            QuestName = "Area2Quest",
            QuestLevel = 1,
            QuestPos = Vector3.new(632.69, 73.10, 918.66),
            TargetMob = "Swan Pirate",
            WaitPos = Vector3.new(970.00, 111.00, 1217.00)
        }
    elseif level >= 725 then
        return {
            QuestName = "Area1Quest",
            QuestLevel = 2,
            QuestPos = Vector3.new(-424.08, 73.00, 1836.91),
            TargetMob = "Mercenary",
            WaitPos = Vector3.new(-972.00, 73.00, 1419.00)
        }
    else
        return {
            QuestName = "Area1Quest",
            QuestLevel = 1,
            QuestPos = Vector3.new(-424.08, 73.00, 1836.91),
            TargetMob = "Raider",
            WaitPos = Vector3.new(-746.00, 39.00, 2390.00)
        }
    end
end

local function HasQuestGui()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local main = pg and pg:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    return quest and quest.Visible or false
end

local function MoveTo(pos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local dist = (hrp.Position - pos).Magnitude
    if dist <= 4 then
        CancelTween()
        return
    end

    if LastTweenTargetPos and (LastTweenTargetPos - pos).Magnitude <= 4 and CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing then
        return
    end

    CancelTween()
    LastTweenTargetPos = pos
    local time = math.max(dist / Config.TweenSpeed, 0.05)
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), { CFrame = CFrame.new(pos) })
    CurrentTween:Play()
end

local function EquipMelee()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not backpack or not hum then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end
    return char:FindFirstChildOfClass("Tool")
end

local function GetMob(name)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == name then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and mHrp and hum.Health > 0 then
                return mob, mHrp
            end
        end
    end
    return nil
end

local function BringMobs(anchorHrp, mobName)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies or not anchorHrp then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == mobName then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and mHrp and hum.Health > 0 then
                if (mHrp.Position - anchorHrp.Position).Magnitude <= Config.BringMobRadius then
                    mHrp.CFrame = anchorHrp.CFrame
                    mHrp.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
    end
end

RunService.Stepped:Connect(function()
    if not _G.AutoFarmKingdomOfRose then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while _G.AutoFarmKingdomOfRose and GetLevel() < Config.MaxLevel do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health > 0 then
            local taskData = GetTask()

            if not HasQuestGui() then
                if (hrp.Position - taskData.QuestPos).Magnitude > 8 then
                    MoveTo(taskData.QuestPos)
                else
                    CancelTween()
                    if CommF then
                        pcall(function()
                            CommF:InvokeServer("StartQuest", taskData.QuestName, taskData.QuestLevel)
                        end)
                    end
                    task.wait(0.4)
                end
            else
                local mob, mHrp = GetMob(taskData.TargetMob)
                if mob and mHrp then
                    MoveTo(mHrp.Position + Vector3.new(0, Config.DistanceFarm, 0))
                    if (hrp.Position - mHrp.Position).Magnitude <= 60 then
                        BringMobs(mHrp, taskData.TargetMob)
                        local tool = EquipMelee()
                        if tool then
                            pcall(function() tool:Activate() end)
                        end
                    end
                else
                    MoveTo(taskData.WaitPos)
                end
            end
        end

        task.wait(Config.AttackDelay)
    end
end)
