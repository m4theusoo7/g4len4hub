-- OmegaCore | Módulo: Comprar Dark Step ($150,000 Beli)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local DarkStepCost = 150000

-- Coordenada do NPC Dark Step Teacher na Pirate Village (sala secreta atrás da parede)
local TeacherCFrame = CFrame.new(-982.5, 14.5, 3982.8)
local TweenSpeed = 185

-- Deslocamento seguro até o NPC (caso prefira ir fisicamente ou para validar proximidade)
local function moveToTeacher()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")
    if not hrp or not humanoid then return end

    local isMoving = true
    humanoid.PlatformStand = true

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "OmegaCoreStabilizer"
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = hrp

    local noclipConn
    noclipConn = RunService.Stepped:Connect(function()
        if not isMoving or not char or not char.Parent then
            if noclipConn then noclipConn:Disconnect() end
            return
        end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    hrp.CFrame = hrp.CFrame + Vector3.new(0, 15, 0)
    local distance = (hrp.Position - TeacherCFrame.Position).Magnitude
    local tween = TweenService:Create(hrp, TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear), {CFrame = TeacherCFrame})
    tween:Play()
    tween.Completed:Wait()

    isMoving = false
    if noclipConn then noclipConn:Disconnect() end
    if bodyVel then bodyVel:Destroy() end
    humanoid.PlatformStand = false
    hrp.CFrame = TeacherCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
end

local function buyDarkStep()
    local data = LocalPlayer:FindFirstChild("Data")
    local beli = data and data:FindFirstChild("Beli")

    if not beli or beli.Value < DarkStepCost then
        local currentBeli = beli and beli.Value or 0
        warn(string.format("[OmegaCore] Beli insuficiente para Dark Step! Atual: $%d | Necessário: $%d", currentBeli, DarkStepCost))
        return false
    end

    -- Verifica se já possui o Dark Step equipado ou na mochila
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if (char and char:FindFirstChild("Dark Step")) or (backpack and backpack:FindFirstChild("Dark Step")) then
        print("[OmegaCore] Dark Step já está adquirido!")
        return true
    end

    -- Invoca o RemoteFunction oficial do Blox Fruits para comprar o estilo de luta
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")

    if commF then
        local success, result = pcall(function()
            return commF:InvokeServer("BuyBlackLeg")
        end)

        task.wait(0.3)

        -- Confirma se o item entrou no inventário; se não, desloca até o NPC e tenta novamente
        if (char and char:FindFirstChild("Dark Step")) or (backpack and backpack:FindFirstChild("Dark Step")) then
            print("[OmegaCore] Dark Step comprado e equipado com sucesso!")
            return true
        else
            print("[OmegaCore] Deslocando até o Dark Step Teacher para concluir a compra...")
            moveToTeacher()
            pcall(function()
                commF:InvokeServer("BuyBlackLeg")
            end)
        end
    end
end

buyDarkStep()
