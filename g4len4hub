-- ==========================================
-- AUTO-FARM JUNGLE (LVL 10-30) V2 (ANTI-FREEZE)
-- ==========================================

local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local VirtualUser = game:GetService("VirtualUser")

_G.AutoFarm = true
_G.AutoSkills = true
_G.WeaponName = "Combat" -- Mude para o nome exato da sua arma/estilo de luta

local Coords = {
    PirateVillage = CFrame.new(-1141.07, 4.10, 3831.55),
    JungleNPC = CFrame.new(-1598.09, 35.55, 153.38),
    MonkeyArea = CFrame.new(-1448.52, 67.85, 11.47),
    GorillaArea = CFrame.new(-1142.65, 40.46, -515.39)
}

local targetCFrame = nil

-- 1. SISTEMA DE VOO E NOCLIP (EVITA TRAVAR NO AR)
RunService.Stepped:Connect(function(_, dt)
    if _G.AutoFarm and targetCFrame and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local dist = (hrp.Position - targetCFrame.Position).Magnitude
        local speed = 300
        
        -- Ativa NoClip para não bater nas árvores da Jungle
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end

        -- Se estiver longe, voa na direção. Se estiver perto, teleporta exato.
        if dist > 15 then
            hrp.CFrame = CFrame.new(hrp.Position, targetCFrame.Position) * CFrame.new(0, 0, -speed * dt)
        else
            hrp.CFrame = targetCFrame
        end
    end
end)

-- 2. SISTEMA DE ATAQUE CORRIGIDO
local function Attack()
    local char = player.Character
    if char then
        -- Checa se a arma tá na mochila e equipa
        local toolInBackpack = player.Backpack:FindFirstChild(_G.WeaponName)
        if toolInBackpack then
            char.Humanoid:EquipTool(toolInBackpack)
        end
        
        -- Executa o ataque diretamente pela ferramenta
        local equippedTool = char:FindFirstChild(_G.WeaponName)
        if equippedTool then
            equippedTool:Activate()
        end
        
        -- Backup de clique
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new())
    end
end

-- 3. SISTEMA DE SKILLS
local function useSkills()
    if not _G.AutoSkills then return end
    local keys = {"Z", "X", "C", "V"}
    for _, key in ipairs(keys) do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
    end
end

-- 4. VERIFICADOR DE QUEST
local function hasQuest()
    local mainGui = player.PlayerGui:FindFirstChild("Main")
    if mainGui and mainGui:FindFirstChild("Quest") then
        return mainGui.Quest.Visible
    end
    return false
end

-- ==========================================
-- LOOP PRINCIPAL
-- ==========================================
task.spawn(function()
    while task.wait(0.1) do
        if not _G.AutoFarm then break end
        
        pcall(function()
            local level = player.Data.Level.Value
            
            -- SE LEVEL 30+: VAI PRA PIRATE VILLAGE E PARA O SCRIPT
            if level >= 30 then
                targetCFrame = Coords.PirateVillage
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                
                -- Checa se já chegou no destino final
                if hrp and (hrp.Position - Coords.PirateVillage.Position).Magnitude < 20 then
                    _G.AutoFarm = false
                    print("Level 30 atingido. Bem-vindo a Pirate Village! Script pausado.")
                end
                return
            end
            
            -- CONFIGURA OS ALVOS (LVL 10 AO 29)
            local targetMob, questLevel, farmArea
            if level >= 10 and level < 15 then
                targetMob = "Monkey"
                questLevel = 1
                farmArea = Coords.MonkeyArea
            elseif level >= 15 and level < 30 then
                targetMob = "Gorilla"
                questLevel = 2
                farmArea = Coords.GorillaArea
            end
            
            -- LÓGICA DE CAÇA
            if targetMob then
                if not hasQuest() then
                    -- 1. Vai pro NPC pegar a missão
                    targetCFrame = Coords.JungleNPC
                    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    
                    -- Só envia o RemoteEvent se o boneco estiver perto do NPC
                    if hrp and (hrp.Position - Coords.JungleNPC.Position).Magnitude < 15 then
                        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", "JungleQuest", questLevel)
                        task.wait(0.5) -- Pausa rápida para a UI da quest atualizar
                    end
                else
                    -- 2. Tem missão, vai farmar
                    local foundMob = false
                    local enemies = game.Workspace.Enemies:GetChildren()
                    
                    for _, mob in pairs(enemies) do
                        if mob.Name == targetMob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            foundMob = true
                            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
                            if mobRoot then
                                -- Vai para 5 studs acima da cabeça do macaco
                                targetCFrame = mobRoot.CFrame * CFrame.new(0, 5, 0)
                                Attack()
                                useSkills()
                            end
                            break -- Só foca em 1 por vez
                        end
                    end
                    
                    -- 3. Se os macacos morreram, fica voando lá no alto esperando nascer
                    if not foundMob then
                        targetCFrame = farmArea * CFrame.new(0, 30, 0)
                    end
                end
            end
            
        end)
    end
end)
