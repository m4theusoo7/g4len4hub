-- ==========================================
-- AUTO-FARM JUNGLE (LVL 10-30) -> PIRATE VILLAGE
-- OTIMIZADO PARA DELTA EXECUTOR
-- ==========================================

local player = game.Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

_G.AutoFarm = true
_G.AutoSkills = true
local weaponName = "Combat" -- Mude para o nome do seu estilo de luta ou espada (ex: "Katana")

-- Coordenadas fornecidas
local Coords = {
    PirateVillage = CFrame.new(-1141.07, 4.10, 3831.55),
    JungleNPC = CFrame.new(-1598.09, 35.55, 153.38),
    MonkeyArea = CFrame.new(-1448.52, 67.85, 11.47),
    GorillaArea = CFrame.new(-1142.65, 40.46, -515.39)
}

-- Anti-AFK para não tomar disconnect
player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Função para mover o personagem suavemente (Tween) e evitar Kicks
local function tweenMove(targetCFrame)
    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local speed = 300 -- Velocidade de voo/teleporte
    local time = distance / speed
    
    local tween = TweenService:Create(root, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Função de Ataque Automático (Mouse)
local function autoAttack()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new())
end

-- Função para usar Skills automaticamente (Z, X, C, V)
local function useSkills()
    if not _G.AutoSkills then return end
    local keys = {"Z", "X", "C", "V"}
    for _, key in ipairs(keys) do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.1)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
    end
end

-- Função para equipar arma
local function equipWeapon()
    local char = player.Character
    if char then
        local tool = player.Backpack:FindFirstChild(weaponName)
        if tool then
            char.Humanoid:EquipTool(tool)
        end
    end
end

-- Função para verificar se já tem Quest ativa
local function hasQuest()
    local questGui = player.PlayerGui:FindFirstChild("Main")
    if questGui and questGui:FindFirstChild("Quest") then
        return questGui.Quest.Visible
    end
    return false
end

-- Pegar a Quest via Remote Event do Blox Fruits
local function getQuest(questName, questLevel)
    local args = {
        [1] = "StartQuest",
        [2] = questName,
        [3] = questLevel
    }
    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(unpack(args))
end

-- ==========================================
-- LOOP PRINCIPAL DE FARM
-- ==========================================
task.spawn(function()
    while _G.AutoFarm do
        task.wait()
        pcall(function()
            local level = player.Data.Level.Value
            
            -- LEVEL 30+: IR PARA PIRATE VILLAGE E PARAR
            if level >= 30 then
                print("Level 30 atingido! Indo para Pirate Village...")
                tweenMove(Coords.PirateVillage)
                _G.AutoFarm = false -- Desliga o script para você assumir
                return
            end
            
            -- DEFINIR ALVOS BASEADO NO LEVEL (10 AO 29)
            local targetMob, questLevel, farmArea
            if level >= 10 and level < 15 then
                targetMob = "Monkey"
                questLevel = 1
                farmArea = Coords.MonkeyArea
            elseif level >= 15 and level < 30 then
                targetMob = "Gorilla"
                questLevel = 2
                farmArea = Coords.GorillaArea
            end
            
            -- LOGICA DE PEGAR QUEST E MATAR O MOB
            if targetMob then
                if not hasQuest() then
                    -- Se não tem quest, vai pro NPC
                    tweenMove(Coords.JungleNPC)
                    task.wait(0.5)
                    getQuest("JungleQuest", questLevel)
                    task.wait(1)
                else
                    -- Se tem quest, vai pra área de farm e ataca
                    local enemies = game.Workspace.Enemies:GetChildren()
                    local foundMob = false
                    
                    for _, mob in ipairs(enemies) do
                        if mob.Name == targetMob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            foundMob = true
                            local mobRoot = mob:FindFirstChild("HumanoidRootPart")
                            if mobRoot then
                                -- Posiciona o player em cima do mob para não tomar tanto dano
                                local attackPos = mobRoot.CFrame * CFrame.new(0, 5, 0)
                                tweenMove(attackPos)
                                
                                equipWeapon()
                                autoAttack()
                                useSkills()
                            end
                            break -- Foca em um mob por vez
                        end
                    end
                    
                    -- Se o mob não estiver spawnado no momento, fica esperando na área dele
                    if not foundMob then
                        tweenMove(farmArea * CFrame.new(0, 20, 0)) -- Espera no ar para segurança
                    end
                end
            end
            
        end)
    end
end)
