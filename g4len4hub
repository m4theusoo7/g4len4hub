-- NoTrack Blox Fruits Smart Teleport Module
-- Usa busca por nome do objeto no Workspace para evitar bugs de coordenada

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local RunService = game:GetService("RunService")

local Teleports = {
    ["Sky Island"] = "Sky Island", -- Busca pelo nome exato no mapa
    ["Magma Village"] = "Magma Village",
    ["Frozen Village"] = "Frozen Village",
    ["Jungle"] = "Jungle",
    ["Garden of Swallowtails"] = "Garden of Swallowtails",
    ["Fountain"] = "Fountain" -- Para recuperar vida/energia
}

function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

function teleportTo(name)
    local char = getCharacter()
    if not char then return end
    
    print("[NoTrack] Procurando destino: " .. name)
    
    -- Busca o objeto principal da ilha pelo nome
    local targetObj = workspace:FindFirstChild(name)
    
    if targetObj and targetObj:IsA("Model") then
        local rootPart = targetObj:FindFirstChild("SpawnLocation") or targetObj:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            char.HumanoidRootPart.CFrame = rootPart.CFrame + Vector3.new(0, 5, 0)
            print("[NoTrack] Teleport realizado com sucesso!")
            
            -- Ativa o Auto-Pickup se estiver disponível na UI
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            if playerGui then
                local ui = playerGui:FindFirstChild("MainUI")
                if ui then
                    local pickupButton = ui:FindFirstChild("PickUpAll") or ui:FindFirstChild("CollectAll")
                    if pickupButton and pickupButton.Enabled then
                        -- Simula o clique no botão de pegar tudo
                        local event = game:GetService("ReplicatedStorage").DefaultModule.RemoteEvents.PickupAll
                        if event then
                            event:FireServer()
                        end
                    end
                end
            end
        else
            print("[NoTrack] Erro: Raiz do destino não encontrada.")
        end
    else
        print("[NoTrack] Destino '" .. name .. "' não encontrado no workspace.")
    end
end

