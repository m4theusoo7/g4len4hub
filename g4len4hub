            QuestLevel = 2,
            RequiredKills = 8,
            IsBoss = false,
            WaitPos = Vector3.new(-5800, 95, 8790)
        },
        MilitarySoldier = {
            TargetMob = "Military Soldier",
            QuestLevel = 1,
            RequiredKills = 8,
            IsBoss = false,
            WaitPos = Vector3.new(-5450, 28, 8480)
        }
