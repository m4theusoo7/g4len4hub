_G.AutoFarm = true

local player = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local ts = game:GetService("TweenService")
local vim = game:GetService("VirtualInputManager")
local rep = game:GetService("ReplicatedStorage")

-- 1. Anti-Colisão (Noclip) e Anti-Gravidade
rs.Stepped:Connect(function()
    if _G.AutoFarm and player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
        -- Trava a queda para o boneco não tremer enquanto bate
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

local function equiparArma()
    for _, v in pairs(player.Backpack:GetChildren()) do
        if v.ToolTip == "Melee" or v.ToolTip == "Sword" or v.ToolTip == "Blox Fruit" then
            v.Parent = player.Character
            break
        end
    end
end

local function voarAte(destinoCFrame)
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (hrp.Position - destinoCFrame.Position).Magnitude
    local speed = 320
    local tween = ts:Create(hrp, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {CFrame = destinoCFrame})
    
    tween:Play()
    return tween
end

local function usarSkills()
    local teclas = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, tecla in pairs(teclas) do
        vim:SendKeyEvent(true, tecla, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, tecla, false, game)
    end
end

local function atacar()
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- 2. Loop Principal
task.spawn(function()
    while _G.AutoFarm do
        task.wait()
        pcall(function()
            local level = player.Data.Level.Value
            local temMissao = player.PlayerGui.Main.Quest.Visible

            if level < 10 then
                -- Farm na Starter Island
                if not temMissao then
                    local npc = workspace.NPCs:FindFirstChild("Bandit Quest Giver")
                    if npc then
                        local t = voarAte(npc.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3))
                        if t then t.Completed:Wait() end
                        -- Puxa a quest
                        rep.Remotes.CommF_:InvokeServer("StartQuest", "Bandit Quest Giver", 1)
                    end
                else
                    local inimigo = workspace.Enemies:FindFirstChild("Bandit")
                    if inimigo and inimigo:FindFirstChild("Humanoid") and inimigo.Humanoid.Health > 0 then
                        equiparArma()
                        
                        -- Posição segura: Fica 7 studs acima da cabeça do mob, virado para baixo
                        local posicaoSegura = inimigo.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        
                        voarAte(posicaoSegura)
                        atacar()
                        usarSkills()
                    end
                end
            else
                -- Vai pra Jungle (Coordenada fixa do Adventurer NPC)
                local jungleNPC = CFrame.new(-1605, 37, 152) 
                local t = voarAte(jungleNPC)
                
                if t then t.Completed:Wait() end
                
                _G.AutoFarm = false -- Para o loop pra você não bugar depois que chegar lá
                print("Level 10! Script chegou na Jungle.")
            end
        end)
    end
end)
