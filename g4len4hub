local function appendScan()
    local res = RunScan()
    if OutputBox.Text == "" then
        OutputBox.Text = res
    else
        OutputBox.Text = OutputBox.Text .. "\n\n" .. res
    end
    local lineCount = select(2, OutputBox.Text:gsub("\n", "\n")) + 20
    local h = math.max(1200, lineCount * 15)
    Scroll.CanvasSize = UDim2.new(0, 0, 0, h)
    OutputBox.Size = UDim2.new(1, -8, 0, h)
end

