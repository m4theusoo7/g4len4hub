-- Blox Fruits Ultimate Auto-Grinder by NoTrack AI
-- Otimizado para velocidade, estabilidade e eficiência de XP

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = workspace.CurrentCamera

-- Configurações
local Config = {
    WalkSpeed = 35,       -- Velocidade máxima permitida sem kick
    JumpPower = 75,       -- Pulo alto para agilidade
    FarmRange = 100,      -- Distância máxima para procurar inimigos
    PickupRange = 20,     -- Distância para coletar itens/frutas
    AutoAttack = true,    -- Tenta usar habilidades se tiver espada/arma equipada
    Debug = false         -- Se true, imprime logs no console (F9)
}

-- Variáveis de Controle
local isRunning = true
local currentTarget = nil
local lastAttackTime = 0

-- Função Utilitária: Buscar objeto seguro
function safeFind(name, parent)
    local obj = parent:FindFirstChild(name)
    if not obj and parent ~= workspace then
        obj = workspace:FindFirstChild(name)
    end
    return obj
end

-- Função: Calcular distância segura
function getDistance(part1, part2)
    if not part1 or not part2 then return math.huge end
    return (part1.Position - part2.Position).Magnitude
end

-- Função Principal: Loop de Farm
game:GetService("RunService").Heartbeat:Connect(function(dt)
    if not isRunning or not Character or not Character.Parent then return end
    
    -- 1. Buffs constantes
    Humanoid.WalkSpeed = Config.WalkSpeed
    Humanoid.JumpPower = Config.JumpPower

    -- 2. Lógica de Busca de Inimigo
    local missionFrame = Player.PlayerGui:FindFirstChild("HUD"):FindFirstChild("MissionFrame")
    local targetName = ""
    if missionFrame and missionFrame.Visible then
        -- Extrai o nome do alvo da missão (ex: "Bandit", "Thief")
        local text = missionFrame.Title.Text
        targetName = text:gsub("%*", ""):gsub("%d+", ""):gsub("%s", "")
    end

    local closestEnemy = nil
    local minDist = math.huge

    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= Character.Name then
            -- Filtra apenas NPCs que podem ser atacados
            if obj:FindFirstChild("HumanoidRootPart") and obj.Humanoid.Health > 0 then
                local dist = getDistance(RootPart, obj.HumanoidRootPart)
                
                -- Prioriza o alvo da missão se estiver no range
                if targetName == "" or string.find(obj.Name:lower(), targetName:lower()) then
                    if dist < Config.FarmRange and dist < minDist then
                        minDist = dist
                        closestEnemy = obj
                    end
                elseif not targetName and dist < minDist then
                    -- Se não tem missão, pega o mais próximo geral
                    minDist = dist
                    closestEnemy = obj
                end
            end
        end
    end

    -- 3. Movimento e Combate
    if closestEnemy and minDist > 5 then
        -- Move em direção ao inimigo
        local direction = (closestEnemy.HumanoidRootPart.Position - RootPart.Position).Unit
        RootPart.Velocity = Vector3.new(direction.X * Config.WalkSpeed, RootPart.Velocity.Y, direction.Z * Config.WalkSpeed)
        
        -- Se estiver muito perto, para para não "glitchar" através do modelo
        if minDist < 6 then
            RootPart.Velocity = Vector3.new(0, RootPart.Velocity.Y, 0)
        end
        
    elseif closestEnemy and minDist <= 5 then
        -- Está na range de ataque
        RootPart.Velocity = Vector3.new(0, RootPart.Velocity.Y, 0)
        
        -- Simula ataque automático se tiver arma
        if Config.AutoAttack and Character:FindFirstChildOfClass("Tool") then
            local tool = Character:FindFirstChildOfClass("Tool")
            if tick() - lastAttackTime > 0.8 then -- Cooldown mínimo de 0.8s
                tool:Activate()
                lastAttackTime = tick()
            end
        end
    else
        -- Se não tem inimigo, anda aleatoriamente para encontrar spawns
        RootPart.CFrame = RootPart.CFrame + Vector3.new(math.random(-10, 10), 0, math.random(-10, 10))
    end

    -- 4. Coleta Automática de Itens/Frutas
    for _, item in pairs(workspace:GetChildren()) do
        if item:IsA("BasePart") and (item.Name == "Fruit" or item.Name == "Money" or item.Name == "Blox Fruit") then
            local dist = getDistance(RootPart, item)
            if dist < Config.PickupRange then
                -- Mover para o item
                RootPart.CFrame = CFrame.new(item.Position + Vector3.new(0, 1, 0))
                task.wait(0.5)
            end
        end
    end
end)

print("[NoTrack] Script Iniciado. Farmando...")
