_G.OmegaSea2_Travel = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    -- Coordenada aproximada do Experienced Captain em Middle Town (Sea 1)
    MiddleTownCaptainPos = Vector3.new(-778.00, 8.00, 1192.00),
    MoveSpeed = 260
}

local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaSea2TravelUI") then
    parentGui.OmegaSea2TravelUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaSea2TravelUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 52)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Sea 2 Travel] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Sea 2 Travel] " .. msg
    if color then StatusBox.TextColor3 = color end
end

local function setPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaTravelBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaTravelBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

local function stepMove(hrp, targetPos, dt)
    local delta = targetPos - hrp.Position
    local dist = delta.Magnitude
    if dist <= 3.5 then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    local step = math.min(dist, Config.MoveSpeed * dt)
    local nextPos = hrp.Position + delta.Unit * step
    hrp.CFrame = CFrame.new(nextPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    return false
end

local function findCaptainPos()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end

    for _, npc in ipairs(npcs:GetChildren()) do
        local low = string.lower(npc.Name)
        if string.find(low, "experienced captain", 1, true) or string.find(low, "capitao", 1, true) then
            local hrp = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
            if hrp then
                return hrp.Position + Vector3.new(0, 2, 3.5)
            end
        end
    end

    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_Travel then return end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while _G.OmegaSea2_Travel do
        local dt = RunService.Heartbeat:Wait()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health > 0 then
            setPhysics(char, true)

            local targetPos = findCaptainPos() or Config.MiddleTownCaptainPos
            local arrived = stepMove(hrp, targetPos, dt)

            if not arrived then
                setStatus("Indo ate o Capitao em Middle Town...", Color3.fromRGB(255, 215, 90))
            else
                setStatus("Acionando viagem para o Second Sea...", Color3.fromRGB(120, 200, 255))
                if CommF then
                    pcall(function()
                        CommF:InvokeServer("TravelDressrosa")
                    end)
                end
                task.wait(1.2)
            end
        end
    end

    _G.OmegaSea2_Travel = false
    if noclipConn then noclipConn:Disconnect() end
    setPhysics(LocalPlayer.Character, false)
end)
