-- OmegaCore Update 30: Sea 1 CFrame Dumper
local workspace = game:GetService("Workspace")

local function round(num)
    return math.floor(num * 10) / 10
end

local dump = "local Update30_Coords = {\n"
dump = dump .. "    -- [[ NPCs (Pegar Quest) ]]\n"

-- Mapeia todos os NPCs (Givers) da ilha
if workspace:FindFirstChild("NPCs") then
    for _, npc in pairs(workspace.NPCs:GetChildren()) do
        if npc:FindFirstChild("HumanoidRootPart") then
            local pos = npc.HumanoidRootPart.CFrame
            dump = dump .. string.format('    ["%s"] = CFrame.new(%.1f, %.1f, %.1f),\n', npc.Name, pos.X, pos.Y, pos.Z)
        end
    end
else
    warn("Pasta de NPCs não encontrada no Workspace.")
end

dump = dump .. "\n    -- [[ Inimigos (Mapeamento de Farm) ]]\n"
local mappedMobs = {}

-- Mapeia os mobs que estão vivos no mapa (evita repetição)
if workspace:FindFirstChild("Enemies") then
    for _, mob in pairs(workspace.Enemies:GetChildren()) do
        if mob:FindFirstChild("HumanoidRootPart") and not mappedMobs[mob.Name] then
            local pos = mob.HumanoidRootPart.CFrame
            dump = dump .. string.format('    ["%s"] = CFrame.new(%.1f, %.1f, %.1f),\n', mob.Name, pos.X, pos.Y, pos.Z)
            mappedMobs[mob.Name] = true
        end
    end
else
    warn("Nenhum inimigo spawnado no momento. Chegue perto da área de farm.")
end

dump = dump .. "}"

-- Imprime a tabela pronta no console do Delta Executor
print("\n--- COPIE O CÓDIGO ABAIXO ---")
print(dump)
print("--- FIM DO MAPEAMENTO ---\n")
