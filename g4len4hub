-- ==========================================================
-- OMEGACORE: Desert Island Auto-Farm (1-90)
-- Delta Executor | Sem Missões | Coordenadas Corrigidas
-- ==========================================================

getgenv().AutoFarmDesert = true
getgenv().FastAttack = true

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Player = Players.LocalPlayer

-- Anti-AFK
local afkConnection
afkConnection = Player.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
end)

local function EquipWeapon()
    if not Player.Character then return end
    for _, tool in ipairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            Player.Character.Humanoid:EquipTool(tool)
            break
        end
    end
end

task.spawn(function()
    while task.wait(0.15) do
        if not getgenv().AutoFarmDesert then break end
        
        pcall(function()
            local char = Player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then return end
            if char.Humanoid.Health <= 0 then return end
            
            local currentLevel = 1
            if Player:FindFirstChild("Data") and Player.Data:FindFirstChild("Level") then
                currentLevel = Player.Data.Level.Value
            elseif Player:FindFirstChild("leaderstats") and Player.leaderstats:FindFirstChild("Level") then
                currentLevel = Player.leaderstats.Level.Value
            end
            
            local targetName = ""
            local spawnPos = CFrame.new()
            
            if currentLevel < 70 then
                targetName = "Desert Bandit"
                spawnPos = CFrame.new(944.4, 20.9, 4350.2)
            elseif currentLevel >= 70 and currentLevel < 90 then
                targetName = "Desert Officer"
                -- Coordenadas exatas atualizadas pós-update para o Desert Officer
                spawnPos = CFrame.new(1048.2, 27.2, 4425.6)
            else
                getgenv().AutoFarmDesert = false
                return
            end
            
            EquipWeapon()
            
            local targetMob = nil
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if enemiesFolder then
                for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                    if enemy:FindFirstChild("Humanoid") and enemy:FindFirstChild("HumanoidRootPart") then
                        if enemy.Humanoid.Health > 0 and string.find(enemy.Name, targetName) then
                            targetMob = enemy
                            break
                        end
                    end
                end
            end
            
            local hrp = char.HumanoidRootPart
            
            if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                local mobHrp = targetMob.HumanoidRootPart
                hrp.CFrame = mobHrp.CFrame * CFrame.new(0, 12, 3)
                char.Humanoid.PlatformStand = true
                
                VirtualUser:CaptureController()
                VirtualUser:Button1Down(Vector2.new(0, 0), Workspace.CurrentCamera.CFrame)
                
                for _, skillKey in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                    VirtualInputManager:SendKeyEvent(true, skillKey, false, game)
                    task.wait(0.03)
                    VirtualInputManager:SendKeyEvent(false, skillKey, false, game)
                end
            else
                char.Humanoid.PlatformStand = false
                hrp.CFrame = spawnPos
            end
        end)
    end
end)
