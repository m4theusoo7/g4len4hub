local function HasAnyActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local questGui = main and main:FindFirstChild("Quest")
    return questGui and questGui.Visible or false
end

local function CheckGuiQuestProgress(taskInfo)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    if not main or not taskInfo then return "Unknown" end

    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local isDialogue = false
            local parent = obj.Parent
            while parent and parent ~= main do
                local pName = string.lower(parent.Name)
                if string.find(pName, "dialogue") or string.find(pName, "questc") then
                    isDialogue = true
                    break
                end
                parent = parent.Parent
            end

            if not isDialogue then
                local txt = string.lower((obj.Text or "") .. " " .. (obj.ContentText or ""))
                local matchesMob = false

                if taskInfo.TargetMob == "God's Guard" then
                    local hasGod = string.find(txt, "god") or string.find(txt, "deus")
                    local hasGuard = string.find(txt, "guard") or string.find(txt, "guarda")
                    matchesMob = hasGod and hasGuard
                elseif taskInfo.TargetMob == "Shanda" then
                    matchesMob = string.find(txt, "shanda") ~= nil
                elseif taskInfo.TargetMob == "Wysper" then
                    matchesMob = string.find(txt, "wysper") ~= nil
                elseif taskInfo.TargetMob == "Royal Squad" then
                    local hasRoyal = string.find(txt, "royal") or string.find(txt, "real")
                    local hasSquad = string.find(txt, "squad") or string.find(txt, "esquadr")
                    matchesMob = hasRoyal and hasSquad
                elseif taskInfo.TargetMob == "Royal Soldier" then
                    local hasRoyal = string.find(txt, "royal") or string.find(txt, "real")
                    local hasSoldier = string.find(txt, "soldier") or string.find(txt, "soldado")
                    matchesMob = hasRoyal and hasSoldier
                elseif taskInfo.TargetMob == "Thunder God" then
                    local hasThunder = string.find(txt, "thunder") or string.find(txt, "trov")
                    local hasGod = string.find(txt, "god") or string.find(txt, "deus")
                    matchesMob = hasThunder and hasGod
                end

                if matchesMob then
                    local donePattern = taskInfo.RequiredKills .. "/" .. taskInfo.RequiredKills
                    if string.find(txt, donePattern) then
                        return "Completed"
                    elseif string.find(txt, "[0-" .. (taskInfo.RequiredKills - 1) .. "]/" .. taskInfo.RequiredKills) then
                        return "Active"
                    end
                end
            end
        end
    end

    return "Unknown"
end

-- Localiza o NPC da missão dinamicamente (Mole ou Sky Adventurer, com fallback para DefaultQuestPos)
local function GetQuestNpcPos(taskInfo)
    local npcs = workspace:FindFirstChild("NPCs")
    local npc = npcs and npcs:FindFirstChild(taskInfo.QuestNpcName)
    if npc and npc:FindFirstChild("HumanoidRootPart") then
        return npc.HumanoidRootPart.Position + Vector3.new(0, 3, 3.5)
    end

    local storedNpc = ReplicatedStorage:FindFirstChild(taskInfo.QuestNpcName)
    if storedNpc and storedNpc:FindFirstChild("HumanoidRootPart") then
        return storedNpc.HumanoidRootPart.Position + Vector3.new(0, 3, 3.5)
    end

    return taskInfo.DefaultQuestPos
end

-- Busca a posição real de spawn dos mobs em _WorldOrigin.EnemySpawns (com fallback para WaitPos)
local function GetMobWaitPos(taskInfo)
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        local sum = Vector3.zero
        local count = 0
        for _, spawnPart in ipairs(enemySpawns:GetChildren()) do
            if spawnPart:IsA("BasePart") and string.find(spawnPart.Name, taskInfo.TargetMob, 1, true) then
                if IsValidMobAltitude(taskInfo.TargetMob, spawnPart.Position) then
                    sum += spawnPart.Position
                    count += 1
                end
            end
        end
        if count > 0 then
            return (sum / count) + Vector3.new(0, 25, 0)
        end
    end

    return taskInfo.WaitPos
end

local function EquipWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not backpack or not hum then return nil end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return nil
end

local function UpdateKillCounter(targetMobName)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName and not CountedDeadMobs[mob] then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mobHum and mobHum.Health <= 0 then
                CountedDeadMobs[mob] = true
                if QuestInProgress then
                    MobsKilledInQuest += 1
                end
            end
        end
    end
end

local function GetClosestTargetMob(targetMobName)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    local closestMob = nil
    local shortestDist = 1500

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsValidMobAltitude(targetMobName, mobHrp.Position) then
                local dist = (hrp.Position - mobHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

local function BringMobs(anchorMob, targetMobName)
    local enemies = workspace:FindFirstChild("Enemies")
    local anchorHrp = anchorMob and anchorMob:FindFirstChild("HumanoidRootPart")
    if not enemies or not anchorHrp then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local anchorCFrame = anchorHrp.CFrame
    anchorHrp.AssemblyLinearVelocity = Vector3.zero

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsValidMobAltitude(targetMobName, mobHrp.Position) then
                local dist = (mobHrp.Position - anchorCFrame.Position).Magnitude
                local heightDiff = math.abs(mobHrp.Position.Y - anchorCFrame.Position.Y)
                if dist <= Config.BringMobRadius and heightDiff <= 80 then
                    for _, part in ipairs(mob:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if mob ~= anchorMob then
                        mobHrp.CFrame = anchorCFrame
                    end

                    mobHrp.AssemblyLinearVelocity = Vector3.zero
                    mobHrp.AssemblyAngularVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

local function GetTargetsInRange(targetMobName, maxRange)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    local targets = {}
    if not hrp or not enemies or not targetMobName then return targets end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                if (hrp.Position - mobHrp.Position).Magnitude <= maxRange then
                    table.insert(targets, { mob, mobHrp })
                end
            end
        end
    end

    return targets
end

local function ScanPortalParts(key, centerPos, radius)
    local cached = PortalScanCache[key]
    if cached and (os.clock() - cached.LastScan) < 0.8 and #cached.Parts > 0 then
        return cached.Pos, cached.Parts
    end

    local touchParts = {}
    local bestPos = nil
    local bestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
            local part = obj.Parent
            local dist = (part.Position - centerPos).Magnitude
            if dist <= radius then
                table.insert(touchParts, part)
                if dist < bestDist then
                    bestDist = dist
                    bestPos = part.Position
                end
            end
        end
    end

    local finalPos = bestPos or centerPos
    PortalScanCache[key] = {
        LastScan = os.clock(),
        Pos = finalPos,
        Parts = touchParts
    }
    return finalPos, touchParts
end

local function TweenToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3.5 then
        CancelTween()
        if snapAtEnd then
            hrp.CFrame = targetCFrame
        end
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

local function HandlePortalApproach(hrp, directionKey, basePortalPos, scanRadius, destinationPos, waitTimeout)
    if PortalWaitDirection ~= directionKey then
        PortalWaitDirection = directionKey
        PortalWaitStart = nil
        ForceDirectFlight = false
    end

    if ForceDirectFlight then
        return false
    end

    local portalPos, touchParts = ScanPortalParts(directionKey, basePortalPos, scanRadius)
    local distToPortal = (hrp.Position - portalPos).Magnitude

    if distToPortal > 22 then
        TweenToCFrame(CFrame.new(portalPos + Vector3.new(0, 3, 0)), false)
        return true
    end

    if not PortalWaitStart then
        PortalWaitStart = os.clock()
    end

    if (os.clock() - PortalWaitStart) > waitTimeout then
        ForceDirectFlight = true
        CancelTween()
        return false
    end

    CancelTween()
    local t = os.clock()
    local sweepOffset = Vector3.new(math.cos(t * 5) * 4, math.sin(t * 8) * 4, math.sin(t * 5) * 4)
    hrp.CFrame = CFrame.new(portalPos + sweepOffset)
    hrp.AssemblyLinearVelocity = Vector3.new(0, -10, 0)

    if (t - LastTouchFire) >= 0.3 then
        LastTouchFire = t
        if firetouchinterest then
            for _, part in ipairs(touchParts) do
                if part and part.Parent then
                    pcall(function()
                        firetouchinterest(hrp, part, 0)
                        task.wait(0.03)
                        firetouchinterest(hrp, part, 1)
                    end)
                end
            end
        end
    end

    if CommF and (t - LastEntranceRemote) >= 0.9 then
        LastEntranceRemote = t
        pcall(function()
            CommF:InvokeServer("requestEntrance", destinationPos)
        end)
    end

    return true
end

local function MoveToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Subir para Upper Yard (Y > 5500): tenta portal de nuvem por 3s e, se não entrar, voa direto de Tween
    if hrp.Position.Y < 4500 and targetCFrame.Position.Y > 4500 then
        if HandlePortalApproach(hrp, "Up", Config.LowerEntrancePos, 450, Config.UpperEntrancePos, 3.0) then
            return
        end
    -- Descer de Upper Yard (Y > 5500) para os God's Guard (Y ~ 860)
    elseif hrp.Position.Y > 4500 and targetCFrame.Position.Y < 2000 then
        if HandlePortalApproach(hrp, "Down", Config.UpperEntrancePos, 200, Config.LowerEntrancePos, 2.5) then
            return
        end
    else
        PortalWaitDirection = nil
        PortalWaitStart = nil
        ForceDirectFlight = false
    end

    TweenToCFrame(targetCFrame, snapAtEnd)
end

