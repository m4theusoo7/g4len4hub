-- Auto Buy Water Kung Fu (Sea 1 - Delta Executor)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas
local ENTRADA_REDEMOINHO = Vector3.new(3864.688, 6.737, -1926.214)
local SPAWN_SUBAQUATICO  = Vector3.new(61163.852, 11.680, 1819.784)
local POS_TEACHER        = Vector3.new(61577.125, 18.497, 989.399)

local TWEEN_SPEED = 280
local noclipConn = nil

-- Ativa/Desativa NoClip para não travar nas paredes da caverna
local function setNoClip(state)
    if state then
        if noclipConn then return end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

-- Movimento suave via Tween
local function tweenTo(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 5 then return end

    -- Mantém velocidade zero para não cair durante o trajeto
    local bv = hrp:FindFirstChild("AntiGravity") or Instance.new("BodyVelocity")
    bv.Name = "AntiGravity"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp

    local time = distance / TWEEN_SPEED
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPos) }
    )
    tween:Play()
    tween.Completed:Wait()

    if bv and bv.Parent then
        bv:Destroy()
    end
end

-- Verifica se já possui o estilo ou Beli suficiente
local function hasWaterKungFu()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    return (backpack and backpack:FindFirstChild("Water Kung Fu"))
        or (char and char:FindFirstChild("Water Kung Fu"))
end

-- Execução principal
task.spawn(function()
    if hasWaterKungFu() then
        warn("[OmegaCore] Você já possui o Water Kung Fu equipado/na mochila!")
        return
    end

    local beli = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Beli")
    if beli and beli.Value < 750000 then
        warn("[OmegaCore] Beli insuficiente! Necessário: $750.000 | Atual: $" .. tostring(beli.Value))
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    setNoClip(true)

    -- Passo 1: Se ainda estiver na superfície (X < 50000), vai até o redemoinho e entra
    if hrp.Position.X < 50000 then
        -- Sobe um pouco antes de viajar para não bater em ilhas no caminho
        tweenTo(Vector3.new(hrp.Position.X, 150, hrp.Position.Z))
        tweenTo(Vector3.new(ENTRADA_REDEMOINHO.X, 150, ENTRADA_REDEMOINHO.Z))
        tweenTo(ENTRADA_REDEMOINHO)

        -- Solicita entrada no portal da Underwater City
        pcall(function()
            CommF:InvokeServer("requestEntrance", ENTRADA_REDEMOINHO)
        end)

        -- Aguarda o teleporte para a instância subaquática (X > 50000)
        local timeout = 0
        while hrp.Position.X < 50000 and timeout < 5 do
            task.wait(0.2)
            timeout += 0.2
            pcall(function()
                CommF:InvokeServer("requestEntrance", ENTRADA_REDEMOINHO)
            end)
        end
    end

    -- Passo 2: Já dentro da Underwater City, vai até o Water Kung Fu Teacher
    if hrp.Position.X > 50000 then
        -- Eleva levemente para passar por cima das construções sem travar
        tweenTo(Vector3.new(hrp.Position.X, 55, hrp.Position.Z))
        tweenTo(Vector3.new(POS_TEACHER.X, 55, POS_TEACHER.Z))
        tweenTo(POS_TEACHER)

        task.wait(0.3)
        -- Dispara o remote oficial de compra
        local result = CommF:InvokeServer("BuyFishmanKarate")
        print("[OmegaCore] Resposta da compra:", tostring(result))
    else
        warn("[OmegaCore] Falha ao entrar na Underwater City. Tente executar novamente perto do mar.")
    end

    setNoClip(false)
end)
