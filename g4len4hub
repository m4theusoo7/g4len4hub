-- Noclip contínuo enquanto o farm estiver ativo
RunService.Stepped:Connect(function()
    if _G.AutoSaber and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Função de Tween suave com elevação aérea para evitar obstáculos
local function TweenTo(targetCFrame, speed)
    speed = speed or 300
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return
    end

    -- Sobe um pouco se estiver longe para evitar colisão com ilhas
    if distance > 250 and hrp.Position.Y < 120 then
        hrp.CFrame = CFrame.new(hrp.Position.X, 150, hrp.Position.Z)
    end

    local duration = distance / speed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Equipar ferramenta por nome ou tipo (Melee/Sword)
local function EquipTool(toolName)
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end

    if char:FindFirstChild(toolName) then return char[toolName] end
    local tool = backpack:FindFirstChild(toolName)
    if tool then
        char.Humanoid:EquipTool(tool)
        task.wait(0.2)
        return tool
    end
    return nil
end

local function EquipCombatWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer.Backpack
    if not char or not backpack then return end

    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and (t.ToolTip == "Melee" or t.ToolTip == "Sword") then
            return
        end
    end
    for _, t in ipairs(backpack:GetChildren()) do
        if t:IsA("Tool") and (t.ToolTip == "Melee" or t.ToolTip == "Sword") then
            char.Humanoid:EquipTool(t)
            break
        end
    end
end

-- Ativar Aura (Buso Haki)
local function EnableBuso()
    if LocalPlayer.Character and not LocalPlayer.Character:FindFirstChild("HasBuso") then
        pcall(function()
            CommF:InvokeServer("Buso")
        end)
    end
end

-- Ataque rápido
local function AttackTarget()
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
end

-- Função para derrotar um inimigo específico (Mob Leader ou Saber Expert)
local function KillBoss(bossName, spawnCFrame)
    while _G.AutoSaber do
        local enemy = nil
        for _, v in ipairs(workspace.Enemies:GetChildren()) do
            if string.find(v.Name, bossName) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                enemy = v
                break
            end
        end

        if enemy then
            EnableBuso()
            EquipCombatWeapon()
            -- Fica posicionado 18 studs acima do boss
            local farmPos = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 18, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            LocalPlayer.Character.HumanoidRootPart.CFrame = farmPos
            enemy.HumanoidRootPart.CanCollide = false
            AttackTarget()
        else
            -- Vai até o ponto de spawn aguardar
            TweenTo(spawnCFrame)
            -- Verifica se o boss já morreu e o objetivo concluiu
            task.wait(1)
            local stillThere = false
            for _, v in ipairs(workspace.Enemies:GetChildren()) do
                if string.find(v.Name, bossName) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    stillThere = true
                end
            end
            if not stillThere and (LocalPlayer.Character.HumanoidRootPart.Position - spawnCFrame.Position).Magnitude < 30 then
                break
            end
        end
        task.wait()
    end
end

-- ==========================================
-- FLUXO PRINCIPAL DO PUZZLE DA SABER
-- ==========================================
task.spawn(function()
    -- Verifica nível mínimo
    local level = LocalPlayer.Data.Level.Value
    if level < 200 then
        warn("[OmegaCore] Nível insuficiente para a Saber! Nível atual: " .. level .. " (Necessário: 200+)")
        _G.AutoSaber = false
        return
    end

    print("[OmegaCore] Iniciando Auto Saber Puzzle...")

    -- Verifica progresso atual no servidor
    local progress = CommF:InvokeServer("ProQuestProgress")

    -- ETAPA 1: Os 5 Botões Verdes na Jungle
    if progress and not progress.UsedTorch then
        local platesFolder = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Jungle") and workspace.Map.Jungle:FindFirstChild("QuestPlates")
        if platesFolder then
            for i = 1, 5 do
                if not _G.AutoSaber then return end
                local plate = platesFolder:FindFirstChild("Plate" .. i)
                if plate and plate:FindFirstChild("Button") then
                    -- Verde claro significa que ainda não foi pisado
                    if plate.Button.BrickColor ~= BrickColor.new("Camo") then
                        TweenTo(plate.Button.CFrame * CFrame.new(0, 2, 0))
                        task.wait(0.4)
                        if firetouchinterest then
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, plate.Button, 0)
                            task.wait(0.1)
                            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, plate.Button, 1)
                        end
                    end
                end
            end
        end

        -- ETAPA 2: Pegar a Tocha no subsolo da Jungle
        if not LocalPlayer.Backpack:FindFirstChild("Torch") and not LocalPlayer.Character:FindFirstChild("Torch") then
            TweenTo(CFrame.new(-1612.5, 11.5, 163.5))
            task.wait(0.5)
            local torchObj = workspace.Map.Jungle:FindFirstChild("Torch")
            if torchObj and firetouchinterest then
                firetouchinterest(LocalPlayer.Character.HumanoidRootPart, torchObj, 0)
                task.wait(0.1)
                firetouchinterest(LocalPlayer.Character.HumanoidRootPart, torchObj, 1)
            end
            task.wait(0.5)
        end

        -- ETAPA 3: Ir ao Deserto queimar a cortina e pegar o Cálice
        TweenTo(CFrame.new(1114.5, 6.5, 4365.0))
        EquipTool("Torch")
        task.wait(1)
        -- Entra para queimar a cortina e pegar o Cup
        TweenTo(CFrame.new(1113.5, 4.8, 4349.0))
        task.wait(1)
        local cupObj = workspace.Map.Desert:FindFirstChild("Cup")
        if cupObj and firetouchinterest then
            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, cupObj, 0)
            task.wait(0.1)
            firetouchinterest(LocalPlayer.Character.HumanoidRootPart, cupObj, 1)
        end
        task.wait(0.5)
    end

    -- ETAPA 4: Encher o Cálice na Frozen Village e entregar ao Sick Man
    progress = CommF:InvokeServer("ProQuestProgress")
    if progress and not progress.UsedCup then
        -- Vai para debaixo da goteira na caverna
        TweenTo(CFrame.new(1395.5, 37.3, -1321.5))
        local cup = EquipTool("Cup")
        -- Aguarda até o cálice encher (a Handle muda ou o script aguarda os pingos)
        local timeout = 0
        while _G.AutoSaber and timeout < 15 do
            EquipTool("Cup")
            task.wait(0.5)
            timeout = timeout + 0.5
            local currentCup = LocalPlayer.Character:FindFirstChild("Cup")
            if currentCup and currentCup:FindFirstChild("Handle") and currentCup.Handle:FindFirstChild("Water") then
                break
            end
        end

        -- Sobe para a casa do Sick Man e entrega o cálice
        TweenTo(CFrame.new(1454.0, 88.2, -1391.5))
        EquipTool("Cup")
        task.wait(0.5)
        CommF:InvokeServer("ProQuestProgress", "SickMan")
        task.wait(0.5)
    end

    -- ETAPA 5: Falar com Rich Man, matar Mob Leader e pegar a Relíquia
    progress = CommF:InvokeServer("ProQuestProgress")
    if progress and not progress.UsedRelic then
        -- Fala com o Rich Man (Pirate Village)
        TweenTo(CFrame.new(-906.0, 13.7, 4077.5))
        task.wait(0.5)
        CommF:InvokeServer("ProQuestProgress", "RichSon")
        task.wait(0.5)

        -- Se ainda não matou o Mob Leader, vai na ilha dele
        progress = CommF:InvokeServer("ProQuestProgress")
        if not progress.KilledMob then
            KillBoss("Mob Leader", CFrame.new(-2852.0, 7.3, 5318.0))
            task.wait(0.5)
        end

        -- Volta no Rich Man para receber a Relic
        TweenTo(CFrame.new(-906.0, 13.7, 4077.5))
        task.wait(0.5)
        CommF:InvokeServer("ProQuestProgress", "RichSon")
        task.wait(0.5)

        -- ETAPA 6: Abrir a porta na Jungle com a Relíquia
        TweenTo(CFrame.new(-1406.0, 29.8, 4.5))
        EquipTool("Relic")
        task.wait(1)
    end

    -- ETAPA 7: Derrotar o Saber Expert (Shanks)
    print("[OmegaCore] Indo derrotar o Saber Expert...")
    KillBoss("Saber Expert", CFrame.new(-1402.0, 29.8, -32.0))

    _G.AutoSaber = false
    print("[OmegaCore] Processo finalizado! Verifique seu inventário pela Saber.")
end)
