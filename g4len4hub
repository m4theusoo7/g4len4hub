-- Blox Fruits Jungle Auto-Farm Script (Levels 10 to 30)
-- Compatível com Delta Executor
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- Configurações de Estado
getgenv().JungleFarm = true
getgenv().CurrentTarget = "Monkey"

-- Coordenadas de Referência (Jungle)
local QUEST_NPC = VectorTuple(-1255.4, 11.8, 2154.2)
local MONKEY_POS = Vector3.new(-1448.52, 67.85, 11.47)
local GORILLA_POS = Vector3.new(-1142.65, 40.46, -515.39)
local BOSS_POS = Vector3.new(-1200.0, 40.0, -450.0)
local PIRATE_VILLAGE = Vector3.new(-1141.07, 4.10, 3831.55)

-- Função Anti-AFK
player.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- Sistema de Noclip para atravessar paredes
RunService.Stepped:Connect(function()
    if getgenv().JungleFarm and player.Character and player.Character:FindFirstChild("Humanoid") then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Função de Teletransporte Suave
local function smoothTeleport(targetCFrame)
    if not humanoidRootPart then return end
    local distance = (humanoidRootPart.Position - targetCFrame.Position).Magnitude
    local speed = 300 -- Velocidade de voo
    local timeToTravel = distance / speed
    
    local startTime = tick()
    local startCFrame = humanoidRootPart.CFrame
    
    repeat
        local alpha = math.min((tick() - startTime) / timeToTravel, 1)
        humanoidRootPart.CFrame = startCFrame:Lerp(targetCFrame, alpha)
        humanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        RunService.Heartbeat:Wait()
    until alpha >= 1 or not getgenv().JungleFarm
end

-- Ativar ferramenta equipada (Arma/Fruta/Espada)
local function attack()
    pcall(function()
        local tool = player.Character:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        else
            -- Se não tiver tool equipada, tenta equipar a primeira da mochila
            local backpack = player:FindFirstChildOfClass("Backpack")
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if item:IsA("Tool") then
                        player.Character.Humanoid:EquipTool(item)
                        break
                    end
                end
            end
        end
    end)
end

-- Disparar Skills (Z, X, C, V)
local function useSkills()
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        pcall(function()
            game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
        end)
    end
end

-- Loop Principal de Farm
task.spawn(function()
    while getgenv().JungleFarm do
        task.wait(0.1)
        pcall(function()
            local level = player.Data.Level.Value
            
            -- Checar transição para Pirate Village no Level 30
            if level >= 30 then
                smoothTeleport(CFrame.new(PIRATE_VILLAGE))
                return
            end
            
            -- Determinar Alvo com base no Level
            local targetName, targetPos, questName
            if level < 15 then
                targetName = "Monkey"
                targetPos = MONKEY_POS
                questName = "JungleQuest"
            else
                targetName = "Gorilla"
                targetPos = GORILLA_POS
                questName = "JungleQuest"
            end
            
            -- Verificar se o Boss The Gorilla King está spawnado (opcional extra de XP)
            local enemyFolder = workspace:FindFirstChild("Enemies")
            local boss = enemyFolder and enemyFolder:FindFirstChild("The Gorilla King")
            
            if boss and boss:FindFirstChild("HumanoidRootPart") and boss.Humanoid.Health > 0 then
                targetPos = boss.HumanoidRootPart.Position
                targetName = "The Gorilla King"
            end
            
            -- Procurar inimigo próximo para farmar
            local enemy = nil
            if enemyFolder then
                for _, v in ipairs(enemyFolder:GetChildren()) do
                    if v.Name == targetName and v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                        enemy = v
                        break
                    end
                end
            end
            
            if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                -- Ficar levemente acima do inimigo para evitar dano corpo a corpo direto
                smoothTeleport(enemy.HumanoidRootPart.CFrame + Vector3.new(0, 4, 0))
                attack()
                useSkills()
            else
                -- Caso o inimigo não tenha carregado, vai para o spawn padrão
                smoothTeleport(CFrame.new(targetPos))
            end
        end)
    end
end)
