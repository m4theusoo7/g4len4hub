_G.AutoFarm = true

local plr = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local rep = game:GetService("ReplicatedStorage")
local vim = game:GetService("VirtualInputManager")

print("Iniciando AutoFarm...")

-- 1. Trava o personagem no ar para não cair quando teleportar
rs.Stepped:Connect(function()
    if _G.AutoFarm and plr.Character then
        for _, v in pairs(plr.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- 2. Ataca ativando a ferramenta (Garantido no Mobile/Delta)
local function atacarComArma()
    if not plr.Character then return end
    
    local arma = plr.Character:FindFirstChildOfClass("Tool")
    
    -- Se estiver de mãos vazias, procura no inventário
    if not arma then
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == "Melee" or v.ToolTip == "Sword") then
                v.Parent = plr.Character
                arma = v
                break
            end
        end
    end
    
    -- Se achou a arma, bate e usa skills
    if arma then
        arma:Activate() -- Bate perfeitamente sem precisar simular clique
        
        -- Usa as skills (Z, X, C, V)
        task.spawn(function()
            local teclas = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
            for _, t in pairs(teclas) do
                vim:SendKeyEvent(true, t, false, game)
                task.wait(0.05)
                vim:SendKeyEvent(false, t, false, game)
            end
        end)
    end
end

-- 3. Loop de Farm
task.spawn(function()
    while _G.AutoFarm do
        task.wait(0.1)
        
        -- Agora o erro aparece no console do executor se algo quebrar
        local sucesso, erro = pcall(function()
            local char = plr.Character or plr.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart")
            local level = plr.Data.Level.Value
            
            if level < 10 then
                -- Busca a interface de forma segura (Não dá erro silencioso)
                local mainGui = plr.PlayerGui:FindFirstChild("Main")
                local questGui = mainGui and mainGui:FindFirstChild("Quest")
                local temMissao = questGui and questGui.Visible
                
                if not temMissao then
                    local npc = workspace.NPCs:FindFirstChild("Bandit Quest Giver")
                    if npc and npc:FindFirstChild("HumanoidRootPart") then
                        -- Teleporta direto pro NPC
                        hrp.CFrame = npc.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        task.wait(0.5)
                        rep.Remotes.CommF_:InvokeServer("StartQuest", "Bandit Quest Giver", 1)
                    end
                else
                    local mob = workspace.Enemies:FindFirstChild("Bandit")
                    if mob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                        -- Teleporta para cima do mob (6 studs)
                        hrp.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 6, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        atacarComArma()
                    end
                end
            else
                -- Level 10 alcançado, vai pra Jungle
                hrp.CFrame = CFrame.new(-1605, 37, 152)
                print("Level 10 alcançado! Indo pra Jungle...")
                _G.AutoFarm = false
            end
        end)
        
        if not sucesso then
            warn("Erro no AutoFarm: " .. tostring(erro))
        end
    end
end)
