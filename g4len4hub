-- Blox Fruits Sea 1: Auto Quest & Farm (Lv 1-10) com verificação de estado
-- Compatível com Delta Executor

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInputManager = game:GetService("VirtualInputManager")

-- Anti-AFK
for _, connection in pairs(getconnections(LocalPlayer.Idled)) do
    connection:Disable()
end

local function getRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end

-- Função de movimentação suave (Tween)
local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    local root = getRoot(char)
    if not root then return end
    
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local speed = 300
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, info, {CFrame = targetCFrame})
    tween:Play()
    return tween
end

-- Coordenadas do Sea 1 (Starter Island)
local PirateQuestNPC = CFrame.new(1062, 16, 1546)
local BanditSpawn = CFrame.new(1150, 16, 1630)
local JungleIsland = CFrame.new(-1249, 11, 1755)

getgenv().AutoFarmSea1 = true

task.spawn(function()
    while task.wait(0.5) do
        if not getgenv().AutoFarmSea1 then break end
        
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local root = getRoot(char)
        
        if char and humanoid and root and humanoid.Health > 0 then
            local level = LocalPlayer.Data.Level.Value
            
            if level < 10 then
                -- Verifica se a quest de Bandit está ativa na tela
                local questGui = LocalPlayer.PlayerGui:FindFirstChild("Main") and LocalPlayer.PlayerGui.Main:FindFirstChild("Quest")
                local hasQuest = false
                
                if questGui and questGui.Visible then
                    local success, title = pcall(function()
                        return questGui.Container.QuestTitle.Text
                    end)
                    if success and title and string.find(string.lower(title), "bandit") then
                        hasQuest = true
                    end
                end
                
                if not hasQuest then
                    -- 1. Não tem missão: Vai até o NPC para pegar (o comando de pegar a missão atua aqui)
                    tweenTo(PirateQuestNPC)
                else
                    -- 2. Já pegou a missão: Desativa o trajeto ao NPC e farme os NPCs até completar
                    local enemyTarget = nil
                    if workspace:FindFirstChild("Enemies") then
                        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                            if enemy.Name == "Bandit" and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                local eRoot = enemy:FindFirstChild("HumanoidRootPart")
                                if eRoot then
                                    enemyTarget = enemy
                                    break
                                end
                            end
                        end
                    end
                    
                    if enemyTarget and enemyTarget:FindFirstChild("HumanoidRootPart") then
                        local eRoot = enemyTarget.HumanoidRootPart
                        -- Posiciona o avatar próximo ao inimigo
                        root.CFrame = eRoot.CFrame * CFrame.new(0, 5, 3)
                        
                        -- Ataque básico automático
                        VirtualUser:Button1Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        task.wait(0.1)
                        VirtualUser:Button1Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                        
                        -- Uso de habilidades automáticas (Z, X, C, V)
                        for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                        end
                    else
                        -- Se não houver bandidos vivos na tela, vai para a área de spawn deles
                        tweenTo(BanditSpawn)
                    end
                end
            else
                -- Ao atingir o Level 10, viaja automaticamente para a Jungle
                print("Level 10 alcançado! Indo para a Jungle...")
                tweenTo(JungleIsland)
                task.wait(3)
            end
        end
    end
end)
