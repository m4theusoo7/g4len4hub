local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    QuestName = "BanditQuest1",
    QuestLevel = 1,
    QuestNpcName = "Bandit Quest Giver",
    DefaultQuestPos = Vector3.new(1060.5, 18.5, 1548.5),
    TweenSpeed = 200
}

local function GetQuestState()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local questGui = main and main:FindFirstChild("Quest")

    if not questGui or not questGui.Visible then
        return "None"
    end

    for _, desc in ipairs(questGui:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Text ~= "" then
            local text = string.lower(desc.Text)
            if string.find(text, "bandit") or string.find(text, "bandido") then
                return "ActiveBandit"
            end
        end
    end

    return "OtherQuest"
end

local function SetTravelPhysics(character, enabled)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if hrp then
        local bv = hrp:FindFirstChild("QuestTravelBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "QuestTravelBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

local function GetQuestNpcPos()
    local npcs = workspace:FindFirstChild("NPCs")
    local npc = npcs and npcs:FindFirstChild(Config.QuestNpcName)
    if npc and npc:FindFirstChild("HumanoidRootPart") then
        return npc.HumanoidRootPart.Position + Vector3.new(0, 2, 4)
    end
    return Config.DefaultQuestPos
end

local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

if GetQuestState() == "ActiveBandit" then
    return
end

local targetPos = GetQuestNpcPos()
local distance = (hrp.Position - targetPos).Magnitude

if distance > 10 then
    SetTravelPhysics(character, true)
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPos) }
    )
    tween:Play()
    tween.Completed:Wait()
    SetTravelPhysics(character, false)
end

hrp.AssemblyLinearVelocity = Vector3.zero

if CommF then
    for _ = 1, 5 do
        local state = GetQuestState()
        if state == "ActiveBandit" then
            break
        end

        if state == "OtherQuest" then
            pcall(function()
                CommF:InvokeServer("AbandonQuest")
            end)
            task.wait(0.3)
        end

        pcall(function()
            CommF:InvokeServer("StartQuest", Config.QuestName, Config.QuestLevel)
        end)
        task.wait(0.5)
    end
end
