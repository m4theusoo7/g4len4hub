_G.AutoFarmUnderwaterCity = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")
local NetFolder = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetFolder and NetFolder:FindFirstChild("RE/RegisterAttack")
local RegisterHit = NetFolder and NetFolder:FindFirstChild("RE/RegisterHit")

local Config = {
    QuestName = "FishmanQuest",
    QuestNpcName = "King Neptune",
    DefaultQuestPos = Vector3.new(61122.65, 18.49, 1569.39),
    WhirlpoolPos = Vector3.new(3864.68, 5.37, -1926.21),
    EntrancePos = Vector3.new(61163.8515625, 11.6796875, 1819.7841796875),
    MaxLevel = 450,
    TweenSpeed = 200,
    DistanceFarm = 8,
    BringMobRadius = 250,
    AttackDelay = 0.08
}

local CurrentTween = nil
local LastTweenTargetPos = nil
local NoClipConnection = nil
local LastAuraCheck = 0
local LastEntranceCheck = 0
local WasOutsideCity = false

local QuestInProgress = false
local ActiveTask = nil
local MobsKilledInQuest = 0
local CountedDeadMobs = setmetatable({}, { __mode = "k" })

local function GetLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    return level and level.Value or 375
end

local function EnableAura()
    if not CommF then return end
    local character = LocalPlayer.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not hum or hum.Health <= 0 then return end

    if not character:FindFirstChild("HasBuso") and (os.clock() - LastAuraCheck) >= 3 then
        LastAuraCheck = os.clock()
        pcall(function()
            CommF:InvokeServer("Buso")
        end)
    end
end

local function IsInsideUnderwaterCity(pos)
    return pos and (pos - Config.EntrancePos).Magnitude <= 3000
end

local function GetWhirlpoolPos()
    local map = workspace:FindFirstChild("Map")
    local teleportSpawn = map and map:FindFirstChild("TeleportSpawn")
    if teleportSpawn then
        if teleportSpawn:IsA("BasePart") then
            return teleportSpawn.Position
        end
        local part = teleportSpawn:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.Position
        end
    end

    if map then
        for _, obj in ipairs(map:GetDescendants()) do
            if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                if (obj.Parent.Position - Config.WhirlpoolPos).Magnitude <= 250 then
                    return obj.Parent.Position
                end
            end
        end
    end

    return Config.WhirlpoolPos
end

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTargetPos = nil
end

local function IsBossAvailable(bossName)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if mob.Name == bossName then
                return true
            end
        end
    end

    local storedBoss = ReplicatedStorage:FindFirstChild(bossName)
    if storedBoss then
        return true
    end

    return false
end

