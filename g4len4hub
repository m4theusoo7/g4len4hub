_G.AutoFarm = true

local Player = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local rep = game:GetService("ReplicatedStorage")
local vu = game:GetService("VirtualUser")

-- 1. Estabilidade Total (Noclip + Flutuar)
rs.Stepped:Connect(function()
    if _G.AutoFarm and Player.Character then
        local hrp = Player.Character:FindFirstChild("HumanoidRootPart")
        
        -- Atravessar paredes
        for _, v in pairs(Player.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
        
        -- Congelar gravidade (Evita tremedeira em cima do NPC)
        if hrp and not hrp:FindFirstChild("AntiQueda") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "AntiQueda"
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        end
    end
end)

-- 2. Voo Inteligente (Sem spam de lag)
local function irPara(CFrameDestino)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local distancia = (hrp.Position - CFrameDestino.Position).Magnitude
    
    -- Se estiver perto, teleporta em vez de voar (evita bugar o Tween)
    if distancia < 10 then
        hrp.CFrame = CFrameDestino
    else
        local tween = game:GetService("TweenService"):Create(
            hrp, 
            TweenInfo.new(distancia / 320, Enum.EasingStyle.Linear), 
            {CFrame = CFrameDestino}
        )
        tween:Play()
    end
end

-- 3. Equipar e Bater
local function equiparMelee()
    for _, tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

local function atacar()
    vu:CaptureController()
    vu:ClickButton1(Vector2.new(851, 158))
end

local function usarSkills()
    -- Aciona as skills Z, X, C, V simulando o teclado
    local Vim = game:GetService("VirtualInputManager")
    local teclas = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, tecla in pairs(teclas) do
        Vim:SendKeyEvent(true, tecla, false, game)
        task.wait(0.1)
        Vim:SendKeyEvent(false, tecla, false, game)
    end
end

-- 4. O Cérebro do AutoFarm
task.spawn(function()
    while _G.AutoFarm do
        task.wait() -- Delay mínimo, sem travar o jogo
        pcall(function()
            local level = Player.Data.Level.Value
            
            -- Se for menor que level 10, farma os Bandits
            if level < 10 then
                local temMissao = Player.PlayerGui.Main.Quest.Visible
                
                if not temMissao then
                    -- Busca a missão
                    local npc = workspace.NPCs:FindFirstChild("Bandit Quest Giver")
                    if npc then
                        local posicaoNPC = npc.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
                        irPara(posicaoNPC)
                        
                        -- Só puxa a missão se estiver perto do NPC
                        if (Player.Character.HumanoidRootPart.Position - npc.HumanoidRootPart.Position).Magnitude < 10 then
                            rep.Remotes.CommF_:InvokeServer("StartQuest", "Bandit Quest Giver", 1)
                        end
                    end
                else
                    -- Farma o Bandit
                    local inimigo = workspace.Enemies:FindFirstChild("Bandit")
                    if inimigo and inimigo:FindFirstChild("Humanoid") and inimigo.Humanoid.Health > 0 then
                        -- Posição: 7 studs em cima da cabeça, olhando pra baixo (CFrame.Angles)
                        local posicaoFoco = inimigo.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        
                        irPara(posicaoFoco)
                        equiparMelee()
                        
                        -- Só ataca se estiver perto do inimigo
                        if (Player.Character.HumanoidRootPart.Position - inimigo.HumanoidRootPart.Position).Magnitude < 15 then
                            atacar()
                            usarSkills()
                        end
                    end
                end
                
            -- Se chegou no level 10, vaza pra Jungle
            else
                local jungleDestino = CFrame.new(-1605, 37, 152)
                irPara(jungleDestino)
                
                if (Player.Character.HumanoidRootPart.Position - jungleDestino.Position).Magnitude < 10 then
                    print("Chegou na Jungle! AutoFarm pausado.")
                    _G.AutoFarm = false -- Desliga para você poder assumir o controle
                end
            end
        end)
    end
end)
