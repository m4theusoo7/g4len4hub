-- ==========================================
-- COORDENADAS MAPEADAS (Importadas do seu script)
-- ==========================================
local pos_Pirate_Adventurer = Vector3.new(-1151.6, 16.6, 3863.1)
local pos_Pirate = Vector3.new(-981.0, 26.0, 3966.8)
local pos_Brute = Vector3.new(-1094.9, 26.0, 4442.9)

-- Variavel de Controle de Tween
local currentTween = nil

-- Função de Teleporte Limpo (Bypass Aéreo)
local function TP(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    
    if dist < 20 then
        -- Se estiver perto, teleporta direto para não bugar o Tween
        if currentTween then currentTween:Cancel() end
        hrp.CFrame = targetCFrame
    else
        -- Se estiver longe, usa Tween suave
        local speed = 300
        local tweenInfo = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
        currentTween = ts:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        currentTween:Play()
    end
end

-- Função para Pegar a Quest Certa
local function PegarQuest()
    local questNum = (_G.TargetMob == "Pirate") and 1 or 2
    local args = {
        [1] = "StartQuest",
        [2] = "PirateQuest",
        [3] = questNum
    }
    rep.Remotes.CommF_:InvokeServer(unpack(args))
end

-- Função para Equipar Arma
local function EquiparArma()
    local char = player.Character
    if char and not char:FindFirstChildOfClass("Tool") then
        -- Tenta puxar a primeira arma do inventário (Melee ou Espada)
        for _, tool in pairs(player.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
                char.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

-- Sistema de Noclip e Anti-Queda
rs.Stepped:Connect(function()
    if _G.AutoFarm then
        pcall(function()
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- Noclip: Atravessar paredes
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") and v.CanCollide then
                        v.CanCollide = false
                    end
                end
                -- Travar o personagem no ar enquanto ataca
                char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    end
end)

