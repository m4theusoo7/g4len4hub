-- Delta Executor: Auto-Farm Level 1 a 10 (Com Ataque Automático e Habilidades Z, X, C, V) + Teleporte para a Selva
local plr = game:GetService("Players").LocalPlayer
local vu = game:GetService("VirtualUser")
local vim = game:GetService("VirtualInputManager")

-- Anti-AFK
plr.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

local function getLevel()
    local success, lvl = pcall(function()
        return plr.Data.Level.Value
    end)
    return success and lvl or 1
end

local function useKey(keyCode)
    pcall(function()
        vim:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, keyCode, false, game)
    end)
end

task.spawn(function()
    while task.wait(0.3) do
        local lvl = getLevel()
        
        -- Ao atingir level 10, teleporta para a Jungle e encerra
        if lvl >= 10 then
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = CFrame.new(-1249, 11, 332)
            end
            break
        end
        
        local char = plr.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            -- Garante que está usando combate/ferramenta
            local tool = char:FindFirstChildOfClass("Tool") or plr.Backpack:FindFirstChild("Combat")
            if tool and tool.Parent == plr.Backpack then
                tool.Parent = char
            end
            
            -- Busca inimigos Bandit
            local enemies = workspace:FindFirstChild("Enemies")
            local target = nil
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    if enemy.Name == "Bandit" and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        target = enemy
                        break
                    end
                end
            end
            
            if target and target:FindFirstChild("HumanoidRootPart") then
                -- Posiciona em cima do bandido
                char.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 4, 2)
                
                -- Ataque básico automático
                pcall(function()
                    vu:Button1Down(Vector2.new(0,0))
                    task.wait(0.05)
                    vu:Button1Up(Vector2.new(0,0))
                end)
                
                -- Uso automático de habilidades (Z, X, C, V)
                useKey(Enum.KeyCode.Z)
                task.wait(0.1)
                useKey(Enum.KeyCode.X)
                task.wait(0.1)
                useKey(Enum.KeyCode.C)
                task.wait(0.1)
                useKey(Enum.KeyCode.V)
            else
                -- Vai para a área de spawn se não houver bandidos visíveis
                char.HumanoidRootPart.CFrame = CFrame.new(1159, 17, 1653)
            end
        end
    end
end)
