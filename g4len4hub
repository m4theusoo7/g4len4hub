-- ==========================================
-- CONFIGURAÇÕES
-- ==========================================
_G.AutoBuyWaterKungFu = true
local TweenSpeed = 200

-- ==========================================
-- SERVIÇOS E VARIÁVEIS
-- ==========================================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Coordenadas da Underwater City (Sea 1)
local WhirlpoolCFrame = CFrame.new(3864.688, 5.0, -1926.214)
local UnderwaterEntrance = Vector3.new(61163.8515625, 11.6796875, 1819.7841796875)
local TeacherCFrame = CFrame.new(61122.5625, 18.4974422454834, 1569.3997802734375)

-- ==========================================
-- FUNÇÕES AUXILIARES
-- ==========================================
local function HasWaterKungFu()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = LocalPlayer.Character
    if (backpack and backpack:FindFirstChild("Water Kung Fu")) or 
       (character and character:FindFirstChild("Water Kung Fu")) then
        return true
    end
    return false
end

local function TweenTo(targetCFrame)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = root

    local noclipConn = RunService.Stepped:Connect(function()
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = math.max(distance / TweenSpeed, 0.1)

    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    noclipConn:Disconnect()
    bv:Destroy()
end

-- ==========================================
-- ROTINA PRINCIPAL DE COMPRA
-- ==========================================
local function BuyWaterKungFu()
    if not _G.AutoBuyWaterKungFu then return end

    if HasWaterKungFu() then
        warn("[OmegaCore] Você já possui o Water Kung Fu!")
        return
    end

    local data = LocalPlayer:FindFirstChild("Data")
    local beli = data and data:FindFirstChild("Beli")
    if beli and beli.Value < 750000 then
        warn("[OmegaCore] Beli insuficiente! Necessário: $750.000 | Atual: $" .. tostring(beli.Value))
        return
    end

    local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
    if not commF then return end

    -- 1. Tenta compra direta remota primeiro
    commF:InvokeServer("BuyWaterKungFu")
    task.wait(0.8)
    if HasWaterKungFu() then
        print("[OmegaCore] Water Kung Fu comprado remotamente!")
        return
    end

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- 2. Se ainda não estiver dentro da Underwater City (X > 50000)
    if root.Position.X < 50000 then
        -- Primeiro vai até o redemoinho na superfície para passar na checagem de distância do servidor
        if (root.Position - WhirlpoolCFrame.Position).Magnitude > 150 then
            TweenTo(WhirlpoolCFrame)
            task.wait(0.5)
        end

        -- Aciona o portal oficial da entrada da Underwater City
        commF:InvokeServer("requestEntrance", UnderwaterEntrance)
        task.wait(1.5)
    end

    -- 3. TRAVA DE SEGURANÇA: Só anda até o NPC se realmente estiver dentro da Underwater City
    if root.Position.X > 50000 then
        TweenTo(TeacherCFrame)
        task.wait(0.4)
        commF:InvokeServer("BuyWaterKungFu")
        task.wait(0.8)
    else
        warn("[OmegaCore] O servidor não teleportou para a Underwater City. Cancelando Tween para não sair do mapa.")
        return
    end

    if HasWaterKungFu() then
        print("[OmegaCore] Water Kung Fu comprado com sucesso!")
    else
        warn("[OmegaCore] Chegou no NPC, mas a compra não foi concluída. Verifique o Beli.")
    end
end

BuyWaterKungFu()
