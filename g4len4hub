local RegisterHit = NetFolder and NetFolder:FindFirstChild("RE/RegisterHit")

local Config = {
    QuestName = "MagmaQuest",
    QuestNpcName = "The Mayor",
    DefaultQuestPos = Vector3.new(-5317.07, 12.27, 8517.41),
    MaxLevel = 375,
    TweenSpeed = 200,
    DistanceFarm = 8,
    BringMobRadius = 250,
    AttackDelay = 0.08
}

local CurrentTween = nil
local LastTweenTargetPos = nil
local NoClipConnection = nil

local QuestInProgress = false
local ActiveTask = nil
local MobsKilledInQuest = 0
local CountedDeadMobs = setmetatable({}, { __mode = "k" })

local function GetLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    return level and level.Value or 300
end

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTargetPos = nil
end

local function IsBossAvailable(bossName)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if mob.Name == bossName then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    return true
                end
            end
        end
    end

    local storedBoss = ReplicatedStorage:FindFirstChild(bossName)
    if storedBoss then
        local hum = storedBoss:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health > 0 then
            return true
        end
    end

    return false
end

