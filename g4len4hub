-- 2. SISTEMA DE MOVIMENTAÇÃO
local function tweenTo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 5 then return end
    
    local finalPos = targetPos
    -- Voo seguro alto para evitar bater em montanhas ao mudar de ilha
    if distance > 1000 then
        finalPos = Vector3.new(targetPos.X, targetPos.Y + 300, targetPos.Z)
    end
    
    local speed = 300
    local timeToReach = distance / speed
    
    if currentTween then currentTween:Cancel() end
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    currentTween = ts:Create(hrp, tweenInfo, {CFrame = CFrame.new(finalPos)})
    currentTween:Play()
end

local function cancelTween()
    if currentTween then currentTween:Cancel(); currentTween = nil end
end

-- 3. ATAQUES E SKILLS
local function autoAttackAndSkills()
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

