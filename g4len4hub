-- OmegaCore | Módulo: Deslocamento Seguro para Ilha Jungle (Sea 1)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Coordenada central segura próxima ao Quest Giver / entrada da Jungle
local JungleCFrame = CFrame.new(-1612.8, 36.9, 149.2)
local TweenSpeed = 280 -- Velocidade ideal para evitar rollback do anti-cheat

local function teleportToJungle()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")

    if not hrp or not humanoid then return end

    local isMoving = true

    -- Ativa Noclip e anula gravidade/queda durante o trajeto
    local stepConnection
    stepConnection = RunService.Stepped:Connect(function()
        if not isMoving or not char or not char.Parent then
            if stepConnection then stepConnection:Disconnect() end
            return
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    -- Calcula o tempo baseado na distância atual até a Jungle
    local distance = (hrp.Position - JungleCFrame.Position).Magnitude
    local duration = distance / TweenSpeed

    print(string.format("[OmegaCore] Iniciando rota para Jungle (Distância: %.0f studs | Tempo: %.1fs)", distance, duration))

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = JungleCFrame})

    tween:Play()
    tween.Completed:Wait()

    -- Finaliza o deslocamento e restaura o estado normal
    isMoving = false
    if stepConnection then stepConnection:Disconnect() end

    hrp.CFrame = JungleCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
    print("[OmegaCore] Chegou na Ilha Jungle!")
end

teleportToJungle()
