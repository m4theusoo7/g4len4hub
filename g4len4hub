-- [FIXED] No Clip - Optimized to cache parts instead of iterating every frame
getgenv().NoClip = false
getgenv().NoClipParts = {}
getgenv().NoClipConn = nil

local function updateNoClipParts(char)
	task.wait(0.5) -- Wait for character to fully load
	getgenv().NoClipParts = {}
	for _, v in pairs(char:GetDescendants()) do
		if v:IsA("BasePart") then
			table.insert(getgenv().NoClipParts, v)
		end
	end
end

game.Players.LocalPlayer.CharacterAdded:Connect(updateNoClipParts)

