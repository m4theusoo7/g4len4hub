-- ==========================================
-- AUTO BUY: WATER KUNG FU (SEA 1 - CORRIGIDO V2)
-- ==========================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas da Underwater City (Sea 1)
local WHIRLPOOL_SURFACE = CFrame.new(3876.28, 6.0, -1939.32)    -- Nível da água no redemoinho (Y = 6)
local UNDERWATER_SPAWN = Vector3.new(61163.85, 11.67, 1819.78) -- Coordenada interna da cidade
local TEACHER_CFRAME = CFrame.new(61163.85, 11.67, 1819.78)    -- Sala secreta do Water Kung Fu Teacher
local TWEEN_SPEED = 200

local noclipConn
local function setNoClip(state)
    if state then
        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return true
    end

    setNoClip(true)
    local duration = distance / TWEEN_SPEED
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    
    tween:Play()
    tween.Completed:Wait()
    setNoClip(false)
    return true
end

-- Procura a hitbox física do portal do redemoinho próxima à coordenada
local function findWhirlpoolPortal()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Position - WHIRLPOOL_SURFACE.Position).Magnitude < 120 then
            if obj:FindFirstChildOfClass("TouchTransmitter") or obj.Name:lower():find("teleport") or obj.Name:lower():find("whirl") then
                return obj
            end
        end
    end
    return nil
end

local function buyWaterKungFu()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. Verifica se já possui o estilo
    local hasStyle = LocalPlayer.Backpack:FindFirstChild("Water Kung Fu") or char:FindFirstChild("Water Kung Fu")
    if hasStyle then
        warn("[OmegaCore] Você já possui o Water Kung Fu!")
        return
    end

    -- 2. Verifica saldo em Beli
    local beli = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Beli")
    if beli and beli.Value < 750000 then
        warn("[OmegaCore] Beli insuficiente! Necessário: $750.000 | Atual: $" .. tostring(beli.Value))
        return
    end

    -- 3. Entra na Underwater City caso esteja na superfície (X < 50000)
    if hrp.Position.X < 50000 then
        print("[OmegaCore] Indo até o redemoinho no nível da água...")
        tweenTo(WHIRLPOOL_SURFACE)
        task.wait(0.3)

        -- Tenta ativar o toque físico no portal do redemoinho (suportado pelo Delta)
        local portalPart = findWhirlpoolPortal()
        if portalPart and firetouchinterest then
            print("[OmegaCore] Portal físico encontrado (" .. portalPart.Name .. "). Simulando toque...")
            firetouchinterest(hrp, portalPart, 0)
            task.wait(0.1)
            firetouchinterest(hrp, portalPart, 1)
            task.wait(1.2)
        end

        -- Se ainda não teleportou pelo toque físico, força via requestEntrance
        hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Position.X < 50000 then
            print("[OmegaCore] Tentando teleporte via requestEntrance...")
            CommF:InvokeServer("requestEntrance", UNDERWATER_SPAWN)
            task.wait(1.2)
        end
    end

    -- 4. Validação final antes de ir até o NPC
    hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or hrp.Position.X < 50000 then
        warn("[OmegaCore] Falha ao entrar na Underwater City. Verifique se o redemoinho está ativo nessa posição.")
        return
    end

    -- 5. Vai até a sala secreta do Water Kung Fu Teacher e compra
    print("[OmegaCore] Dentro da Underwater City! Indo até o Water Kung Fu Teacher...")
    if tweenTo(TEACHER_CFRAME) then
        task.wait(0.3)
        local result = CommF:InvokeServer("BuyWaterKungFu")
        print("[OmegaCore] Resposta do servidor:", tostring(result))
    end
end

buyWaterKungFu()
