_G.OmegaSea2_Missao3_Boss = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    IceAdmiralPos = Vector3.new(1347.70, 37.30, -1385.00),
    TweenSpeed = 240,
    AttackOffset = Vector3.new(0, 4.5, 5.5),
    SafeHeight = 55.0,
    RetreatAtRatio = 0.40,
    ResumeAtRatio = 0.75,
    SkillInterval = 1.15
}

local ActiveTween = nil
local TweenGoalPos = nil
local LastSkillClock = 0
local LastAttackClock = 0
local SkillIdx = 1
local TouchId = 900
local IsRetreating = false

local Skills = {
    { key = Enum.KeyCode.Z, label = "Z", hold = 0.22 },
    { key = Enum.KeyCode.X, label = "X", hold = 0.10 },
    { key = Enum.KeyCode.C, label = "C", hold = 0.10 }
}

local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaSea2Missao3UI") then
    parentGui.OmegaSea2Missao3UI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaSea2Missao3UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 54)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Missao 3] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Missao 3] " .. msg
    if color then StatusBox.TextColor3 = color end
end

local function stopTween()
    if ActiveTween then
        ActiveTween:Cancel()
        ActiveTween = nil
    end
    TweenGoalPos = nil
end

local function ensureAura(char)
    if char and not char:FindFirstChild("HasBuso") and CommF then
        pcall(function() CommF:InvokeServer("Buso") end)
    end
end

local function equipMelee(char)
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not bp or not hum then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return equipped
end

local function setNoClipPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaMissao3BV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaMissao3BV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

local function travelTo(hrp, targetPos)
    local dist = (hrp.Position - targetPos).Magnitude
    if dist <= 4.5 then
        stopTween()
        return true
    end

    if ActiveTween and ActiveTween.PlaybackState == Enum.PlaybackState.Playing and TweenGoalPos and (TweenGoalPos - targetPos).Magnitude <= 4.5 then
        return false
    end

    stopTween()
    TweenGoalPos = targetPos
    ActiveTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.08), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    ActiveTween:Play()
    return false
end

local function basicAttack(tool)
    if tool then
        pcall(function() tool:Activate() end)
    end
    local cam = workspace.CurrentCamera
    local x = cam and (cam.ViewportSize.X * 0.80) or 680
    local y = cam and (cam.ViewportSize.Y * 0.72) or 450
    TouchId += 1
    local id = TouchId
    pcall(function()
        VirtualInputManager:SendTouchEvent(id, Enum.UserInputState.Begin.Value, x, y)
        task.wait(0.04)
        VirtualInputManager:SendTouchEvent(id, Enum.UserInputState.End.Value, x, y)
    end)
end

local function castSkill(skill)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, skill.key, false, game)
    end)
    task.wait(skill.hold)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, skill.key, false, game)
    end)
end

local function findIceAdmiral()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        local low = string.lower(mob.Name)
        if string.find(low, "ice admiral", 1, true) or string.find(low, "almirante de gelo", 1, true) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_Missao3_Boss then return end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    local currentSkillName = "-"
    while _G.OmegaSea2_Missao3_Boss do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            IsRetreating = false
            stopTween()
            task.wait(0.8)
        else
            setNoClipPhysics(char, true)
            ensureAura(char)

            local boss = findIceAdmiral()
            if boss and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChildOfClass("Humanoid") then
                local bHrp = boss.HumanoidRootPart
                local bHum = boss:FindFirstChildOfClass("Humanoid")

                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if hpRatio <= Config.RetreatAtRatio then
                    IsRetreating = true
                elseif hpRatio >= Config.ResumeAtRatio then
                    IsRetreating = false
                end

                if IsRetreating then
                    local safePos = bHrp.Position + Vector3.new(0, Config.SafeHeight, 0)
                    travelTo(hrp, safePos)
                    setStatus(
                        string.format("Recuando (%d/%d) | Boss: %d/%d",
                            math.floor(hum.Health), math.floor(hum.MaxHealth),
                            math.floor(bHum.Health), math.floor(bHum.MaxHealth)),
                        Color3.fromRGB(255, 210, 90)
                    )
                else
                    local attackPos = bHrp.Position + Config.AttackOffset
                    local distToBoss = (hrp.Position - bHrp.Position).Magnitude

                    if distToBoss > 12 then
                        travelTo(hrp, attackPos)
                        setStatus(
                            string.format("Aproximando do boss | HP: %d/%d",
                                math.floor(bHum.Health), math.floor(bHum.MaxHealth)),
                            Color3.fromRGB(255, 215, 90)
                        )
                    else
                        stopTween()
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.CFrame = CFrame.lookAt(attackPos, bHrp.Position)

                        local tool = equipMelee(char)
                        if (os.clock() - LastAttackClock) >= 0.25 then
                            LastAttackClock = os.clock()
                            basicAttack(tool)
                        end

                        if (os.clock() - LastSkillClock) >= Config.SkillInterval then
                            LastSkillClock = os.clock()
                            local chosen = Skills[SkillIdx]
                            SkillIdx = (SkillIdx % #Skills) + 1
                            currentSkillName = chosen.label
                            castSkill(chosen)
                        end

                        setStatus(
                            string.format("Boss: %d/%d | Vida: %d/%d | Skill: [%s]",
                                math.floor(bHum.Health), math.floor(bHum.MaxHealth),
                                math.floor(hum.Health), math.floor(hum.MaxHealth),
                                currentSkillName),
                            Color3.fromRGB(120, 200, 255)
                        )
                    end
                end
            else
                if CommF then
                    local ok, prog = pcall(function() return CommF:InvokeServer("DressrosaQuestProgress") end)
                    if ok and type(prog) == "table" and prog.KilledIceAdmiral then
                        stopTween()
                        setStatus("SUCESSO! Almirante de Gelo derrotado! Avise para a Parte 4!", Color3.fromRGB(120, 255, 160))
                        break
                    end
                end

                local waitPos = Config.IceAdmiralPos + Vector3.new(0, 14, 0)
                if not travelTo(hrp, waitPos) then
                    setStatus("Indo ate a camara do Almirante de Gelo...", Color3.fromRGB(255, 215, 90))
                else
                    setStatus("Aguardando respawn do Almirante de Gelo...", Color3.fromRGB(255, 215, 90))
                end
            end

            RunService.Heartbeat:Wait()
        end
    end

    _G.OmegaSea2_Missao3_Boss = false
    if noclipConn then noclipConn:Disconnect() end
    stopTween()
    setNoClipPhysics(LocalPlayer.Character, false)
end)
