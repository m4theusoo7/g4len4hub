            WaitPos = Vector3.new(61900, 40, 1520)
        },
        FishmanWarrior = {
            TargetMob = "Fishman Warrior",
            QuestLevel = 1,
            RequiredKills = 8,
            IsBoss = false,
            WaitPos = Vector3.new(60915, 35, 1560)
        }
