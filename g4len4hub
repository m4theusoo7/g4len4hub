-- SCANNER GLOBAL DE COORDENADAS - BLOX FRUITS
-- ==========================================

-- Função para extrair a posição real de qualquer objeto
local function getPosition(obj)
    if obj:IsA("Model") and obj.PrimaryPart then
        return obj.PrimaryPart.Position
    elseif obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
        return obj.HumanoidRootPart.Position
    elseif obj:IsA("BasePart") then
        return obj.Position
    else
        -- Tenta achar alguma peça física dentro do modelo caso não tenha RootPart
        for _, child in pairs(obj:GetDescendants()) do
            if child:IsA("BasePart") then
                return child.Position
            end
        end
    end
    return nil
end

-- Função para ler e imprimir os diretórios
local function scanDirectory(directory, categoryName)
    if not directory then return end
    
    print("\n==================================")
    print("📍 MAPEANDO: " .. string.upper(categoryName))
    print("==================================")
    
    local count = 0
    for _, obj in pairs(directory:GetChildren()) do
        local pos = getPosition(obj)
        if pos then
            -- Formata a saída para facilitar copiar e colar no seu script de farm
            print(string.format("[%s] Nome: %s | Pos: Vector3.new(%.1f, %.1f, %.1f)", categoryName, obj.Name, pos.X, pos.Y, pos.Z))
            count = count + 1
        end
    end
    print("-> Total encontrado em " .. categoryName .. ": " .. count)
end

