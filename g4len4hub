            end

            if questGui.Visible == false then
                CheckQ()
                repeat
                    task.wait()
                    TP(CFrameQuest)
                until (CFrameQuest.Position - char.HumanoidRootPart.Position).Magnitude <= 3
                    or not _25msShared.AutoFarmLevel
                if (CFrameQuest.Position - char.HumanoidRootPart.Position).Magnitude <= 5 then
                    L_12_:InvokeServer("StartQuest", NameQuest, LevelQuest)
                end
            elseif questGui.Visible == true then
                CheckQ()
                local enemies = workspace:FindFirstChild("Enemies")
                if enemies and enemies:FindFirstChild(NameMon) then
                    for _, mob in pairs(enemies:GetChildren()) do
                        if mob.Name == NameMon
                        and mob:FindFirstChild("HumanoidRootPart")
                        and mob:FindFirstChild("Humanoid")
                        and mob.Humanoid.Health > 0
                        and string.find(questText, NameMon) then
                            repeat
                                task.wait()
                                EquipWeapon("Combat")   -- troque pela arma desejada
                                TP(mob.HumanoidRootPart.CFrame * MethodFarm)
                            until not _25msShared.AutoFarmLevel
                                or mob.Humanoid.Health <= 0
                                or not mob.Parent
                                or player.PlayerGui.Main.Quest.Visible == false
                        end
                    end
