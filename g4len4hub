-- OmegaCore / Delta Executor - Desert Island Farm (Lv. 1 a 90)
-- Sem missões | Ataque automático + Skills Z, X, C, V

getgenv().AutoDesertFarm = true

local plr = game.Players.LocalPlayer
local workspace = game:GetService("Workspace")
local vim = game:GetService("VirtualInputManager")
local vu = game:GetService("VirtualUser")

-- Sistema Anti-AFK
plr.Idled:Connect(function()
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)

-- Equipa arma/melee principal da mochila
local function equipWeapon()
    pcall(function()
        for _, v in pairs(plr.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == "Melee" or v.ToolTip == "Sword" or v.ToolTip == "Blox Fruit") then
                plr.Character.Humanoid:EquipTool(v)
                break
            end
        end
    end)
end

-- Seleção automática do alvo baseada no Level atual
local function getTargetName()
    local level = plr.Data.Level.Value
    if level < 70 then
        return "Desert Bandit"
    else
        return "Desert Officer"
    end
end

-- Localiza o inimigo mais próximo na pasta Enemies
local function getNearestEnemy(name)
    local target = nil
    local minDist = math.huge
    pcall(function()
        if workspace:FindFirstChild("Enemies") then
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
                    if v.Name == name then
                        local dist = (plr.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            target = v
                        end
                    end
                end
            end
        end
    end)
    return target
end

-- Executa a rotação de skills Z, X, C, V
local function useSkills()
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        pcall(function()
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, key, false, game)
        end)
        task.wait(0.1)
    end
end

-- Loop principal de farm
task.spawn(function()
    while task.wait(0.4) do
        if not getgenv().AutoDesertFarm then break end
        pcall(function()
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 then
                equipWeapon()
                
                local currentTarget = getTargetName()
                local enemy = getNearestEnemy(currentTarget)
                
                if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                    -- Posicionamento seguro acima e ligeiramente atrás do NPC
                    plr.Character.HumanoidRootPart.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 10, 3)
                    
                    -- Expande hitbox para facilitar o registro de dano
                    enemy.HumanoidRootPart.Size = Vector3.new(60, 60, 60)
                    enemy.HumanoidRootPart.CanCollide = false
                    
                    -- Clica para atacar
                    vu:Button1Down(Vector2.new(500, 500), workspace.CurrentCamera.ViewportSize)
                    
                    -- Dispara habilidades
                    useSkills()
                end
            end
        end)
    end
end)
