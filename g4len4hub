_G.OmegaSea2_Missao3_Boss = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    IceAdmiralPos = Vector3.new(1347.70, 37.30, -1385.00),
    TweenSpeed = 225,
    HoverHeight = 6.5
}

local CurrentTween = nil
local LastTweenTarget = nil
local LastSkillTime = 0
local SkillIndex = 1
local SkillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C }

local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaSea2Missao3UI") then
    parentGui.OmegaSea2Missao3UI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaSea2Missao3UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 52)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Missao 3 - Boss] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Missao 3 - Boss] " .. msg
    if color then StatusBox.TextColor3 = color end
end

local function ensureAura()
    local char = LocalPlayer.Character
    if not char then return false end
    if char:FindFirstChild("HasBuso") then return true end
    if CommF then
        pcall(function() CommF:InvokeServer("Buso") end)
        task.wait(0.2)
    end
    return char:FindFirstChild("HasBuso") ~= nil
end

local function equipMelee()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not bp or not hum then return nil end

    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == "Melee" or eq.ToolTip == "Sword" or eq.Name == "Combat") then
        return eq
    end
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end
    return nil
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaBossBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaBossBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = not enabled
        end
    end
end

local function tweenToCFrame(hrp, targetCF, snap)
    local dist = (hrp.Position - targetCF.Position).Magnitude
    if dist <= 4 then
        cancelTween()
        if snap then hrp.CFrame = targetCF end
        return true
    end
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetCF.Position).Magnitude <= 4 then
        return false
    end
    cancelTween()
    LastTweenTarget = targetCF.Position
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.06), Enum.EasingStyle.Linear), {
        CFrame = targetCF
    })
    CurrentTween:Play()
    return false
end

local function getBoss()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(mob.Name), "ice admiral", 1, true) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_Missao3_Boss then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while _G.OmegaSea2_Missao3_Boss do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            cancelTween()
            task.wait(0.5)
        else
            setPhysics(char, true)
            local hasAura = ensureAura()

            if not hasAura then
                setStatus("COMPRE AURA ($25.000) no Ability Teacher da caverna antes de atacar!", Color3.fromRGB(255, 110, 90))
                task.wait(1)
            else
                local boss = getBoss()
                if boss and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChildOfClass("Humanoid") then
                    local bHrp = boss.HumanoidRootPart
                    local bHum = boss:FindFirstChildOfClass("Humanoid")
                    local hoverPos = bHrp.Position + Vector3.new(0, Config.HoverHeight, 0)
                    local arrived = tweenToCFrame(hrp, CFrame.lookAt(hoverPos, bHrp.Position), true)

                    if arrived or (hrp.Position - bHrp.Position).Magnitude <= 14 then
                        local tool = equipMelee()
                        local cam = workspace.CurrentCamera
                        if cam then
                            cam.CFrame = CFrame.new(cam.CFrame.Position, bHrp.Position)
                        end

                        if tool then
                            pcall(function() tool:Activate() end)
                        end

                        pcall(function()
                            local cx = cam and (cam.ViewportSize.X / 2) or 500
                            local cy = cam and (cam.ViewportSize.Y / 2) or 300
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                        end)

                        if (os.clock() - LastSkillTime) >= 1.0 then
                            LastSkillTime = os.clock()
                            local k = SkillKeys[SkillIndex]
                            SkillIndex = (SkillIndex % #SkillKeys) + 1
                            pcall(function()
                                VirtualInputManager:SendKeyEvent(true, k, false, game)
                                task.wait(0.05)
                                VirtualInputManager:SendKeyEvent(false, k, false, game)
                            end)
                        end

                        setStatus(string.format("Atacando Ice Admiral | HP: %d/%d", math.floor(bHum.Health), math.floor(bHum.MaxHealth)), Color3.fromRGB(120, 200, 255))
                    end
                else
                    if CommF then
                        local ok, prog = pcall(function() return CommF:InvokeServer("DressrosaQuestProgress") end)
                        if ok and type(prog) == "table" and prog.KilledIceAdmiral then
                            cancelTween()
                            setStatus("SUCESSO! Ice Admiral derrotado! Me avise para a Parte 4!", Color3.fromRGB(120, 255, 160))
                            break
                        end
                    end

                    local waitPos = Config.IceAdmiralPos + Vector3.new(0, 12, 0)
                    if (hrp.Position - waitPos).Magnitude > 10 then
                        setStatus("Indo ate a camara do Ice Admiral...", Color3.fromRGB(255, 215, 90))
                        tweenToCFrame(hrp, CFrame.new(waitPos), false)
                    else
                        cancelTween()
                        hrp.CFrame = CFrame.new(waitPos)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        setStatus("Aguardando respawn do Ice Admiral...", Color3.fromRGB(255, 215, 90))
                    end
                end
            end
            RunService.Heartbeat:Wait()
        end
    end

    _G.OmegaSea2_Missao3_Boss = false
    if noclipConn then noclipConn:Disconnect() end
    cancelTween()
    setPhysics(LocalPlayer.Character, false)
end)
