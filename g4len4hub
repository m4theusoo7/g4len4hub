local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Referência direta à UI do Blox Fruits para pegar o nome da missão
local PlayerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
local PlayerModule = require(PlayerScripts:WaitForChild("PlayerModule"))
local ControlModule = PlayerModule:FindFirstChild("ControlModule")
local CameraMod = PlayerModule:FindFirstChild("CameraModule")

-- Configurações
local Settings = {
    WalkSpeed = 35,
    JumpPower = 75,
    AutoAttack = true,
    Debug = false
}

-- Função para encontrar a arma/fruta correta na mochila
function getEquippableItem()
    local backpack = LocalPlayer.Backpack
    local char = LocalPlayer.Character
    
    -- Tenta achar a primeira ferramenta equipada ou na mochila
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            return item
        end
    end
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") and item.Name ~= "Sword" and item.Name ~= "Fruit" then
            return item
        end
    end
    return nil
end

