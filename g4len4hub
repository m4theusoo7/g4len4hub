end)

local function HasAnyActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local questGui = main and main:FindFirstChild("Quest")
    return questGui and questGui.Visible or false
end

local function CheckGuiQuestProgress(taskInfo)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    if not main or not taskInfo then return "Unknown" end

    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local isDialogue = false
            local parent = obj.Parent
            while parent and parent ~= main do
                local pName = string.lower(parent.Name)
                if string.find(pName, "dialogue") or string.find(pName, "questc") then
                    isDialogue = true
                    break
                end
                parent = parent.Parent
            end

            if not isDialogue then
                local txt = string.lower((obj.Text or "") .. " " .. (obj.ContentText or ""))
                local matchesMob = false

                if taskInfo.TargetMob == "Fishman Warrior" then
                    local hasFishman = string.find(txt, "fishman") or string.find(txt, "peixe")
                    local hasWarrior = string.find(txt, "warrior") or string.find(txt, "guerreiro")
                    matchesMob = hasFishman and hasWarrior
                elseif taskInfo.TargetMob == "Fishman Commando" then
                    local hasFishman = string.find(txt, "fishman") or string.find(txt, "peixe")
                    local hasCommando = string.find(txt, "commando") or string.find(txt, "comando")
                    matchesMob = hasFishman and hasCommando
                elseif taskInfo.TargetMob == "Fishman Lord" then
                    local hasFishman = string.find(txt, "fishman") or string.find(txt, "peixe")
                    local hasLord = string.find(txt, "lord") or string.find(txt, "lorde") or string.find(txt, "senhor")
                    matchesMob = hasFishman and hasLord
                end

                if matchesMob then
                    local donePattern = taskInfo.RequiredKills .. "/" .. taskInfo.RequiredKills
                    if string.find(txt, donePattern) then
                        return "Completed"
                    elseif string.find(txt, "[0-" .. (taskInfo.RequiredKills - 1) .. "]/" .. taskInfo.RequiredKills) then
                        return "Active"
                    end
                end
            end
        end
    end

    return "Unknown"
end

-- Localiza o NPC King Neptune dinamicamente (com fallback para DefaultQuestPos)
local function GetQuestNpcPos()
    local npcs = workspace:FindFirstChild("NPCs")
    local npc = npcs and npcs:FindFirstChild(Config.QuestNpcName)
    if npc and npc:FindFirstChild("HumanoidRootPart") then
        return npc.HumanoidRootPart.Position + Vector3.new(0, 3, 3.5)
    end

    local storedNpc = ReplicatedStorage:FindFirstChild(Config.QuestNpcName)
    if storedNpc and storedNpc:FindFirstChild("HumanoidRootPart") then
        return storedNpc.HumanoidRootPart.Position + Vector3.new(0, 3, 3.5)
    end

    return Config.DefaultQuestPos
end

local function EquipWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not backpack or not hum then return nil end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return nil
end

local function UpdateKillCounter(targetMobName, isBoss)
    if isBoss then return end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName and not CountedDeadMobs[mob] then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mobHum and mobHum.Health <= 0 then
                CountedDeadMobs[mob] = true
                if QuestInProgress then
                    MobsKilledInQuest += 1
                end
            end
        end
    end
end

local function GetClosestTargetMob(targetMobName)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    local closestMob = nil
    local shortestDist = math.huge

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                local dist = (hrp.Position - mobHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

local function BringMobs(anchorMob, targetMobName)
    local enemies = workspace:FindFirstChild("Enemies")
    local anchorHrp = anchorMob and anchorMob:FindFirstChild("HumanoidRootPart")
    if not enemies or not anchorHrp then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local anchorCFrame = anchorHrp.CFrame
    anchorHrp.AssemblyLinearVelocity = Vector3.zero

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                local dist = (mobHrp.Position - anchorCFrame.Position).Magnitude
                if dist <= Config.BringMobRadius then
                    for _, part in ipairs(mob:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if mob ~= anchorMob then
                        mobHrp.CFrame = anchorCFrame
                    end

                    mobHrp.AssemblyLinearVelocity = Vector3.zero
                    mobHrp.AssemblyAngularVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

local function GetTargetsInRange(targetMobName, maxRange)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    local targets = {}
    if not hrp or not enemies or not targetMobName then return targets end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == targetMobName then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                if (hrp.Position - mobHrp.Position).Magnitude <= maxRange then
                    table.insert(targets, { mob, mobHrp })
                end
            end
        end
    end

    return targets
end

local function MoveToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3.5 then
        CancelTween()
        if snapAtEnd then
            hrp.CFrame = targetCFrame
        end
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

-- Se já houver missão da Underwater City ativa ao executar o script, inicia direto no modo farm
local allTasks = GetAllUnderwaterTasks()
for _, taskCandidate in pairs(allTasks) do
    if CheckGuiQuestProgress(taskCandidate) == "Active" then
        ActiveTask = taskCandidate
        QuestInProgress = true
        break
    end
end

-- Thread do Fast Attack
task.spawn(function()
    while _G.AutoFarmUnderwaterCity and GetLevel() < Config.MaxLevel do
        local character = LocalPlayer.Character
        local hum = character and character:FindFirstChildOfClass("Humanoid")

        if character and hum and hum.Health > 0 and QuestInProgress and ActiveTask then
            local tool = EquipWeapon()
            local targets = GetTargetsInRange(ActiveTask.TargetMob, 25)

            if tool and #targets > 0 then
                pcall(function()
                    local cam = workspace.CurrentCamera
                    local cx = cam and (cam.ViewportSize.X / 2) or 500
                    local cy = cam and (cam.ViewportSize.Y / 2) or 300

                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                    tool:Activate()

                    if RegisterAttack and RegisterHit then
                        RegisterAttack:FireServer(0)
                        RegisterHit:FireServer(targets[1][2], targets)
                    end
                end)
            end
        end

        task.wait(Config.AttackDelay)
    end
end)

-- Loop principal sequencial (Lv. 375 ao Lv. 450 na Underwater City)
task.spawn(function()
    while _G.AutoFarmUnderwaterCity and GetLevel() < Config.MaxLevel do
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        local hum = character:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            CancelTween()
            task.wait(0.5)
        elseif not IsInsideUnderwaterCity(hrp.Position) then
            WasOutsideCity = true
            SetPhysicsState(character, true)
            local whirlpoolPos = GetWhirlpoolPos()
            local distToWhirlpool = (hrp.Position - whirlpoolPos).Magnitude

            if distToWhirlpool > 15 then
                MoveToCFrame(CFrame.new(whirlpoolPos + Vector3.new(0, 8, 0)), false)
            else
                MoveToCFrame(CFrame.new(whirlpoolPos), true)

                if (os.clock() - LastEntranceCheck) >= 1.5 then
                    LastEntranceCheck = os.clock()
                    pcall(function()
                        if CommF then
                            CommF:InvokeServer("requestEntrance", Config.EntrancePos)
                        end
                    end)
                    pcall(function()
                        if firetouchinterest then
                            local map = workspace:FindFirstChild("Map")
                            if map then
                                for _, obj in ipairs(map:GetDescendants()) do
                                    if obj:IsA("TouchTransmitter") and obj.Parent and obj.Parent:IsA("BasePart") then
                                        if (obj.Parent.Position - whirlpoolPos).Magnitude <= 100 then
                                            firetouchinterest(hrp, obj.Parent, 0)
                                            task.wait(0.05)
                                            firetouchinterest(hrp, obj.Parent, 1)
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
            end

            RunService.Heartbeat:Wait()
        else
            if WasOutsideCity then
                WasOutsideCity = false
                CancelTween()
                hrp.AssemblyLinearVelocity = Vector3.zero
            end

            if not QuestInProgress then
                EnableAura()
                local nextTask = GetUnderwaterCityTaskForLevel()
                local npcPos = GetQuestNpcPos()
                local distToNpc = (hrp.Position - npcPos).Magnitude

                SetPhysicsState(character, true)

                if distToNpc > 7 then
                    MoveToCFrame(CFrame.new(npcPos), false)
                    RunService.Heartbeat:Wait()
                else
                    CancelTween()
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    task.wait(0.2)

                    if CommF then
                        if HasAnyActiveQuest() and CheckGuiQuestProgress(nextTask) ~= "Active" then
                            pcall(function()
                                CommF:InvokeServer("AbandonQuest")
                            end)
                            task.wait(0.2)
                        end

                        for _ = 1, 3 do
                            if CheckGuiQuestProgress(nextTask) == "Active" then
                                break
                            end
                            pcall(function()
                                CommF:InvokeServer("StartQuest", Config.QuestName, nextTask.QuestLevel)
                            end)
                            task.wait(0.25)
                        end
                    end

                    ActiveTask = nextTask
                    MobsKilledInQuest = 0
                    QuestInProgress = true
                end
            else
                EnableAura()
                UpdateKillCounter(ActiveTask.TargetMob, ActiveTask.IsBoss)
                local guiState = CheckGuiQuestProgress(ActiveTask)
                local nearBossArena = (hrp.Position - ActiveTask.WaitPos).Magnitude <= 150
                local bossDisappeared = ActiveTask.IsBoss and nearBossArena and not IsBossAvailable(ActiveTask.TargetMob)

                if guiState == "Completed" or MobsKilledInQuest >= ActiveTask.RequiredKills or bossDisappeared then
                    if bossDisappeared and CommF and HasAnyActiveQuest() then
                        pcall(function()
                            CommF:InvokeServer("AbandonQuest")
                        end)
                    end
                    QuestInProgress = false
                    ActiveTask = nil
                    MobsKilledInQuest = 0
                    CancelTween()
                else
                    SetPhysicsState(character, true)
                    local targetMob = GetClosestTargetMob(ActiveTask.TargetMob)

                    if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                        local mobHrp = targetMob.HumanoidRootPart
                        local farmPos = mobHrp.Position + Vector3.new(0, Config.DistanceFarm, 0)
                        local farmCFrame = CFrame.new(farmPos) * CFrame.Angles(math.rad(-90), 0, 0)

                        MoveToCFrame(farmCFrame, true)

                        if not ActiveTask.IsBoss and (hrp.Position - mobHrp.Position).Magnitude <= 65 then
                            BringMobs(targetMob, ActiveTask.TargetMob)
                        end
                    else
                        MoveToCFrame(CFrame.new(ActiveTask.WaitPos), false)
                    end

                    RunService.Heartbeat:Wait()
                end
            end
        end
    end

    _G.AutoFarmUnderwaterCity = false
    if NoClipConnection then
        NoClipConnection:Disconnect()
        NoClipConnection = nil
    end
    CancelTween()
    SetPhysicsState(LocalPlayer.Character, false)
end)
