-- OmegaCore | Módulo: Deslocamento Seguro para Ilha Desert (Sea 1)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- Coordenada segura na entrada principal da Ilha Desert (próxima ao Desert Adventurer)
local DesertCFrame = CFrame.new(944.1, 20.9, 4373.3)
local TweenSpeed = 185 -- Velocidade segura anti-rollback para travessias longas

local function teleportToDesert()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")

    if not hrp or not humanoid then return end

    local isMoving = true

    -- Trava a física do personagem para evitar estado de natação ou queda no mar
    humanoid.PlatformStand = true

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "OmegaCoreStabilizer"
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = hrp

    -- Noclip contínuo durante todo o trajeto
    local stepConnection
    stepConnection = RunService.Stepped:Connect(function()
        if not isMoving or not char or not char.Parent then
            if stepConnection then stepConnection:Disconnect() end
            return
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    -- Eleva levemente antes de partir para evitar colisão com construções da Pirate Village
    hrp.CFrame = hrp.CFrame + Vector3.new(0, 20, 0)

    local distance = (hrp.Position - DesertCFrame.Position).Magnitude
    local duration = distance / TweenSpeed

    print(string.format("[OmegaCore] Iniciando rota para Ilha Desert (Distância: %.0f studs | Tempo: %.1fs)", distance, duration))

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = DesertCFrame})

    tween:Play()
    tween.Completed:Wait()

    -- Finaliza o trajeto e restaura física/colisões
    isMoving = false
    if stepConnection then stepConnection:Disconnect() end
    if bodyVel then bodyVel:Destroy() end

    humanoid.PlatformStand = false
    hrp.CFrame = DesertCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
    print("[OmegaCore] Chegou na Ilha Desert!")
end

teleportToDesert()
