-- ====================================================
-- Blox Fruits Auto Farm - Frozen Village (Lv. 90 - 120) [Corrigido]
-- Compatível com Delta Executor
-- ====================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

getgenv().AutoFarmFrozen = true

-- Criar UI Flutuante com "Stop Tween"
local ScreenGui = Instance.new("ScreenGui")
local StopButton = Instance.new("TextButton")

ScreenGui.Name = "AutoFarmUI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

StopButton.Name = "StopTweenButton"
StopButton.Parent = ScreenGui
StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
StopButton.Position = UDim2.new(0, 20, 0, 50)
StopButton.Size = UDim2.new(0, 110, 0, 45)
StopButton.Font = Enum.Font.SourceSansBold
StopButton.Text = "Stop Tween"
StopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
StopButton.TextSize = 16
StopButton.Active = true
StopButton.Draggable = true

StopButton.MouseButton1Click:Connect(function()
    getgenv().AutoFarmFrozen = not getgenv().AutoFarmFrozen
    if getgenv().AutoFarmFrozen then
        StopButton.Text = "Stop Tween"
        StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    else
        StopButton.Text = "Resumir Farm"
        StopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- Anti-AFK
local connections = getconnections(LocalPlayer.Idled)
for _, connection in ipairs(connections) do
    connection:Disable()
end

-- Configuração de alvos por nível
local function getTargetData()
    local level = LocalPlayer.Data.Level.Value
    if level < 100 then
        return {
            Name = "Snow Bandit",
            QuestName = "SnowQuest",
            QuestIndex = 1,
            CFrame = CFrame.new(1385, 105, -1300), -- NPC
            SpawnPos = CFrame.new(1345, 105, -1320) -- Área dos mobs
        }
    elseif level < 110 then
        return {
            Name = "Snow Trooper",
            QuestName = "SnowQuest",
            QuestIndex = 2,
            CFrame = CFrame.new(1150, 145, -1540),
            SpawnPos = CFrame.new(1150, 145, -1540)
        }
    else
        return {
            Name = "Yeti",
            QuestName = "SnowQuest",
            QuestIndex = 3,
            CFrame = CFrame.new(1185, 110, -1580),
            SpawnPos = CFrame.new(1185, 110, -1580)
        }
    end
end

-- Função para achar inimigos ignorando o sufixo de nível
local function getNearestEnemy(name)
    local targetEnemy = nil
    local shortestDist = math.huge
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    for _, v in pairs(Workspace.Enemies:GetChildren()) do
        if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") then
            if v.Humanoid.Health > 0 and string.find(v.Name, name) then
                local dist = (rootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetEnemy = v
                end
            end
        end
    end
    return targetEnemy
end

-- Loop Principal de Farm
task.spawn(function()
    while task.wait(0.1) do
        if getgenv().AutoFarmFrozen then
            pcall(function()
                local target = getTargetData()
                local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not rootPart then return end
                
                -- Ativar Haki (Buso)
                if not rootPart:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end

                -- Verificar se tem quest ativa
                local questGui = LocalPlayer.PlayerGui.Main.Quest
                if not questGui.Visible then
                    -- Ir até o NPC da Quest
                    local dist = (rootPart.Position - target.CFrame.Position).Magnitude
                    if dist > 10 then
                        local tween = TweenService:Create(rootPart, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = target.CFrame})
                        tween:Play()
                        tween.Completed:Wait()
                    else
                        rootPart.CFrame = target.CFrame
                    end
                    task.wait(0.5)
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", target.QuestName, target.QuestIndex)
                    task.wait(1)
                else
                    -- Procurar inimigo ativo no mapa
                    local enemy = getNearestEnemy(target.Name)
                    if enemy then
                        local enemyRoot = enemy.HumanoidRootPart
                        local dist = (rootPart.Position - enemyRoot.Position).Magnitude
                        
                        if dist > 15 then
                            local tween = TweenService:Create(rootPart, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = enemyRoot.CFrame * CFrame.new(0, 25, 3)})
                            tween:Play()
                            tween.Completed:Wait()
                        else
                            rootPart.CFrame = enemyRoot.CFrame * CFrame.new(0, 15, 2)
                            
                            -- Executar ataques e habilidades
                            local vim = game:GetService("VirtualInputManager")
                            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                            task.wait(0.05)
                            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            
                            vim:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                            vim:SendKeyEvent(true, Enum.KeyCode.X, false, game)
                            vim:SendKeyEvent(true, Enum.KeyCode.C, false, game)
                            vim:SendKeyEvent(true, Enum.KeyCode.V, false, game)
                        end
                    else
                        -- Se os mobs ainda não nasceram, aguarda na área de spawn
                        local dist = (rootPart.Position - target.SpawnPos.Position).Magnitude
                        if dist > 10 then
                            local tween = TweenService:Create(rootPart, TweenInfo.new(dist / 250, Enum.EasingStyle.Linear), {CFrame = target.SpawnPos})
                            tween:Play()
                            tween.Completed:Wait()
                        else
                            rootPart.CFrame = target.SpawnPos
                        end
                        task.wait(1)
                    end
                end
            end)
        end
    end
end)
