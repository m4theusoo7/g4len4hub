-- Noclip controlado por estado e encerrado automaticamente no fim da sessão
local noclipConn
noclipConn = RunService.Stepped:Connect(function()
    if _G.OmegaSessionId ~= SessionId or not _G.AutoFarmPirateStarter then
        noclipConn:Disconnect()
        return
    end
    if not NoclipEnabled then return end

    local char = LocalPlayer.Character
    if char and char.Parent then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Cancela qualquer Tween em andamento
local function StopTween()
    if ActiveTween then
        ActiveTween:Cancel()
        ActiveTween = nil
    end
    ActiveGoal = nil
end

-- Ativa sustentação aérea durante deslocamento/farm
local function HoldAvatar(char)
    NoclipEnabled = true
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bv = hrp:FindFirstChild("TempQuestBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "TempQuestBV"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    else
        bv.Velocity = Vector3.zero
    end
end

-- Libera 100% o avatar (remove antigravidade, restaura colisão e solta o Humanoid)
local function ReleaseAvatar(char)
    NoclipEnabled = false
    StopTween()
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.PlatformStand = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("TempQuestBV")
        if bv then bv:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    for _, partName in ipairs({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

-- Verifica se a missão já está ativa
local function HasQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
    return questFrame and questFrame.Visible == true
end

-- Retorna a posição na frente do NPC (ou a coordenada fixa de reserva)
local function GetNPCTargetCFrame()
    local wsNPCs = workspace:FindFirstChild("NPCs")
    local rsNPCs = ReplicatedStorage:FindFirstChild("NPCs")
    local npc = (wsNPCs and wsNPCs:FindFirstChild("Bandit Quest Giver"))
        or (rsNPCs and rsNPCs:FindFirstChild("Bandit Quest Giver"))

    local npcHRP = npc and npc:FindFirstChild("HumanoidRootPart")
    if npcHRP then
        return npcHRP.CFrame * CFrame.new(0, 0, -4)
    end
    return FallbackNPC_CFrame
end

-- Equipa Combat / Melee automaticamente
local function EquipMelee(char)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(tool)
                return tool
            end
        end
    end
    return equipped
end

-- Bring Mob: agrupa todos os Bandits próximos no alvo principal
local function BringEnemies(mainTarget)
    if not BringMob or not mainTarget then return end
    local mainHRP = mainTarget:FindFirstChild("HumanoidRootPart")
    if not mainHRP then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local safeY = math.max(mainHRP.Position.Y, 16.5)
    local anchorCF = CFrame.new(mainHRP.Position.X, safeY, mainHRP.Position.Z)
    mainHRP.CFrame = anchorCF
    mainHRP.CanCollide = false
    mainHRP.AssemblyLinearVelocity = Vector3.zero

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if mob ~= mainTarget and string.find(mob.Name, MobName) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                if (mobHRP.Position - anchorCF.Position).Magnitude <= BringRadius then
                    mobHRP.CFrame = anchorCF
                    mobHRP.CanCollide = false
                    mobHRP.AssemblyLinearVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

