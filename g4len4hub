-- ==========================================
-- OmegaCore - Pirate Village Auto-Farm (Lvl 30-60)
-- ==========================================

_G.AutoFarmPirateVillage = true -- Mude para false para parar o script

local player = game.Players.LocalPlayer
local rs = game:GetService("ReplicatedStorage")
local commF = rs:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas Mapeadas (Pirate Village)
local pos_Pirate = Vector3.new(-981.0, 26.0, 3966.8)
local pos_Brute = Vector3.new(-1094.9, 26.0, 4442.9)

-- Configuração do Alvo Atual
local mobAlvo = "Pirate" -- Mude para "Brute" no nível 40
local questNome = "PirateQuest"
local questLevel = 1 -- 1 = Pirate, 2 = Brute
local spawnAtual = pos_Pirate

-- 1. MENSAGEM FALSA PARA O SERVIDOR (Remote Spoofing)
local function pegarMissaoRemota()
    local gui = player.PlayerGui
    -- Verifica se o painel de missão não está visível na tela
    if gui and gui:FindFirstChild("Main") and gui.Main:FindFirstChild("Quest") and not gui.Main.Quest.Visible then
        pcall(function()
            -- Envia os argumentos diretos para o servidor fingindo interação com o NPC
            commF:InvokeServer("StartQuest", questNome, questLevel)
        end)
        task.wait(0.5) -- Pausa rápida para o servidor processar e a UI atualizar
    end
end

-- 2. FUNÇÃO DE ATAQUE E MOVIMENTAÇÃO
local function autoFarma()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local alvoEncontrado = false

    -- Procura o mob renderizado no mapa
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v.Name == mobAlvo and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
            alvoEncontrado = true
            
            -- Bypass de colisão para não prender em paredes (Noclip)
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            
            -- TP para as costas do inimigo
            char.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            
            -- Ativa a ferramenta (Fast Attack embutido do executor ou clique padrão)
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                tool:Activate()
            end
            
            break -- Trava em um inimigo até ele morrer
        end
    end

    -- Se não achou o mob vivo perto, vai para a coordenada de Spawn que você mapeou
    if not alvoEncontrado then
        char.HumanoidRootPart.CFrame = CFrame.new(spawnAtual)
    end
end

-- 3. LOOP PRINCIPAL DO OMEGACORE
task.spawn(function()
    while task.wait() do
        if _G.AutoFarmPirateVillage then
            pegarMissaoRemota()
            autoFarma()
        end
    end
end)
