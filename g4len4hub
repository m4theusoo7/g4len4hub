-- ==========================================
-- SCANNER GLOBAL DO SEA 1 - OMEGA CORE
-- Mapeia: Ilha -> NPC Missão -> Mobs
-- ==========================================

local workspace = game:GetService("Workspace")

-- Função para pegar a posição exata de um objeto
local function getPos(obj)
    if obj:FindFirstChild("HumanoidRootPart") then return obj.HumanoidRootPart.Position end
    if obj:IsA("Model") and obj.PrimaryPart then return obj.PrimaryPart.Position end
    if obj:IsA("BasePart") then return obj.Position end
    return nil
end

print("\n=======================================================")
print("🌍 INICIANDO MAPEAMENTO GLOBAL DO SEA 1 🌍")
print("=======================================================\n")

local ilhas = {}

-- 1. Encontrar todos os NPCs de Missão (Eles definem onde é a ilha)
for _, npc in pairs(workspace.NPCs:GetChildren()) do
    local nomeLower = string.lower(npc.Name)
    -- Procura por NPCs que entregam missões (Geralmente têm "Quest" no nome)
    if string.find(nomeLower, "quest") then
        local pos = getPos(npc)
        if pos then
            -- Limpa o nome para ficar mais bonito na tabela
            local nomeLimpo = npc.Name:gsub(" Quest Giver", ""):gsub("Quest Giver", ""):gsub("Quest", "")
            if nomeLimpo == "" or nomeLimpo == " " then nomeLimpo = npc.Name end
            
            table.insert(ilhas, {
                NomeIlha = nomeLimpo,
                NPCMissao = npc.Name,
                PosMissao = pos,
                Inimigos = {}
            })
        end
    end
end

-- 2. Mapear Inimigos e atrelar à Ilha correspondente
if workspace:FindFirstChild("Enemies") then
    for _, mob in pairs(workspace.Enemies:GetChildren()) do
        local posMob = getPos(mob)
        if posMob then
            local ilhaMaisProxima = nil
            local menorDist = 1500 -- Raio máximo de 1500 studs para pertencer à mesma ilha
            
            -- Descobre de qual ilha este monstro é
            for _, ilha in pairs(ilhas) do
                local dist = (ilha.PosMissao - posMob).Magnitude
                if dist < menorDist then
                    menorDist = dist
                    ilhaMaisProxima = ilha
                end
            end
            
            if ilhaMaisProxima then
                -- Agrupa por nome do monstro
                if not ilhaMaisProxima.Inimigos[mob.Name] then
                    ilhaMaisProxima.Inimigos[mob.Name] = {}
                end
                table.insert(ilhaMaisProxima.Inimigos[mob.Name], posMob)
            end
        end
    end
end

-- 3. Gerar o Código no Console (Formato Tabela Lua)
print("📋 RESULTADO DA VARREDURA (Copie e cole no seu OmegaCore):")
print("local Sea1Data = {")

for _, ilha in pairs(ilhas) do
    print(string.format('    ["%s"] = {', ilha.NomeIlha))
    print(string.format('        PosicaoIlha = Vector3.new(%.1f, %.1f, %.1f), -- Centro da Ilha', ilha.PosMissao.X, ilha.PosMissao.Y, ilha.PosMissao.Z))
    print(string.format('        NPC_Missao = "%s",', ilha.NPCMissao))
    print(string.format('        Pos_Missao = Vector3.new(%.1f, %.1f, %.1f),', ilha.PosMissao.X, ilha.PosMissao.Y, ilha.PosMissao.Z))
    print('        Mobs = {')
    
    local temMob = false
    for nomeMob, posicoes in pairs(ilha.Inimigos) do
        temMob = true
        print(string.format('            ["%s"] = {', nomeMob))
        
        -- Mostra até 3 coordenadas de spawn desse monstro para não floodar
        local max = math.min(3, #posicoes)
        for i = 1, max do
            print(string.format('                Vector3.new(%.1f, %.1f, %.1f),', posicoes[i].X, posicoes[i].Y, posicoes[i].Z))
        end
        print('            },')
    end
    
    if not temMob then
        print('            -- [AVISO]: Nenhum mob spawnado perto deste NPC durante a varredura!')
    end
    
    print('        }')
    print('    },')
end
print("}")
print("\n✅ VARREDURA CONCLUÍDA! Abra o F9 e suba o terminal para ver tudo. ✅")
