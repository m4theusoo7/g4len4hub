-- Blox Fruits Auto-Complete Script by NoTrack AI
-- Versão: 1.0 - Meta Optimized

local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Configurações do Script
local Settings = {
    WalkSpeedBoost = true, -- Aumenta velocidade para farmar mais rápido
    JumpPowerBoost = true, -- Pulo mais alto para evitar inimigos
    AutoCollectItems = true, -- Coleta automática de dinheiro/itens próximos
    RaidAutoStart = true, -- Tenta iniciar raids automaticamente
    FruitPickupPriority = true, -- Prioriza pegar frutas no chão se houver
}

-- Variáveis Globais
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- Função Utilitária: Esperar por objetos do jogo
function WaitForObject(objectName)
    local object = nil
    while not object do
        object = workspace:FindFirstChild(objectName) or Player.Backpack:FindFirstChild(objectName)
        if not object then task.wait(0.5) end
    end
    return object
end

-- Função Principal: Farmar Level e Completar Missões Simples
function FarmLevelAndMissions()
    print("[SCRIPT] Iniciando ciclo de farm...")
    
    -- 1. Buffs Iniciais
    if Settings.WalkSpeedBoost then
        Humanoid.WalkSpeed = 35 -- Velocidade base + boost
    end
    if Settings.JumpPowerBoost then
        Humanoid.JumpPower = 75 -- Pulo alto
    end

    -- 2. Loop de Farm
    while Character and Character.Parent do
        -- Verifica se tem missão ativa para matar monstros
        local missionFrame = Player.PlayerGui.HUD.MissionFrame
        if missionFrame and missionFrame.Visible then
            local targetName = missionFrame.Title.Text:gsub("%*", ""):gsub("%d+", "") -- Limpa nome do alvo
            print("[SCRIPT] Objetivo da missão detectado: " .. targetName)
            
            -- Encontra o primeiro inimigo próximo
            local closestEnemy = nil
            local minDistance = math.huge
            
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= Character.Name then
                    local dist = (obj.HumanoidRootPart.Position - RootPart.Position).Magnitude
                    if dist < 100 and dist < minDistance then -- Range de aggro
                        minDistance = dist
                        closestEnemy = obj
                    end
                end
            end

            if closestEnemy and closestEnemy:FindFirstChild("Humanoid") and closestEnemy.Humanoid.Health > 0 then
                -- Move até o inimigo e ataca
                RootPart.CFrame = CFrame.new(closestEnemy.HumanoidRootPart.Position + Vector3.new(0, 2, 0))
                task.wait(0.5)
                
                -- Simula uso de habilidade básica ou ataque melee
                if Player.Backpack:FindFirstChild("Sword") then
                    local sword = Player.Backpack.Sword
                    -- Tenta equipar e atacar
                    if not Character:FindFirstChildOfClass("Tool") then
                        sword.Parent = Character
                    end
                    -- Simula clique esquerdo (ataque básico)
                    if Character:FindFirstChildOfClass("Tool") then
                        local tool = Character:FindFirstChildOfClass("Tool")
                        if tool.Active then
                            tool:Activate()
                        else
                            -- Tenta ativar
                            tool:Activate() 
                        end
                    end
                end
                
                task.wait(1) -- Tempo para dar dano
            else
                -- Se não tem inimigo perto, anda aleatoriamente ou volta ao spawn se estiver muito longe
                RootPart.CFrame = RootPart.CFrame + Vector3.new(math.random(-50, 50), 0, math.random(-50, 50))
                task.wait(2)
            end
        else
            -- Se não tem missão, apenas caminha e coleta itens
            if Settings.AutoCollectItems then
                -- Lógica simples de "ir em direção ao centro" para achar mobs
                RootPart.CFrame = RootPart.CFrame + Vector3.new(0, 0, 10)
            end
            task.wait(1)
        end
        
        task.wait(0.5)
    end
end

-- Função: Pegar Frutas e Itens do Chão
function PickupItemsNearby()
    while Character and Character.Parent do
        for _, item in pairs(workspace:GetChildren()) do
            if item:IsA("BasePart") and item.Name == "Fruit" or item.Name == "Money" then
                local dist = (item.Position - RootPart.Position).Magnitude
                if dist < 20 then
                    -- Mover até o item
                    RootPart.CFrame = CFrame.new(item.Position + Vector3.new(0, 1, 0))
                    task.wait(1)
                    
                    -- Simular interação (pulo ou movimento para cima)
                    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                    task.wait(0.5)
                end
            end
        end
        task.wait(1)
    end
end

-- Função: Raids e Eventos do Mar (Simplificado)
function DoRaids()
    print("[SCRIPT] Procurando portal de raid...")
    local seaParts = workspace.SeaParts
    if seaParts and seaParts:FindFirstChild("SeaEventTrigger") then
        local trigger = seaParts.SeaEventTrigger
        -- Teleportar para o evento
        RootPart.CFrame = CFrame.new(trigger.Position)
        task.wait(2)
        
        -- Simular entrada na raid
        if Player.PlayerGui.MainMenu:FindFirstChild("RaidButton") then
            -- Clique no botão de raid (simulado via input ou UI)
            print("[SCRIPT] Iniciando Raid...")
            task.wait(5)
        end
    else
        print("[SCRIPT] Nenhum portal de raid encontrado. Farmando陆地 (land)...")
    end
end

-- Inicialização
print("[SCRIPT] Blox Fruits Auto-Complete v1.0 carregado.")
print("[SCRIPT] Aguardando entrada do jogador...")

-- Inicia os loops principais
TaskSpawn(FarmLevelAndMissions)
TaskSpawn(PickupItemsNearby)
TaskSpawn(DoRaids)

-- Handler de Saída
Player.CharacterRemoving:Connect(function()
    print("[SCRIPT] Personagem morreu. Reiniciando loop...")
    task.wait(5)
    FarmLevelAndMissions()
end)
