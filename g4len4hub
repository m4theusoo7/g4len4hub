local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

-- Coordenadas da Underwater City e do NPC (Sea 1)
local UnderwaterEntrance = Vector3.new(61163.8515625, 11.6796875, 1819.7841796875)
local FallbackTeacherCFrame = CFrame.new(61577, 18, 1564)

-- Procura o CFrame exato do NPC no Workspace ou ReplicatedStorage
local function GetTeacherCFrame()
    for _, folder in ipairs({workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs"), workspace}) do
        if folder then
            local npc = folder:FindFirstChild("Water Kung Fu Teacher", true)
            if npc and npc:IsA("Model") then
                local root = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Head")
                if root then
                    return root.CFrame * CFrame.new(0, 0, 3)
                end
            end
        end
    end
    return FallbackTeacherCFrame
end

-- 1. Se ainda estiver fora da Underwater City, entra pelo portal oficial
if hrp.Position.X < 50000 then
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("requestEntrance", UnderwaterEntrance)
    end)
    task.wait(0.8)
end

-- 2. Teleporta direto para a frente do Water Kung Fu Teacher
char = LocalPlayer.Character
hrp = char and char:FindFirstChild("HumanoidRootPart")
if hrp then
    hrp.Anchored = false
    hrp.CFrame = GetTeacherCFrame()
    task.wait(0.3)

    -- 3. Compra o estilo de luta Water Kung Fu ($750.000 Beli)
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyFishmanKarate")
    end)
end
