-- OmegaCore | Módulo: Desert Auto-Farm (Lv. 60 ao 90 - Estrutura Limpa)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local TargetLevel = 90
local FarmHeight = 7 -- Distância vertical segura acima do NPC
local TweenSpeed = 250

-- Pontos de referência caso os NPCs estejam longe para renderizar
local SpawnPoints = {
    ["Desert Bandit"] = CFrame.new(932.5, 25.0, 4488.0),
    ["Desert Officer"] = CFrame.new(1572.0, 15.0, 4373.0)
}

-- Configurações de Combate
local Skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
local _G_AutoFarm = true

-- Ativa Noclip para evitar colisões durante o deslocamento
local noclipConnection
noclipConnection = RunService.Stepped:Connect(function()
    if not _G_AutoFarm then
        if noclipConnection then noclipConnection:Disconnect() end
        return
    end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Função para equipar a ferramenta de combate (Melee/Espada)
local function equipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- Função de movimento suave via Tween (igual ao primeiro script)
local function moveTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return
    end

    local info = TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Simula clique do mouse (Ataque Básico)
local function basicAttack()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- Define o alvo atual com base no Level
local function getEnemyName(currentLevel)
    if currentLevel < 70 then
        return "Desert Bandit"
    else
        return "Desert Officer"
    end
end

-- Rotação de Skills (Z, X, C, V)
task.spawn(function()
    while _G_AutoFarm do
        local data = LocalPlayer:FindFirstChild("Data")
        local level = data and data:FindFirstChild("Level")
        if level and level.Value >= TargetLevel then break end

        for _, key in ipairs(Skills) do
            if not _G_AutoFarm then break end
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(0.4)
        end
        task.wait(1)
    end
end)

-- Loop Principal de Farm
task.spawn(function()
    while _G_AutoFarm do
        local data = LocalPlayer:FindFirstChild("Data")
        local level = data and data:FindFirstChild("Level")
        local currentLevel = level and level.Value or 60

        -- Para o script automaticamente ao atingir o Level 90
        if currentLevel >= TargetLevel then
            _G_AutoFarm = false
            print("[OmegaCore] Level 90 atingido! Auto-Farm do Deserto finalizado.")
            break
        end

        local enemyName = getEnemyName(currentLevel)
        local enemiesFolder = workspace:FindFirstChild("Enemies")
        local targetEnemy = nil

        if enemiesFolder then
            for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                if string.find(enemy.Name, enemyName) and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                    targetEnemy = enemy
                    break
                end
            end
        end

        if targetEnemy then
            equipWeapon()
            local attackPos = targetEnemy.HumanoidRootPart.CFrame * CFrame.new(0, FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            moveTo(attackPos)

            -- Mantém travado em cima enquanto ataca
            while targetEnemy and targetEnemy.Parent and targetEnemy:FindFirstChild("Humanoid") and targetEnemy.Humanoid.Health > 0 and _G_AutoFarm do
                currentLevel = level and level.Value or currentLevel
                if currentLevel >= TargetLevel then
                    _G_AutoFarm = false
                    break
                end

                -- Troca para Desert Officer assim que bater Level 70
                if getEnemyName(currentLevel) ~= enemyName then
                    break
                end

                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp and targetEnemy:FindFirstChild("HumanoidRootPart") then
                    hrp.CFrame = targetEnemy.HumanoidRootPart.CFrame * CFrame.new(0, FarmHeight, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end

                equipWeapon()
                basicAttack()
                task.wait(0.15)
            end
        else
            -- Se não encontrar o NPC renderizado, vai até a área de spawn dele
            local spawnPos = SpawnPoints[enemyName]
            if spawnPos then
                moveTo(spawnPos)
            end
            task.wait(0.5)
        end
        task.wait(0.1)
    end
end)
