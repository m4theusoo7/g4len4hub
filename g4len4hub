local player = game:GetService("Players").LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hrp = char:WaitForChild("HumanoidRootPart")

local searchRadius = 2500 -- Raio de busca para focar só na ilha atual
local output = "-- Mapeamento de NPCs da Ilha Atual (Raio: " .. searchRadius .. " studs)\n\n"

local function scanFolder(folder)
    if not folder then return end
    local foundNames = {}
    
    for _, obj in pairs(folder:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local npcPos = obj.HumanoidRootPart.Position
            local distance = (hrp.Position - npcPos).Magnitude
            
            -- Verifica se o NPC está na mesma ilha e se já não foi mapeado
            if distance <= searchRadius then
                if not foundNames[obj.Name] then
                    local vectorCode = string.format("Vector3.new(%.1f, %.1f, %.1f)", npcPos.X, npcPos.Y, npcPos.Z)
                    
                    -- Formata o nome para ser uma variável válida em Lua (tira espaços)
                    local varName = string.gsub(obj.Name, "%s+", "_")
                    
                    output = output .. string.format("-- %s (Distância: %.1f studs)\n", obj.Name, distance)
                    output = output .. string.format("local pos_%s = %s\n\n", varName, vectorCode)
                    
                    foundNames[obj.Name] = true
                end
            end
        end
    end
end

output = output .. "-----------------------------------\n"
output = output .. "------- INIMIGOS (MOBS) -----------\n"
output = output .. "-----------------------------------\n"
scanFolder(workspace:FindFirstChild("Enemies"))

output = output .. "-----------------------------------\n"
output = output .. "----- NPCs (QUESTS / LOJAS) -------\n"
output = output .. "-----------------------------------\n"
scanFolder(workspace:FindFirstChild("NPCs"))

-- Imprime no console (F9) por segurança
print(output)

