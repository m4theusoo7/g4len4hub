-- =======================================================
-- BLOX FRUITS - AUTO FARM PIRATE STARTER V3 (DEFINITIVO)
-- Correção: Atravessa paredes, espera spawn e não congela
-- =======================================================

local plr = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local vu = game:GetService("VirtualUser")
local rep = game:GetService("ReplicatedStorage")

-- [1] Sistema Anti-AFK
plr.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

local function getMelee()
    for _, v in pairs(plr.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == "Melee" then return v end
    end
    for _, v in pairs(plr.Character:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == "Melee" then return v end
    end
    return nil
end

local function temMissao()
    local main = plr.PlayerGui:FindFirstChild("Main")
    if main and main:FindFirstChild("Quest") and main.Quest.Visible then
        return true
    end
    return false
end

local function acharBandit()
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v.Name:find("Bandit") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
            return v
        end
    end
    return nil
end

local farmLigado = true

-- =======================================================
-- CÉREBRO 1: MOVIMENTO, NOCLIP E ATAQUE (Roda super rápido)
-- =======================================================
rs.Stepped:Connect(function()
    if not farmLigado then return end
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    
    if plr.Data.Level.Value >= 10 then 
        farmLigado = false
        print("LEVEL 10 ATINGIDO! Script finalizado.")
        return 
    end
    
    local hrp = plr.Character.HumanoidRootPart
    
    -- Ativa NoClip (Atravessar paredes e não bugar fisicamente)
    plr.Character.Humanoid:ChangeState(11)
    
    if temMissao() then
        local bandit = acharBandit()
        if bandit then
            -- Vai pra cima do Bandit (7 studs de altura para não levar dano)
            hrp.CFrame = bandit.HumanoidRootPart.CFrame * CFrame.new(0, 7, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            
            -- Puxa a arma e espanca o clique e as skills
            local melee = getMelee()
            if melee then
                plr.Character.Humanoid:EquipTool(melee)
                melee:Activate()
                vu:CaptureController()
                vu:ClickButton1(Vector2.new())
                
                -- Usa skills se estiverem prontas
                vu:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                vu:SendKeyEvent(true, Enum.KeyCode.X, false, game)
            end
        else
            -- SE OS BANDITS AINDA NÃO NASCERAM, VAI PRO CAMPO DELES ESPERAR!
            hrp.CFrame = CFrame.new(1185, 16, 1617)
        end
    else
        -- SE NÃO TEM MISSÃO, VAI PRO NPC
        hrp.CFrame = CFrame.new(1060, 16, 1547)
    end
end)

-- =======================================================
-- CÉREBRO 2: PEGADOR DE MISSÕES (Roda separado para não travar)
-- =======================================================
task.spawn(function()
    while farmLigado do
        task.wait(1)
        if plr.Data.Level.Value >= 10 then break end
        
        -- Se estiver no NPC e sem missão, aciona o servidor
        if not temMissao() then
            if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (plr.Character.HumanoidRootPart.Position - Vector3.new(1060, 16, 1547)).Magnitude
                -- Só tenta pegar a missão se estiver perto do NPC
                if dist < 20 then
                    rep.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                end
            end
        end
    end
end)
