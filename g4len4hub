-- ============ TP (igual ao original, simplificado) ============
function TP(cf)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (cf.Position - hrp.Position).Magnitude
    if dist <= _25msShared.SkipDistance then
        hrp.CFrame = cf
        return
    end
    local tw = game:GetService("TweenService"):Create(hrp,
        TweenInfo.new(dist / 300, Enum.EasingStyle.Linear), {CFrame = cf})
    hrp.CFrame = CFrame.new(hrp.CFrame.X, cf.Y, hrp.CFrame.Z)
    tw:Play()
end

-- ============ Equipar arma ============
function EquipWeapon(name)
    local char = player.Character
    if not char then return end
    local backpack = player:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(name) then
        char:FindFirstChildOfClass("Humanoid"):EquipTool(backpack[name])
    end
end

