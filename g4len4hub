-- Cancela Tween ativo
local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    CurrentTweenGoal = nil
end

-- Libera completamente o personagem ao atingir Level 10 ou desligar o script
local function CleanupCharacter()
    CancelTween()
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.PlatformStand = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaAntiGravity")
        if bv then bv:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso") then
            part.CanCollide = true
        end
    end
end

