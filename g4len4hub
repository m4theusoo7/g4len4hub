-- OmegaCore | Módulo: Pirate Village Auto-Farm (Lv. 30 ao 60 - Mira de Skills Corrigida)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local MaxTargetLevel = 60

-- Altura ideal para acertar ataques básicos e skills sem tomar dano
local FarmHeight = 7.5
local BossExtraHeight = 1.5 -- Total: 9.0 studs para Brute e Chef
local TweenSpeed = 185

local SpawnPoints = {
    ["Pirate"] = CFrame.new(-1211.8, 14.5, 3915.2),
    ["Brute"] = CFrame.new(-1145.0, 15.0, 4305.0),
    ["Chef"] = CFrame.new(-1131.5, 14.5, 4080.0)
}

local Skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
local _G_PirateFarm = true
local CurrentLockedEnemy = nil -- Compartilha o alvo ativo com a thread de skills

-- Calcula o CFrame seguro acima do alvo
local function getSafeAboveCFrame(enemy)
    local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
    if not enemyHRP then return nil end

    local heightOffset = FarmHeight
    if enemy.Name == "Chef" or enemy.Name == "Brute" then
        heightOffset = FarmHeight + BossExtraHeight
    end

    return enemyHRP.CFrame * CFrame.new(0, heightOffset, 0) * CFrame.Angles(math.rad(-90), 0, 0)
end

-- Aponta a câmera e o cursor virtual exatamente para o centro do NPC
local function aimAtEnemy(enemy)
    local enemyHRP = enemy and enemy:FindFirstChild("HumanoidRootPart")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not enemyHRP or not hrp then return end

    -- Orienta a câmera de cima para baixo mirando no tronco do inimigo
    local camPos = hrp.Position + Vector3.new(0, 4, 0)
    Camera.CFrame = CFrame.lookAt(camPos, enemyHRP.Position)

    -- Move o cursor virtual para a posição exata do NPC na tela
    local screenPos, onScreen = Camera:WorldToViewportPoint(enemyHRP.Position)
    if onScreen then
        VirtualInputManager:SendMouseMoveEvent(screenPos.X, screenPos.Y, game)
    end
end

-- Noclip contínuo
local noclipConnection
noclipConnection = RunService.Stepped:Connect(function()
    if not _G_PirateFarm then
        if noclipConnection then noclipConnection:Disconnect() end
        return
    end
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Equipa Melee ou Espada automaticamente
local function equipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- Deslocamento estabilizado com BodyVelocity + PlatformStand
local function safeMoveTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 10 then
        hrp.CFrame = targetCFrame
        return
    end

    humanoid.PlatformStand = true
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "OmegaCoreStabilizer"
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = hrp

    local info = TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()

    if bodyVel then bodyVel:Destroy() end
    humanoid.PlatformStand = false
    hrp.AssemblyLinearVelocity = Vector3.zero
end

-- Procura o inimigo pelo nome em workspace.Enemies
local function findEnemy(enemyName)
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in ipairs(enemiesFolder:GetChildren()) do
            if enemy.Name == enemyName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                return enemy
            end
        end
    end
    return nil
end

-- Verifica se o Boss Chef está vivo no servidor
local function isBossAlive(bossName)
    if findEnemy(bossName) then return true end
    local repEnemy = ReplicatedStorage:FindFirstChild(bossName)
    if repEnemy and repEnemy:FindFirstChild("Humanoid") and repEnemy.Humanoid.Health > 0 then
        return true
    end
    return false
end

-- Define o alvo atual com base no Level e na presença do Chef
local function getCurrentTargetName(currentLevel)
    if currentLevel < 35 then
        return "Pirate"
    elseif currentLevel < 55 then
        return "Brute"
    else
        if isBossAlive("Chef") then
            return "Chef"
        else
            return "Brute"
        end
    end
end

-- Ataque Básico
local function basicAttack()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- Thread paralela de Skills (só dispara quando há um inimigo travado abaixo do personagem)
task.spawn(function()
    while _G_PirateFarm do
        local data = LocalPlayer:FindFirstChild("Data")
        local level = data and data:FindFirstChild("Level")
        if level and level.Value >= MaxTargetLevel then break end

        if CurrentLockedEnemy and CurrentLockedEnemy.Parent and CurrentLockedEnemy:FindFirstChild("Humanoid") and CurrentLockedEnemy.Humanoid.Health > 0 then
            for _, key in ipairs(Skills) do
                if not _G_PirateFarm or not CurrentLockedEnemy or CurrentLockedEnemy.Humanoid.Health <= 0 then break end
                
                aimAtEnemy(CurrentLockedEnemy)
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(0.15) -- Pequeno hold para skills que exigem carregamento breve
                VirtualInputManager:SendKeyEvent(false, key, false, game)
                task.wait(0.35)
            end
        end
        task.wait(0.2)
    end
end)

-- Loop Principal de Farm
task.spawn(function()
    while _G_PirateFarm do
        local data = LocalPlayer:FindFirstChild("Data")
        local levelObj = data and data:FindFirstChild("Level")
        local currentLevel = levelObj and levelObj.Value or 30

        if currentLevel >= MaxTargetLevel then
            _G_PirateFarm = false
            CurrentLockedEnemy = nil
            print("[OmegaCore] Level 60 atingido! Farm da Pirate Village concluído.")
            break
        end

        local targetName = getCurrentTargetName(currentLevel)
        local targetEnemy = findEnemy(targetName)

        if targetEnemy then
            equipWeapon()
            local initialPos = getSafeAboveCFrame(targetEnemy)
            if initialPos then
                safeMoveTo(initialPos)
            end

            CurrentLockedEnemy = targetEnemy

            while targetEnemy and targetEnemy.Parent and targetEnemy:FindFirstChild("Humanoid") and targetEnemy.Humanoid.Health > 0 and _G_PirateFarm do
                currentLevel = levelObj and levelObj.Value or currentLevel
                if currentLevel >= MaxTargetLevel then
                    _G_PirateFarm = false
                    break
                end

                local updatedTarget = getCurrentTargetName(currentLevel)
                if updatedTarget ~= targetName then
                    break
                end

                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local safeCFrame = getSafeAboveCFrame(targetEnemy)
                if hrp and safeCFrame then
                    hrp.CFrame = safeCFrame
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    aimAtEnemy(targetEnemy)
                end

                equipWeapon()
                basicAttack()
                task.wait(0.1)
            end

            CurrentLockedEnemy = nil
        else
            CurrentLockedEnemy = nil
            local spawnCFrame = SpawnPoints[targetName]
            if spawnCFrame then
                safeMoveTo(spawnCFrame + Vector3.new(0, FarmHeight + 3, 0))
            end
            task.wait(0.5)
        end

        task.wait(0.1)
    end
end)
