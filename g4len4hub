-- OmegaCore | Módulo: Deslocamento Seguro para Ilha Jungle (Corrigido)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local JungleCFrame = CFrame.new(-1612.8, 36.9, 149.2)
local TweenSpeed = 185 -- Velocidade segura para evitar rollback do servidor

local function teleportToJungle()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:WaitForChild("Humanoid")

    if not hrp or not humanoid then return end

    local isMoving = true

    -- Trava a física do personagem para evitar estado de natação/queda
    humanoid.PlatformStand = true

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "OmegaCoreStabilizer"
    bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = hrp

    -- Noclip contínuo durante o trajeto
    local stepConnection
    stepConnection = RunService.Stepped:Connect(function()
        if not isMoving or not char or not char.Parent then
            if stepConnection then stepConnection:Disconnect() end
            return
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    -- Sobe levemente antes de iniciar o trajeto para evitar colisão com o terreno inicial
    hrp.CFrame = hrp.CFrame + Vector3.new(0, 15, 0)

    local distance = (hrp.Position - JungleCFrame.Position).Magnitude
    local duration = distance / TweenSpeed

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = JungleCFrame})

    tween:Play()
    tween.Completed:Wait()

    -- Restaura física e colisões ao chegar
    isMoving = false
    if stepConnection then stepConnection:Disconnect() end
    if bodyVel then bodyVel:Destroy() end

    humanoid.PlatformStand = false
    hrp.CFrame = JungleCFrame
    hrp.AssemblyLinearVelocity = Vector3.zero
end

teleportToJungle()
