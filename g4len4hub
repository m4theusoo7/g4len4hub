print("=== INICIANDO VARREDURA DE BANDITS E NPCS ===")

-- 1. Varre os inimigos (Enemies)
if workspace:FindFirstChild("Enemies") then
    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        if string.find(enemy.Name, "Bandit") then
            local hrp = enemy:FindFirstChild("HumanoidRootPart")
            local hum = enemy:FindFirstChild("Humanoid")
            if hrp then
                print(string.find(enemy.Name, "Bandit") and "[MOB ACHADO] " or "", enemy.Name, "| HP:", hum and hum.Health or "N/A", "| Pos:", hrp.Position)
            end
        end
    end
else
    print("[AVISO] Pasta workspace.Enemies não encontrada!")
end

-- 2. Varre os NPCs da Starter Island (Quest Giver)
if workspace:FindFirstChild("NPCs") then
    for _, npc in ipairs(workspace.NPCs:GetChildren()) do
        if string.find(npc.Name, "Quest") or string.find(npc.Name, "Bandit") or npc.Name == "Adventurer" then
            local hrp = npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                print("[NPC ACHADO] Nome:", npc.Name, "| Pos:", hrp.Position)
            end
        end
    end
else
    print("[AVISO] Pasta workspace.NPCs não encontrada!")
end

print("=== VARREDURA CONCLUÍDA ===")
