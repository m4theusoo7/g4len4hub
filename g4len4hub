local function GetUnderwaterCityTaskForLevel()
    local level = GetLevel()
    local tasks = GetAllUnderwaterTasks()

    if level >= 425 and IsBossAvailable("Fishman Lord") then
        return tasks.FishmanLord
    elseif level >= 400 then
        return tasks.FishmanCommando
    else
        return tasks.FishmanWarrior
    end
end

local function SetPhysicsState(character, enabled)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")

    if hum and enabled then
        hum.Sit = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("FarmBodyVelocity")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "FarmBodyVelocity"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

NoClipConnection = RunService.Stepped:Connect(function()
    if not _G.AutoFarmUnderwaterCity then
        if NoClipConnection then
            NoClipConnection:Disconnect()
            NoClipConnection = nil
        end
        return
    end

    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
