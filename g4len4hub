local function TweenToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3.5 then
        CancelTween()
        if snapAtEnd then
            hrp.CFrame = targetCFrame
        end
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

local function UseExitPortal(hrp, portalPart, fallbackPos)
    local targetPos = (portalPart and portalPart.Position) or fallbackPos
    local dist = (hrp.Position - targetPos).Magnitude

    if dist > 14 then
        TweenToCFrame(CFrame.new(targetPos + Vector3.new(0, 2, 0)), false)
        return
    end

    CancelTween()
    local t = os.clock()
    local offset = Vector3.new(math.cos(t * 6) * 2.5, math.sin(t * 8) * 2, math.sin(t * 6) * 2.5)
    hrp.CFrame = CFrame.new(targetPos + offset)
    hrp.AssemblyLinearVelocity = Vector3.zero

    if (t - LastPortalTouch) >= 0.3 then
        LastPortalTouch = t
        if portalPart and firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, portalPart, 0)
                task.wait(0.03)
                firetouchinterest(hrp, portalPart, 1)
            end)
        end
    end
end

local function MoveToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local map = workspace:FindFirstChild("Map")

    -- Sai de Upper Yard se o jogador iniciar o script la em cima
    if hrp.Position.Y > 4000 then
        local skyArea2 = map and map:FindFirstChild("SkyArea2")
        local exitPart = skyArea2 and skyArea2:FindFirstChild("Exit")
        UseExitPortal(hrp, exitPart, Config.SkyArea2ExitPos)
        return
    end

    -- Sai de Underwater City se o jogador iniciar o script la dentro
    if hrp.Position.X > 50000 then
        local tpSpawn = map and map:FindFirstChild("TeleportSpawn")
        local exitPart = tpSpawn and tpSpawn:FindFirstChild("Exit")
        UseExitPortal(hrp, exitPart, Config.UnderwaterExitPos)
        return
    end

    TweenToCFrame(targetCFrame, snapAtEnd)
end

-- Consulta o estado oficial da quest do Sea 2 no servidor
local function GetQuestProgress()
    local state = {
        UsedKey = LocalDoorOpened,
        KilledIceAdmiral = LocalAdmiralKilled,
        TalkedDetective = LocalDetectiveReported
    }

    if not CommF then return state end

    local ok, res = pcall(function()
        return CommF:InvokeServer("DressrosaQuestProgress")
    end)

    if ok and type(res) == "table" then
        if res.UsedKey then
            state.UsedKey = true
            LocalDoorOpened = true
        end
        if res.KilledIceAdmiral then
            state.KilledIceAdmiral = true
            LocalAdmiralKilled = true
        end
        if res.TalkedDetective and state.KilledIceAdmiral then
            state.TalkedDetective = true
            LocalDetectiveReported = true
        end
    end

    return state
end

