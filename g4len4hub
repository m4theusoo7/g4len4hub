-- ==========================================
-- AUTO BUY: WATER KUNG FU (SEA 1 - CORRIGIDO V3)
-- ==========================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas exatas da Underwater City (Sea 1)
local WHIRLPOOL_POS = Vector3.new(3864.68, 5.37, -1926.21)       -- Centro do redemoinho na superfície
local UNDERWATER_ENTRANCE = Vector3.new(61163.8515625, 11.6796875, 1819.7841796875) -- Vetor exato do requestEntrance
local TEACHER_FALLBACK_CF = CFrame.new(61350.60, 31.40, 1113.50) -- Sala secreta ao lado do Fishman Lord
local TWEEN_SPEED = 200

local noclipConn
local function setNoClip(state)
    if state then
        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return true
    end

    setNoClip(true)
    local duration = distance / TWEEN_SPEED
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    
    tween:Play()
    tween.Completed:Wait()
    setNoClip(false)
    return true
end

-- Varre o Workspace num raio de 400 studs para achar qualquer TouchTransmitter do redemoinho
local function triggerWhirlpoolTouch(hrp)
    local found = false
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Position - WHIRLPOOL_POS).Magnitude < 400 then
            if obj:FindFirstChildOfClass("TouchTransmitter") then
                found = true
                if firetouchinterest then
                    firetouchinterest(hrp, obj, 0)
                    task.wait(0.05)
                    firetouchinterest(hrp, obj, 1)
                end
            end
        end
    end
    return found
end

-- Busca o CFrame real do NPC dentro da Underwater City
local function getTeacherCFrame()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        local teacher = npcs:FindFirstChild("Water Kung Fu Teacher")
        if teacher and teacher:FindFirstChild("HumanoidRootPart") then
            return teacher.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
    return TEACHER_FALLBACK_CF
end

local function buyWaterKungFu()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 1. Verifica se já possui o estilo
    local hasStyle = LocalPlayer.Backpack:FindFirstChild("Water Kung Fu") or char:FindFirstChild("Water Kung Fu")
    if hasStyle then
        warn("[OmegaCore] Você já possui o Water Kung Fu!")
        return
    end

    -- 2. Verifica saldo em Beli
    local beli = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Beli")
    if beli and beli.Value < 750000 then
        warn("[OmegaCore] Beli insuficiente! Necessário: $750.000 | Atual: $" .. tostring(beli.Value))
        return
    end

    -- 3. Entra na Underwater City caso esteja na superfície (X < 50000)
    if hrp.Position.X < 50000 then
        print("[OmegaCore] Indo até o centro do redemoinho...")
        tweenTo(CFrame.new(WHIRLPOOL_POS))
        
        -- Aguarda o mapa carregar (StreamingEnabled) e mantém o boneco na posição do portal
        for attempt = 1, 5 do
            hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not hrp or hrp.Position.X > 50000 then break end

            hrp.CFrame = CFrame.new(WHIRLPOOL_POS)
            local touched = triggerWhirlpoolTouch(hrp)
            if touched then
                print("[OmegaCore] Hitbox do redemoinho acionada (tentativa " .. attempt .. ")...")
            end

            -- Chama o requestEntrance com o Vector3 preciso
            CommF:InvokeServer("requestEntrance", UNDERWATER_ENTRANCE)
            task.wait(0.8)
        end
    end

    -- 4. Confirma que entrou na Underwater City
    hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or hrp.Position.X < 50000 then
        warn("[OmegaCore] Falha ao entrar na Underwater City. O servidor não aceitou o teleporte.")
        return
    end

    -- 5. Localiza o Water Kung Fu Teacher na cidade, vai até ele e compra
    print("[OmegaCore] Dentro da Underwater City! Indo até o Water Kung Fu Teacher...")
    task.wait(0.5) -- Aguarda os NPCs carregarem
    local targetTeacherCF = getTeacherCFrame()

    if tweenTo(targetTeacherCF) then
        task.wait(0.3)
        local result = CommF:InvokeServer("BuyWaterKungFu")
        print("[OmegaCore] Resposta do servidor:", tostring(result))
    end
end

buyWaterKungFu()
