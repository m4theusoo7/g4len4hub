_G.OmegaCore_BuyAbilities = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    AbilityTeacherPos = Vector3.new(1347.70, 37.30, -1325.00),
    TweenSpeed = 225
}

local CurrentTween = nil
local LastTweenTarget = nil

-- Barra compacta de status na tela
local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaAbilitiesUI") then
    parentGui.OmegaAbilitiesUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaAbilitiesUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 52)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Ability Teacher] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Ability Teacher] " .. msg
    if color then
        StatusBox.TextColor3 = color
    end
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaAbilityBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaAbilityBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = not enabled
        end
    end
end

local function tweenTo(hrp, targetPos)
    local dist = (hrp.Position - targetPos).Magnitude
    if dist <= 5 then
        cancelTween()
        return true
    end
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetPos).Magnitude <= 4 then
        return false
    end
    cancelTween()
    LastTweenTarget = targetPos
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.1), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    CurrentTween:Play()
    return false
end

local function findAbilityTeacher()
    local npcs = workspace:FindFirstChild("NPCs")
    if not npcs then return nil end

    local exact = npcs:FindFirstChild("Ability Teacher")
    if exact and exact:FindFirstChild("HumanoidRootPart") then
        return exact.HumanoidRootPart.Position
    end

    for _, npc in ipairs(npcs:GetChildren()) do
        local low = string.lower(npc.Name)
        if (string.find(low, "ability", 1, true) or string.find(low, "teacher", 1, true)) and npc:FindFirstChild("HumanoidRootPart") then
            return npc.HumanoidRootPart.Position
        end
    end

    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaCore_BuyAbilities then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    local data = LocalPlayer:FindFirstChild("Data")
    local beli = data and data:FindFirstChild("Beli") and data.Beli.Value or 0
    if beli < 135000 then
        setStatus("Aviso: Beli atual ($" .. beli .. ") menor que $135.000. Comprando o que der...", Color3.fromRGB(255, 200, 80))
        task.wait(1.5)
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    setPhysics(char, true)

    -- 1. Voa ate o Ability Teacher em Frozen Village
    local targetPos = findAbilityTeacher() or Config.AbilityTeacherPos
    while _G.OmegaCore_BuyAbilities and not tweenTo(hrp, targetPos + Vector3.new(0, 2, 4)) do
        setStatus("Indo ate o Ability Teacher em Frozen Village...", Color3.fromRGB(255, 215, 90))
        local updatedNpcPos = findAbilityTeacher()
        if updatedNpcPos then
            targetPos = updatedNpcPos
        end
        RunService.Heartbeat:Wait()
    end

    -- 2. Compra as 3 habilidades via Remote oficial
    local abilities = {
        { id = "Geppo", label = "Air Jump ($10.000)" },
        { id = "Buso", label = "Aura / Haki ($25.000)" },
        { id = "Soru", label = "Flash Step ($100.000)" }
    }

    if CommF then
        for _, ab in ipairs(abilities) do
            setStatus("Comprando " .. ab.label .. "...", Color3.fromRGB(120, 200, 255))
            pcall(function()
                CommF:InvokeServer("BuyHaki", ab.id)
            end)
            task.wait(0.45)
        end

        -- 3. Ativa a Aura (Buso Haki) automaticamente
        if not char:FindFirstChild("HasBuso") then
            pcall(function()
                CommF:InvokeServer("Buso")
            end)
            task.wait(0.3)
        end
    end

    local auraAtiva = char:FindFirstChild("HasBuso") ~= nil
    if auraAtiva then
        setStatus("CONCLUIDO! Air Jump, Aura (ATIVA) e Flash Step comprados! Pode rodar a Missao 3.", Color3.fromRGB(120, 255, 160))
    else
        setStatus("CONCLUIDO! Compras enviadas (Air Jump, Aura, Flash Step). Ative a Aura (J) e rode a Missao 3!", Color3.fromRGB(120, 255, 160))
    end

    _G.OmegaCore_BuyAbilities = false
    if noclipConn then noclipConn:Disconnect() end
    cancelTween()
    setPhysics(LocalPlayer.Character, false)
end)
