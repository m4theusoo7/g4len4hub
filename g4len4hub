_G.AutoFarmBandit = true

local Config = {
    TargetMob = "Bandit",
    TweenSpeed = 200,
    DistanceFarm = 8, -- Alcance ideal para o Combat acertar sem tomar dano
    BringMobRadius = 250,
    AttackDelay = 0.08
}

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local CurrentTween = nil
local LastTweenTargetPos = nil

-- Remotes nativos de ataque do Blox Fruits
local NetFolder = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
local RegisterAttack = NetFolder and NetFolder:FindFirstChild("RE/RegisterAttack")
local RegisterHit = NetFolder and NetFolder:FindFirstChild("RE/RegisterHit")

-- Mantém o personagem estável no ar e sem colisão durante o farm
local function SetPhysicsState(character, state)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")

    if hrp then
        local bv = hrp:FindFirstChild("FarmBodyVelocity")
        if state then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "FarmBodyVelocity"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

-- Equipa estilo de luta (Combat/Melee) ou espada
local function EquipWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not backpack or not hum then return nil end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return nil
end

-- Localiza o Bandit vivo mais próximo
local function GetClosestBandit()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    local closestMob = nil
    local shortestDist = math.huge

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == Config.TargetMob then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                local dist = (hrp.Position - mobHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

-- Agrupa os Bandits sem colisão entre membros (impede que subam para o céu)
local function BringMobs(anchorMob)
    local enemies = workspace:FindFirstChild("Enemies")
    local anchorHrp = anchorMob and anchorMob:FindFirstChild("HumanoidRootPart")
    if not enemies or not anchorHrp then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local anchorCFrame = anchorHrp.CFrame
    anchorHrp.AssemblyLinearVelocity = Vector3.zero

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == Config.TargetMob then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                local dist = (mobHrp.Position - anchorCFrame.Position).Magnitude
                if dist <= Config.BringMobRadius then
                    -- Remove colisão de todas as partes do NPC para não empurrar para cima
                    for _, part in ipairs(mob:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if mob ~= anchorMob then
                        mobHrp.CFrame = anchorCFrame
                    end

                    mobHrp.AssemblyLinearVelocity = Vector3.zero
                    mobHrp.AssemblyAngularVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

-- Coleta os Bandits no alcance do golpe para registrar o dano
local function GetTargetsInRange(maxRange)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    local targets = {}
    if not hrp or not enemies then return targets end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob.Name == Config.TargetMob then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                if (hrp.Position - mobHrp.Position).Magnitude <= maxRange then
                    table.insert(targets, { mob, mobHrp })
                end
            end
        end
    end

    return targets
end

-- Deslocamento com Tween 200
local function MoveToTarget(targetCFrame)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3 then
        if CurrentTween then
            CurrentTween:Cancel()
            CurrentTween = nil
        end
        LastTweenTargetPos = nil
        hrp.CFrame = targetCFrame
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

-- Thread do Fast Attack (animação + registro de hit no servidor)
task.spawn(function()
    while _G.AutoFarmBandit do
        local character = LocalPlayer.Character
        local hum = character and character:FindFirstChildOfClass("Humanoid")

        if character and hum and hum.Health > 0 then
            local tool = EquipWeapon()
            local targets = GetTargetsInRange(25)

            if tool and #targets > 0 then
                pcall(function()
                    -- Simula o toque/clique real (funciona no Mobile e PC)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    tool:Activate()

                    -- Registra o hit diretamente nos Bandits agrupados
                    if RegisterAttack and RegisterHit then
                        RegisterAttack:FireServer(0)
                        RegisterHit:FireServer(targets[1][2], targets)
                    end
                end)
            end
        end

        task.wait(Config.AttackDelay)
    end
end)

-- Loop principal
task.spawn(function()
    while _G.AutoFarmBandit do
        local character = LocalPlayer.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local hum = character and character:FindFirstChildOfClass("Humanoid")

        if character and hum and hum.Health > 0 then
            SetPhysicsState(character, true)
            local targetMob = GetClosestBandit()

            if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                local mobHrp = targetMob.HumanoidRootPart
                local farmPos = mobHrp.Position + Vector3.new(0, Config.DistanceFarm, 0)
                local farmCFrame = CFrame.new(farmPos) * CFrame.Angles(math.rad(-90), 0, 0)

                MoveToTarget(farmCFrame)

                if (hrp.Position - mobHrp.Position).Magnitude <= 65 then
                    BringMobs(targetMob)
                end
            end
        else
            if CurrentTween then
                CurrentTween:Cancel()
                CurrentTween = nil
            end
            LastTweenTargetPos = nil
        end

        RunService.Heartbeat:Wait()
    end

    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    SetPhysicsState(LocalPlayer.Character, false)
end)
