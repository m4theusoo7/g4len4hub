_G.OmegaSea2_Missao3_AutoSkill = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    IceAdmiralPos = Vector3.new(1347.70, 37.30, -1385.00),
    TweenSpeed = 240,
    AttackHeight = 11.5,
    AttackRadius = 7.5,
    SafeHeight = 55.0,
    RetreatAtRatio = 0.45,
    ResumeAtRatio = 0.75,
    SkillCooldown = 0.85
}

local CurrentTween = nil
local LastTweenTarget = nil
local LastSkillClock = 0
local SkillIdx = 1
local TouchCounter = 500
local IsRetreating = false
local AutoSkills = {
    { key = Enum.KeyCode.Z, label = "Z", hold = 0.20 },
    { key = Enum.KeyCode.X, label = "X", hold = 0.10 },
    { key = Enum.KeyCode.C, label = "C", hold = 0.10 }
}

local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaSea2AutoSkillUI") then
    parentGui.OmegaSea2AutoSkillUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaSea2AutoSkillUI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 54)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Auto Skill] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = "[Auto Skill] " .. msg
    if color then StatusBox.TextColor3 = color end
end

local function ensureAura()
    local char = LocalPlayer.Character
    if not char then return end
    if not char:FindFirstChild("HasBuso") and CommF then
        pcall(function() CommF:InvokeServer("Buso") end)
    end
end

local function equipMelee()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not bp or not hum then return nil end

    local eq = char:FindFirstChildOfClass("Tool")
    if eq and (eq.ToolTip == "Melee" or eq.Name == "Combat") then
        return eq
    end
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end
    return eq
end

local function autoCastSkill(skillInfo)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, skillInfo.key, false, game)
    end)

    local cam = workspace.CurrentCamera
    local tx = cam and (cam.ViewportSize.X * 0.82) or 700
    local ty = cam and (cam.ViewportSize.Y * 0.72) or 450
    TouchCounter += 1
    local tid = TouchCounter

    pcall(function()
        VirtualInputManager:SendTouchEvent(tid, Enum.UserInputState.Begin.Value, tx, ty)
    end)

    task.wait(skillInfo.hold)

    pcall(function()
        VirtualInputManager:SendTouchEvent(tid, Enum.UserInputState.End.Value, tx, ty)
        VirtualInputManager:SendKeyEvent(false, skillInfo.key, false, game)
    end)
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(char, enabled)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaAutoSkillBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaAutoSkillBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = not enabled
        end
    end
end

local function moveToPos(hrp, targetPos)
    local dist = (hrp.Position - targetPos).Magnitude
    if dist <= 4 then
        cancelTween()
        return true
    end
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetPos).Magnitude <= 4 then
        return false
    end
    cancelTween()
    LastTweenTarget = targetPos
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.08), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    CurrentTween:Play()
    return false
end

local function getBoss()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        local low = string.lower(mob.Name)
        if string.find(low, "ice admiral", 1, true) or string.find(low, "almirante de gelo", 1, true) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_Missao3_AutoSkill then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    local activeSkillLabel = "-"
    while _G.OmegaSea2_Missao3_AutoSkill do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            IsRetreating = false
            cancelTween()
            task.wait(0.8)
        else
            setPhysics(char, true)
            ensureAura()

            local boss = getBoss()
            if boss and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChildOfClass("Humanoid") then
                local bHrp = boss.HumanoidRootPart
                local bHum = boss:FindFirstChildOfClass("Humanoid")

                local hpRatio = hum.Health / math.max(hum.MaxHealth, 1)
                if hpRatio <= Config.RetreatAtRatio then
                    IsRetreating = true
                elseif hpRatio >= Config.ResumeAtRatio then
                    IsRetreating = false
                end

                if IsRetreating then
                    local safePos = bHrp.Position + Vector3.new(0, Config.SafeHeight, 0)
                    moveToPos(hrp, safePos)
                    setStatus(
                        string.format("Escudo alto (%d/%d) | Boss: %d/%d",
                            math.floor(hum.Health), math.floor(hum.MaxHealth),
                            math.floor(bHum.Health), math.floor(bHum.MaxHealth)),
                        Color3.fromRGB(255, 210, 90)
                    )
                else
                    local angle = os.clock() * 1.4
                    local orbitOffset = Vector3.new(
                        math.cos(angle) * Config.AttackRadius,
                        Config.AttackHeight,
                        math.sin(angle) * Config.AttackRadius
                    )
                    local targetPos = bHrp.Position + orbitOffset
                    local near = moveToPos(hrp, targetPos)

                    if near or (hrp.Position - bHrp.Position).Magnitude <= 18 then
                        hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(bHrp.Position.X, hrp.Position.Y, bHrp.Position.Z))
                        local tool = equipMelee()
                        if tool then
                            pcall(function() tool:Activate() end)
                        end

                        if (os.clock() - LastSkillClock) >= Config.SkillCooldown then
                            LastSkillClock = os.clock()
                            local chosen = AutoSkills[SkillIdx]
                            SkillIdx = (SkillIdx % #AutoSkills) + 1
                            activeSkillLabel = chosen.label
                            autoCastSkill(chosen)
                        end

                        setStatus(
                            string.format("Boss: %d/%d | Vida: %d/%d | Skill: [%s]",
                                math.floor(bHum.Health), math.floor(bHum.MaxHealth),
                                math.floor(hum.Health), math.floor(hum.MaxHealth),
                                activeSkillLabel),
                            Color3.fromRGB(120, 200, 255)
                        )
                    end
                end
            else
                if CommF then
                    local ok, prog = pcall(function() return CommF:InvokeServer("DressrosaQuestProgress") end)
                    if ok and type(prog) == "table" and prog.KilledIceAdmiral then
                        cancelTween()
                        setStatus("SUCESSO! Almirante de Gelo derrotado! Avise para a Parte 4!", Color3.fromRGB(120, 255, 160))
                        break
                    end
                end

                local waitPos = Config.IceAdmiralPos + Vector3.new(0, 14, 0)
                if not moveToPos(hrp, waitPos) then
                    setStatus("Indo ate o Almirante de Gelo...", Color3.fromRGB(255, 215, 90))
                else
                    setStatus("Aguardando respawn do Almirante de Gelo...", Color3.fromRGB(255, 215, 90))
                end
            end

            RunService.Heartbeat:Wait()
        end
    end

    _G.OmegaSea2_Missao3_AutoSkill = false
    if noclipConn then noclipConn:Disconnect() end
    cancelTween()
    setPhysics(LocalPlayer.Character, false)
end)
