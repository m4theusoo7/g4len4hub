local function HasAnyActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    local questGui = main and main:FindFirstChild("Quest")
    return questGui and questGui.Visible or false
end

local function CheckGuiQuestProgress(taskInfo)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    if not main or not taskInfo then return "Unknown", taskInfo.DefaultRequiredKills end

    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local isDialogue = false
            local parent = obj.Parent
            while parent and parent ~= main do
                local pName = string.lower(parent.Name)
                if string.find(pName, "dialogue") or string.find(pName, "questc") then
                    isDialogue = true
                    break
                end
                parent = parent.Parent
            end

            if not isDialogue then
                local txt = string.lower((obj.Text or "") .. " " .. (obj.ContentText or ""))
                local matchesMob = false

                if taskInfo.SpawnPrefix == "Galley Pirate" then
                    matchesMob = string.find(txt, "galley") ~= nil and (string.find(txt, "pirate") ~= nil or string.find(txt, "pirata") ~= nil)
                elseif taskInfo.SpawnPrefix == "Galley Captain" then
                    matchesMob = string.find(txt, "galley") ~= nil and (string.find(txt, "captain") ~= nil or string.find(txt, "capit") ~= nil)
                elseif taskInfo.SpawnPrefix == "Cyborg" then
                    matchesMob = string.find(txt, "cyborg") ~= nil or string.find(txt, "ciborgue") ~= nil
                end

                if matchesMob then
                    local curStr, reqStr = string.match(txt, "(%d+)%s*/%s*(%d+)")
                    local cur = tonumber(curStr)
                    local req = tonumber(reqStr) or taskInfo.DefaultRequiredKills
                    if cur and req then
                        if cur >= req then
                            return "Completed", req
                        else
                            return "Active", req
                        end
                    end
                end
            end
        end
    end

    return "Unknown", taskInfo.DefaultRequiredKills
end

local function GetQuestNpcPos()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        local npc = npcs:FindFirstChild("Freezeburg Quest Giver") or npcs:FindFirstChild("Freestep Quest Giver")
        if npc and npc:FindFirstChild("HumanoidRootPart") then
            return npc.HumanoidRootPart.Position + Vector3.new(0, 2, 3.5), true
        end

        for _, obj in ipairs(npcs:GetChildren()) do
            if obj:FindFirstChild("HumanoidRootPart") then
                local pos = obj.HumanoidRootPart.Position
                if (pos - Config.QuestNpcPos).Magnitude <= 80 then
                    return pos + Vector3.new(0, 2, 3.5), true
                end
            end
        end
    end

    return Config.QuestNpcPos + Vector3.new(0, 2, 3.5), false
end

local function GetMobWaitPos(taskInfo)
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        local sum = Vector3.zero
        local count = 0
        for _, spawnPart in ipairs(enemySpawns:GetChildren()) do
            if spawnPart:IsA("BasePart") and string.find(spawnPart.Name, taskInfo.SpawnPrefix, 1, true) then
                if IsInFountainArea(spawnPart.Position) then
                    sum += spawnPart.Position
                    count += 1
                end
            end
        end
        if count > 0 then
            return (sum / count) + Vector3.new(0, 14, 0)
        end
    end

    return taskInfo.WaitPos
end

local function EquipWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not backpack or not hum then return nil end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return nil
end

local function UpdateKillCounter(taskInfo)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) and not CountedDeadMobs[mob] then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mobHum and mobHum.Health <= 0 then
                CountedDeadMobs[mob] = true
                if QuestInProgress then
                    MobsKilledInQuest += 1
                end
            end
        end
    end
end

local function GetClosestTargetMob(taskInfo)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    local closestMob = nil
    local shortestDist = 2500

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsInFountainArea(mobHrp.Position) then
                local dist = (hrp.Position - mobHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

local function BringMobs(anchorMob, taskInfo)
    local enemies = workspace:FindFirstChild("Enemies")
    local anchorHrp = anchorMob and anchorMob:FindFirstChild("HumanoidRootPart")
    if not enemies or not anchorHrp then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local anchorCFrame = anchorHrp.CFrame
    anchorHrp.AssemblyLinearVelocity = Vector3.zero

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsInFountainArea(mobHrp.Position) then
                local dist = (mobHrp.Position - anchorCFrame.Position).Magnitude
                local heightDiff = math.abs(mobHrp.Position.Y - anchorCFrame.Position.Y)
                if dist <= Config.BringMobRadius and heightDiff <= 60 then
                    for _, part in ipairs(mob:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if mob ~= anchorMob then
                        mobHrp.CFrame = anchorCFrame
                    end

                    mobHrp.AssemblyLinearVelocity = Vector3.zero
                    mobHrp.AssemblyAngularVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

local function GetTargetsInRange(taskInfo, maxRange)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    local targets = {}
    if not hrp or not enemies or not taskInfo then return targets end

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                if (hrp.Position - mobHrp.Position).Magnitude <= maxRange then
                    table.insert(targets, { mob, mobHrp })
                end
            end
        end
    end

    return targets
end

local function TweenToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3.5 then
        CancelTween()
        if snapAtEnd then
            hrp.CFrame = targetCFrame
        end
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

local function UseExitPortal(hrp, portalPart, fallbackPos)
    local targetPos = (portalPart and portalPart.Position) or fallbackPos
    local dist = (hrp.Position - targetPos).Magnitude

    if dist > 14 then
        TweenToCFrame(CFrame.new(targetPos + Vector3.new(0, 2, 0)), false)
        return
    end

    CancelTween()
    local t = os.clock()
    local offset = Vector3.new(math.cos(t * 6) * 2.5, math.sin(t * 8) * 2, math.sin(t * 6) * 2.5)
    hrp.CFrame = CFrame.new(targetPos + offset)
    hrp.AssemblyLinearVelocity = Vector3.zero

    if (t - LastPortalTouch) >= 0.3 then
        LastPortalTouch = t
        if portalPart and firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, portalPart, 0)
                task.wait(0.03)
                firetouchinterest(hrp, portalPart, 1)
            end)
        end
    end
end

local function MoveToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local map = workspace:FindFirstChild("Map")

    -- Se ainda estiver em Upper Yard (Y > 4000), desce pelo portal SkyArea2.Exit antes de voar ate Fountain City
    if hrp.Position.Y > 4000 then
        local skyArea2 = map and map:FindFirstChild("SkyArea2")
        local exitPart = skyArea2 and skyArea2:FindFirstChild("Exit")
        UseExitPortal(hrp, exitPart, Config.SkyArea2ExitPos)
        return
    end

    -- Se estiver em Underwater City (X > 50000), sai pelo TeleportSpawn.Exit
    if hrp.Position.X > 50000 then
        local tpSpawn = map and map:FindFirstChild("TeleportSpawn")
        local exitPart = tpSpawn and tpSpawn:FindFirstChild("Exit")
        UseExitPortal(hrp, exitPart, Config.UnderwaterExitPos)
        return
    end

    TweenToCFrame(targetCFrame, snapAtEnd)
end

