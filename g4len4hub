-- Movimentação suave com Tween 200 sem engasgar ou reiniciar a cada passo do mob
local function TweenTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    -- Curta distância: posiciona direto sem criar micro-tweens
    if distance <= 25 then
        CancelTween()
        hrp.CFrame = targetCFrame
        return
    end

    -- Se já existe um Tween indo para o mesmo destino, mantém o voo contínuo
    if CurrentTween and CurrentTweenGoal and (CurrentTweenGoal - targetCFrame.Position).Magnitude <= 15 then
        return
    end

    CancelTween()
    CurrentTweenGoal = targetCFrame.Position

    local duration = distance / Settings.TweenSpeed
    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, info, { CFrame = targetCFrame })
    CurrentTween:Play()
end

-- Equipa estilo de luta / Combat automaticamente
local function EquipMelee()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return nil end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(tool)
                return tool
            end
        end
    end
    return equipped
end

-- Bring Mob: puxa todos os Bandits próximos para o mesmo ponto no chão
local function BringBandits(mainTarget)
    if not Settings.BringMob or not mainTarget then return end
    local mainHRP = mainTarget:FindFirstChild("HumanoidRootPart")
    if not mainHRP then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local safeY = math.max(mainHRP.Position.Y, 16.5)
    local anchorCF = CFrame.new(mainHRP.Position.X, safeY, mainHRP.Position.Z)

    mainHRP.CFrame = anchorCF
    mainHRP.CanCollide = false
    mainHRP.AssemblyLinearVelocity = Vector3.zero

    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if mob ~= mainTarget and string.find(mob.Name, Settings.MobName) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                if (mobHRP.Position - anchorCF.Position).Magnitude <= Settings.BringRadius then
                    mobHRP.CFrame = anchorCF
                    mobHRP.CanCollide = false
                    mobHRP.AssemblyLinearVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

-- Retorna o Bandit vivo mais próximo e a lista de alvos no alcance do Fast Attack
local function GetBanditTargets()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil, {} end

    local closestMob = nil
    local shortestDist = math.huge
    local bladeHits = {}

    for _, mob in ipairs(enemies:GetChildren()) do
        if string.find(mob.Name, Settings.MobName) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            local head = mob:FindFirstChild("Head")
            if hum and hum.Health > 0 and mobHRP and head and mobHRP.Position.Y > 5 then
                local dist = (hrp.Position - mobHRP.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
                if dist <= 60 then
                    table.insert(bladeHits, { mob, head })
                end
            end
        end
    end

    return closestMob, bladeHits
end

