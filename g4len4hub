-- Restaura física normal ao finalizar ou pausar
local function RestaurarPersonagem()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.PlatformStand = false
    end
    if root then
        local bv = root:FindFirstChild("DesertoFarmBV")
        if bv then bv:Destroy() end
        root.CanCollide = true
    end
end

-- Mantém estabilidade aérea e evita queda/rollback
local function AplicarEstabilidade(root, hum)
    if hum then
        hum.PlatformStand = true
    end
    local bv = root:FindFirstChild("DesertoFarmBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "DesertoFarmBV"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = root
    else
        bv.Velocity = Vector3.zero
    end
end

-- Equipa automaticamente estilo de luta (Melee) ou Espada
local function EquiparArma()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return nil end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local equipada = char:FindFirstChildOfClass("Tool")
    if equipada and (equipada.ToolTip == "Melee" or equipada.ToolTip == "Sword") then
        return equipada
    end

    for _, tipo in ipairs({"Melee", "Sword"}) do
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == tipo then
                hum:EquipTool(tool)
                return tool
            end
        end
    end

    -- Fallback caso o ToolTip não esteja definido
    local primeiraTool = backpack:FindFirstChildOfClass("Tool")
    if primeiraTool then
        hum:EquipTool(primeiraTool)
        return primeiraTool
    end

    return equipada
end

-- Deslocamento via Tween para longas distâncias e CFrame direto perto do alvo
local tweenAtual
local function MoverPara(root, destinoCFrame)
    local distancia = (root.Position - destinoCFrame.Position).Magnitude
    if distancia <= 25 then
        if tweenAtual then
            tweenAtual:Cancel()
            tweenAtual = nil
        end
        root.CFrame = destinoCFrame
        return true
    else
        local tempo = math.max(distancia / CONFIG.VelocidadeTween, 0.05)
        if tweenAtual then tweenAtual:Cancel() end
        tweenAtual = TweenService:Create(
            root,
            TweenInfo.new(tempo, Enum.EasingStyle.Linear),
            {CFrame = destinoCFrame}
        )
        tweenAtual:Play()
        return false
    end
end

-- Define alvo e coordenada de espera conforme o Level
local function ObterConfigEstagio(level)
    if level < 70 then
        return "Desert Bandit", CONFIG.PosDesertBandit
    elseif level < 90 then
        return "Desert Officer", CONFIG.PosDesertOfficer
    end
    return nil, nil
end

-- Busca o NPC vivo mais próximo dentro de Workspace.Enemies
local function BuscarInimigoMaisProximo(nomeAlvo, origemPos)
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local maisProximo = nil
    local menorDist = math.huge

    for _, mob in ipairs(enemies:GetChildren()) do
        if string.find(mob.Name, nomeAlvo) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - origemPos).Magnitude
                if dist < menorDist then
                    menorDist = dist
                    maisProximo = mob
                end
            end
        end
    end

    return maisProximo
end

-- Executa ataque básico e dispara uma skill por ciclo sem travar o loop
local indiceSkill = 1
local ultimoDisparoSkill = 0

local function AtacarEUsarSkills(tool, alvoPos)
    -- Mira a câmera para baixo na direção do NPC para acertar skills direcionais
    if Camera then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, alvoPos)
    end

    -- Ataque básico
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
    if tool and tool.Parent == LocalPlayer.Character then
        tool:Activate()
    end

    -- Rotação de skills Z -> X -> C -> V
    if CONFIG.UsarSkills and (tick() - ultimoDisparoSkill) >= CONFIG.IntervaloSkill then
        ultimoDisparoSkill = tick()
        local tecla = CONFIG.TeclasSkills[indiceSkill]

        VirtualInputManager:SendKeyEvent(true, tecla, false, game)
        task.defer(function()
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, tecla, false, game)
        end)

        indiceSkill = (indiceSkill % #CONFIG.TeclasSkills) + 1
    end
end

