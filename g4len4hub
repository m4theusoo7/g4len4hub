task.spawn(function()
    while _G.AutoFarm do
        task.wait()
        
        local level = getLevel()
        
        -- Condição 1: Nível 30+ -> Ir para próxima Ilha (Vila Pirata)
        if level >= 30 then
            print("Level 30 atingido! Indo para as coordenadas da próxima ilha...")
            tweenTo(coords.ProximaIlha)
            _G.AutoFarm = false -- Desliga o farm pois o objetivo da ilha acabou
            break
            
        -- Condição 2: Nível 10 ao 14 -> Farmar Monkeys
        elseif level >= 10 and level <= 14 then
            getQuest("JungleQuest", 1)
            if hasQuest() then
                farmEnemy("Monkey", coords.MonkeySpawn)
            end
            
        -- Condição 3: Nível 15 ao 29 -> Farmar Gorillas (E King no lv 20)
        elseif level >= 15 and level <= 29 then
            -- Se for nível 20+, tenta verificar se o King está vivo e pegar a missão dele
            if level >= 20 then
                local kingAlive = false
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v.Name == "Gorilla King" and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                        kingAlive = true
                        break
                    end
                end
                
                if kingAlive then
                    getQuest("JungleQuest", 3)
                    if hasQuest() then
                        farmEnemy("Gorilla King", coords.GorillaKingSpawn)
                    end
                    continue -- Pula para o próximo ciclo para focar no Boss
                end
            end
            
            -- Se o boss não estiver vivo ou for level 15-19, farma Gorilla normal
            getQuest("JungleQuest", 2)
            if hasQuest() then
                farmEnemy("Gorilla", coords.GorillaSpawn)
            end
        end
    end
end)
