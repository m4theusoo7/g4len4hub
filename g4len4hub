-- ==========================================
-- 🛠️ FUNÇÕES DE ENGENHARIA (BYPASS & CORE)
-- ==========================================

-- 1. Noclip (Evita o boneco travar em paredes durante o voo)
RunService.Stepped:Connect(function()
    if getgenv().OmegaFarm_Enabled and Player.Character then
        for _, part in pairs(Player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- 2. Motor de Movimentação Suave (Tween Bypass)
local function TweenTo(targetCFrame)
    if not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then return end
    
    local root = Player.Character.HumanoidRootPart
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local time = distance / getgenv().TweenSpeed
    
    local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    
    -- Ancorar temporariamente se chegar no mob para não tomar knockback
    if distance < 15 then
        root.CFrame = targetCFrame
        tween:Cancel()
    end
end

-- 3. Identificador de Nível (Qual mob farmar agora?)
local function GetCurrentQuestData()
    local myLevel = Player.Data.Level.Value
    for _, data in ipairs(Sea1_Progression) do
        if myLevel >= data.Min and myLevel <= data.Max then
            return data
        end
    end
    return Sea1_Progression[#Sea1_Progression] -- Retorna o último se passar do level max
end

-- 4. Auto Equipar Arma (Sempre garante que o Melee está na mão)
local function EquipWeapon()
    if not Player.Character then return end
    for _, tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then -- Pode mudar para "Sword" ou "Blox Fruit"
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

-- 5. Função de Ataque (Usa o Click Virtual do Roblox para segurança)
local function AutoAttack()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new())
end

-- ==========================================
-- 🚀 LOOP PRINCIPAL DO OMEGACORE
-- ==========================================

task.spawn(function()
    while task.wait() do
        if not getgenv().OmegaFarm_Enabled then break end
        
        local questData = GetCurrentQuestData()
        local hasQuest = false
        
        -- Verifica na UI se já estamos com uma missão ativa
        if Player.PlayerGui.Main.Quest.Visible then
            hasQuest = true
        end

        if not hasQuest then
            -- 1. Ir até o NPC da Missão
            local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - questData.QuestPos.Position).Magnitude > 5 then
                TweenTo(questData.QuestPos)
            else
                -- 2. Puxar a missão silenciosamente usando o CommF_
                CommF:InvokeServer("StartQuest", questData.QuestName, questData.QuestN)
                task.wait(0.5) -- Pausa rápida para o servidor registrar
            end
        else
            -- 3. Procurar o Mob no Mapa
            local targetMob = nil
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v.Name == questData.MobName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    targetMob = v
                    break
                end
            end

            -- 4. Matar o Mob ou Esperar o Spawn
            if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                EquipWeapon()
                -- Fica acima do mob (CFrame.new(0, FarmDistance, 0)) para não levar hit
                TweenTo(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, getgenv().FarmDistance, 0))
                
                -- Olha pra baixo na direção do mob e ataca
                Player.Character.HumanoidRootPart.CFrame = CFrame.lookAt(
                    Player.Character.HumanoidRootPart.Position, 
                    targetMob.HumanoidRootPart.Position
                )
                AutoAttack()
            else
                -- Se não achou o mob, voa para o ponto de respawn e espera
                TweenTo(questData.MobPos * CFrame.new(0, 20, 0))
            end
        end
    end
end)
