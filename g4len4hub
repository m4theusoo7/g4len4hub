-- Auto Buy Water Kung Fu (Corrigido - Sea 1)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas Sea 1
local WhirlpoolPos = Vector3.new(3864.688, 6.736, -1926.214)
local UnderwaterEntrance = Vector3.new(61163.851, 11.679, 1819.784)
local FallbackTeacherPos = Vector3.new(61273.5, 18.4, 1565.2)

local TweenSpeed = 280
local activeConnection = nil

-- Controle de NoClip + Anti-Gravidade (evita cair na água e evita rubberband)
local function setMovementLock(state)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if state then
        if hum then
            hum.PlatformStand = true
        end
        if not activeConnection then
            activeConnection = RunService.Stepped:Connect(function()
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                if c then
                    for _, part in ipairs(c:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if activeConnection then
            activeConnection:Disconnect()
            activeConnection = nil
        end
        if hum then
            hum.PlatformStand = false
        end
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- Tween estável
local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return
    end

    local duration = distance / TweenSpeed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Checa se está na Underwater City
local function isInsideUnderwater()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position.X > 50000
end

-- Procura o NPC dinamicamente
local function getTeacherCFrame()
    local npcs = workspace:FindFirstChild("NPCs")
    if npcs then
        local teacher = npcs:FindFirstChild("Water Kung Fu Teacher")
        if teacher and teacher:FindFirstChild("HumanoidRootPart") then
            return teacher.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
    return CFrame.new(FallbackTeacherPos)
end

-- Execução
task.spawn(function()
    local beli = LocalPlayer:WaitForChild("Data"):WaitForChild("Beli").Value
    if beli < 750000 then
        warn("[OmegaCore] Beli insuficiente: $" .. tostring(beli) .. " / $750,000")
        return
    end

    setMovementLock(true)

    -- 1. Entrar na Underwater City
    if not isInsideUnderwater() then
        CommF:InvokeServer("requestEntrance", UnderwaterEntrance)
        task.wait(1.5)

        -- Fallback: vai até o redemoinho físico e força o toque/entrada
        if not isInsideUnderwater() then
            tweenTo(CFrame.new(WhirlpoolPos))
            task.wait(0.3)

            -- Tenta disparar TouchInterest se existir no mapa
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and (obj.Position - WhirlpoolPos).Magnitude < 40 and obj:FindFirstChildOfClass("TouchTransmitter") then
                    if firetouchinterest then
                        local hrp = LocalPlayer.Character.HumanoidRootPart
                        firetouchinterest(hrp, obj, 0)
                        task.wait(0.1)
                        firetouchinterest(hrp, obj, 1)
                    end
                end
            end

            CommF:InvokeServer("requestEntrance", UnderwaterEntrance)
            task.wait(1.5)
        end
    end

    -- 2. Aguarda streaming da área interna e vai até o NPC
    if isInsideUnderwater() then
        pcall(function()
            workspace:RequestStreamAroundAsync(FallbackTeacherPos)
        end)
        task.wait(0.8)

        local targetCF = getTeacherCFrame()
        tweenTo(targetCF)
        task.wait(0.4)

        local response = CommF:InvokeServer("BuyFishmanKarate")
        print("[OmegaCore] Status da compra:", response)
    else
        warn("[OmegaCore] Não foi possível entrar na Underwater City.")
    end

    task.wait(0.3)
    setMovementLock(false)
end)
