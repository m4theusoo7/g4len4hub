local function makeBtn(text, posX, posY, sizeW, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(sizeW, -5, 0, 30)
    btn.Position = UDim2.new(posX, 3, 1, posY)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.Parent = Frame
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local isFlying = false
local function flyTo(targetPos, btn, defaultLabel)
    if isFlying then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    isFlying = true
    btn.Text = "VOANDO..."
    local dist = (hrp.Position - targetPos).Magnitude

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local noclip = RunService.Stepped:Connect(function()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)

    local tween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / 240, 0.2), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    tween:Play()
    tween.Completed:Connect(function()
        noclip:Disconnect()
        bv:Destroy()
        isFlying = false
        btn.Text = "OK!"
        task.wait(0.4)
        appendScan()
        task.delay(1.2, function()
            if btn then btn.Text = defaultLabel end
        end)
    end)
end

