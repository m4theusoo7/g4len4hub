    return questGui and questGui.Visible or false
end

local function CheckGuiQuestProgress(taskInfo)
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = playerGui and playerGui:FindFirstChild("Main")
    if not main or not taskInfo then return "Unknown", taskInfo.DefaultRequiredKills end

    for _, obj in ipairs(main:GetDescendants()) do
        if obj:IsA("TextLabel") and obj.Visible then
            local isDialogue = false
            local parent = obj.Parent
            while parent and parent ~= main do
                local pName = string.lower(parent.Name)
                if string.find(pName, "dialogue") or string.find(pName, "questc") then
                    isDialogue = true
                    break
                end
                parent = parent.Parent
            end

            if not isDialogue then
                local txt = string.lower((obj.Text or "") .. " " .. (obj.ContentText or ""))
                local matchesMob = false

                if taskInfo.SpawnPrefix == "God's Guard" then
                    matchesMob = (string.find(txt, "god") or string.find(txt, "deus")) and (string.find(txt, "guard") or string.find(txt, "guarda"))
                elseif taskInfo.SpawnPrefix == "Shanda" then
                    matchesMob = string.find(txt, "shanda") ~= nil
                elseif taskInfo.SpawnPrefix == "Sky Warlord" then
                    matchesMob = string.find(txt, "warlord") ~= nil or string.find(txt, "wysper") ~= nil
                elseif taskInfo.SpawnPrefix == "Royal Squad" then
                    matchesMob = (string.find(txt, "royal") or string.find(txt, "real")) and (string.find(txt, "squad") or string.find(txt, "esquadr"))
                elseif taskInfo.SpawnPrefix == "Royal Soldier" then
                    matchesMob = (string.find(txt, "royal") or string.find(txt, "real")) and (string.find(txt, "soldier") or string.find(txt, "soldado"))
                elseif taskInfo.SpawnPrefix == "Lightning God" then
                    matchesMob = (string.find(txt, "lightning") or string.find(txt, "thunder") or string.find(txt, "trov") or string.find(txt, "rel")) and (string.find(txt, "god") or string.find(txt, "deus"))
                end

                if matchesMob then
                    local curStr, reqStr = string.match(txt, "(%d+)%s*/%s*(%d+)")
                    local cur = tonumber(curStr)
                    local req = tonumber(reqStr) or taskInfo.DefaultRequiredKills
                    if cur and req then
                        if cur >= req then
                            return "Completed", req
                        else
                            return "Active", req
                        end
                    end
                end
            end
        end
    end

    return "Unknown", taskInfo.DefaultRequiredKills
end

local function GetQuestNpcPos(taskInfo)
    local npcs = workspace:FindFirstChild("NPCs")

    if taskInfo.QuestName == "SkyExp1Quest" then
        if npcs then
            for _, npc in ipairs(npcs:GetChildren()) do
                if npc.Name == "Mole" and npc:FindFirstChild("HumanoidRootPart") then
                    local pos = npc.HumanoidRootPart.Position
                    if IsValidMobAltitude(taskInfo.TargetAltitude, pos) then
                        return pos + Vector3.new(0, 2, 3.5), true
                    end
                end
            end
        end

        if taskInfo.TargetAltitude == "Lower" then
            return Config.MoleLowerPos + Vector3.new(0, 2, 3.5), true
        else
            return Config.MoleUpperPos + Vector3.new(0, 2, 3.5), true
        end
    else
        if npcs then
            local preferred = npcs:FindFirstChild("Sky Quest Giver 2") or npcs:FindFirstChild("Sky Adventurer")
            if preferred and preferred:FindFirstChild("HumanoidRootPart") then
                return preferred.HumanoidRootPart.Position + Vector3.new(0, 2, 3.5), true
            end

            for _, npc in ipairs(npcs:GetChildren()) do
                if npc.Name ~= "Mole" and npc:FindFirstChild("HumanoidRootPart") then
                    local pos = npc.HumanoidRootPart.Position
                    local low = string.lower(npc.Name)
                    if pos.Y > 5200 and (string.find(low, "sky") or string.find(low, "quest") or (pos - Config.Sky2StreamPos).Magnitude <= 550) then
                        return pos + Vector3.new(0, 2, 3.5), true
                    end
                end
            end
        end

        return Config.Sky2StreamPos, false
    end
end

local function GetMobWaitPos(taskInfo)
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        local sum = Vector3.zero
        local count = 0
        for _, spawnPart in ipairs(enemySpawns:GetChildren()) do
            if spawnPart:IsA("BasePart") and string.find(spawnPart.Name, taskInfo.SpawnPrefix, 1, true) then
                if IsValidMobAltitude(taskInfo.TargetAltitude, spawnPart.Position) then
                    sum += spawnPart.Position
                    count += 1
                end
            end
        end
        if count > 0 then
            return (sum / count) + Vector3.new(0, 14, 0)
        end
    end

    return taskInfo.WaitPos
end

local function EquipWeapon()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not backpack or not hum then return nil end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.ToolTip == "Sword" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            hum:EquipTool(tool)
            return tool
        end
    end

    return nil
end

local function UpdateKillCounter(taskInfo)
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) and not CountedDeadMobs[mob] then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            if mobHum and mobHum.Health <= 0 then
                CountedDeadMobs[mob] = true
                if QuestInProgress then
                    MobsKilledInQuest += 1
                end
            end
        end
    end
end

local function GetClosestTargetMob(taskInfo)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    if not hrp or not enemies then return nil end

    local closestMob = nil
    local shortestDist = 2500

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsValidMobAltitude(taskInfo.TargetAltitude, mobHrp.Position) then
                local dist = (hrp.Position - mobHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

local function BringMobs(anchorMob, taskInfo)
    local enemies = workspace:FindFirstChild("Enemies")
    local anchorHrp = anchorMob and anchorMob:FindFirstChild("HumanoidRootPart")
    if not enemies or not anchorHrp then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local anchorCFrame = anchorHrp.CFrame
    anchorHrp.AssemblyLinearVelocity = Vector3.zero

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 and IsValidMobAltitude(taskInfo.TargetAltitude, mobHrp.Position) then
                local dist = (mobHrp.Position - anchorCFrame.Position).Magnitude
                local heightDiff = math.abs(mobHrp.Position.Y - anchorCFrame.Position.Y)
                if dist <= Config.BringMobRadius and heightDiff <= 80 then
                    for _, part in ipairs(mob:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if mob ~= anchorMob then
                        mobHrp.CFrame = anchorCFrame
                    end

                    mobHrp.AssemblyLinearVelocity = Vector3.zero
                    mobHrp.AssemblyAngularVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

local function GetTargetsInRange(taskInfo, maxRange)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")
    local targets = {}
    if not hrp or not enemies or not taskInfo then return targets end

    for _, mob in ipairs(enemies:GetChildren()) do
        if MatchesMobName(mob.Name, taskInfo.MobNames) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHrp = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHrp and mobHum.Health > 0 then
                if (hrp.Position - mobHrp.Position).Magnitude <= maxRange then
                    table.insert(targets, { mob, mobHrp })
                end
            end
        end
    end

    return targets
end

local function TweenToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    if distance <= 3.5 then
        CancelTween()
        if snapAtEnd then
            hrp.CFrame = targetCFrame
        end
        return
    end

    local targetMoved = not LastTweenTargetPos or (LastTweenTargetPos - targetCFrame.Position).Magnitude > 4

    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and not targetMoved then
        return
    end

    if CurrentTween then
        CurrentTween:Cancel()
    end

    LastTweenTargetPos = targetCFrame.Position
    local duration = math.max(distance / Config.TweenSpeed, 0.05)
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

-- Verifica se ainda existe barreira de nuvens cobrindo Workspace.Map.Sky.Entrance
local function GetTempleCloudParts(portalPos)
    local clouds = {}
    local map = workspace:FindFirstChild("Map")
    local sky = map and map:FindFirstChild("Sky")
    if not sky then return clouds end

    for _, obj in ipairs(sky:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name ~= "Entrance" then
            local horiz = (Vector3.new(obj.Position.X, 0, obj.Position.Z) - Vector3.new(portalPos.X, 0, portalPos.Z)).Magnitude
            local vert = math.abs(obj.Position.Y - portalPos.Y)
            if horiz <= 30 and vert <= 14 and obj.Transparency < 0.85 then
                table.insert(clouds, obj)
            end
        end
    end
    return clouds
end

local function BreakCloudsAndEnterSky(hrp, portalPart)
    local targetPos = (portalPart and portalPart.Position) or Config.SkyEntrancePos
    local horizDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(targetPos.X, 0, targetPos.Z)).Magnitude
    local vertDist = math.abs(hrp.Position.Y - targetPos.Y)

    -- Aproxima voando 6.5 studs acima do portal para nao ativar "Break the clouds first" antes de atacar
    if horizDist > 12 or vertDist > 20 then
        PortalCycleStart = nil
        BlockPortalTouch = true
        TweenToCFrame(CFrame.new(targetPos + Vector3.new(0, 6.5, 0)), false)
        return
    end

    CancelTween()
    local t = os.clock()
    if not PortalCycleStart then
        PortalCycleStart = t
    end

    local elapsed = t - PortalCycleStart
    if elapsed > 4.2 then
        PortalCycleStart = t
        elapsed = 0
    end

    local cloudParts = GetTempleCloudParts(targetPos)
    local needBreakClouds = (#cloudParts > 0 and elapsed < 2.2) or (elapsed < 1.3)

    if needBreakClouds then
        -- Fase 1: Fica logo acima da camada de nuvens e ataca para baixo para quebra-las
        BlockPortalTouch = true
        local hoverOffset = Vector3.new(math.cos(t * 4) * 3, 6.5, math.sin(t * 4) * 3)
        hrp.CFrame = CFrame.new(targetPos + hoverOffset) * CFrame.Angles(math.rad(-90), 0, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero

        if (t - LastCloudAttack) >= 0.12 then
            LastCloudAttack = t
            local tool = EquipWeapon()
            pcall(function()
                local cam = workspace.CurrentCamera
                local cx = cam and (cam.ViewportSize.X / 2) or 500
                local cy = cam and (cam.ViewportSize.Y / 2) or 300

                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
                if tool then
                    tool:Activate()
                end

                if RegisterAttack and RegisterHit and #cloudParts > 0 then
                    local cloudTargets = {}
                    for _, part in ipairs(cloudParts) do
                        table.insert(cloudTargets, { part.Parent, part })
                    end
                    RegisterAttack:FireServer(0)
                    RegisterHit:FireServer(cloudParts[1], cloudTargets)
                end
            end)
        end
    else
        -- Fase 2: Nuvens quebradas -> desce na hitbox de Workspace.Map.Sky.Entrance para subir a Upper Yard
        BlockPortalTouch = false
        local enterOffset = Vector3.new(math.cos(t * 5) * 2.5, 0.5, math.sin(t * 5) * 2.5)
        hrp.CFrame = CFrame.new(targetPos + enterOffset)
        hrp.AssemblyLinearVelocity = Vector3.zero

        if (t - LastPortalTouch) >= 0.3 then
            LastPortalTouch = t
            if portalPart and firetouchinterest then
                pcall(function()
                    firetouchinterest(hrp, portalPart, 0)
                    task.wait(0.03)
                    firetouchinterest(hrp, portalPart, 1)
                end)
            end
            if CommF then
                pcall(function()
                    CommF:InvokeServer("requestEntrance", Config.SkyArea2SpawnPos)
                end)
            end
        end
    end
end

local function UseExitPortal(hrp, portalPart, fallbackPos)
    local targetPos = (portalPart and portalPart.Position) or fallbackPos
    local dist = (hrp.Position - targetPos).Magnitude

    if dist > 14 then
        TweenToCFrame(CFrame.new(targetPos + Vector3.new(0, 2, 0)), false)
        return
    end

    CancelTween()
    local t = os.clock()
    local offset = Vector3.new(math.cos(t * 6) * 2.5, math.sin(t * 8) * 2, math.sin(t * 6) * 2.5)
    hrp.CFrame = CFrame.new(targetPos + offset)
    hrp.AssemblyLinearVelocity = Vector3.zero

    if (t - LastPortalTouch) >= 0.3 then
        LastPortalTouch = t
        if portalPart and firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, portalPart, 0)
                task.wait(0.03)
                firetouchinterest(hrp, portalPart, 1)
            end)
        end
    end
end

local function MoveToCFrame(targetCFrame, snapAtEnd)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local map = workspace:FindFirstChild("Map")

    -- 1. Subir para Upper Yard (Y > 5200): quebra as nuvens do templo e atravessa Workspace.Map.Sky.Entrance
    if hrp.Position.Y < 4000 and targetCFrame.Position.Y > 4000 then
        local skyFolder = map and map:FindFirstChild("Sky")
        local entrancePart = skyFolder and skyFolder:FindFirstChild("Entrance")
        BreakCloudsAndEnterSky(hrp, entrancePart)
        return
    else
        PortalCycleStart = nil
    end

    -- 2. Descer de Upper Yard (Y > 5200) para os God's Guard (Y ~ 1088) atravessando Workspace.Map.SkyArea2.Exit
    if hrp.Position.Y > 4000 and targetCFrame.Position.Y < 2500 then
        BlockPortalTouch = false
        local skyArea2 = map and map:FindFirstChild("SkyArea2")
        local exitPart = skyArea2 and skyArea2:FindFirstChild("Exit")
        UseExitPortal(hrp, exitPart, Config.SkyArea2ExitPos)
        return
    end

    -- 3. Navegacao na mesma camada (protege contra toque acidental no Sky.Entrance durante God's Guard)
    BlockPortalTouch = (targetCFrame.Position.Y < 2500)
    TweenToCFrame(targetCFrame, snapAtEnd)
end

