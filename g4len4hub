-- =======================================================
-- BLOX FRUITS - AUTO FARM PIRATE STARTER (LEVEL 1 AO 10)
-- Foco: Completar 4 missões exatas (20 Bandits)
-- =======================================================

local player = game.Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- [1] Sistema Anti-AFK (Evita ser desconectado após 20 minutos)
player.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- Variável para contar quantas missões já foram feitas nesta sessão
local missoesConcluidas = 0
local nivelAlvo = 10

-- [2] Função para Equipar o Estilo de Luta (Melee / Combat)
local function equiparCombate()
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then
            player.Character.Humanoid:EquipTool(tool)
        end
    end
end

-- [3] Loop Principal do Auto Farm
spawn(function()
    while task.wait() do
        -- Verifica se o jogador já chegou no nível 10
        if player.Data.Level.Value < nivelAlvo then
            
            -- Verifica se a missão já está ativa na tela do jogador
            local temMissaoAtiva = player.PlayerGui.Main.Quest.Visible
            
            if not temMissaoAtiva then
                -- Se NÃO tem missão, vai até o NPC e pega a missão
                -- Teleporta em frente ao NPC para evitar flags de Anti-Cheat
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    player.Character.HumanoidRootPart.CFrame = CFrame.new(1062, 16, 1546)
                    task.wait(0.5)
                    
                    -- Invoca a missão remotamente
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                    
                    -- Se a missão for aceita com sucesso, soma no contador
                    task.wait(1)
                    if player.PlayerGui.Main.Quest.Visible then
                        missoesConcluidas = missoesConcluidas + 1
                        print("Missão do Bandit aceita! Contagem: " .. missoesConcluidas .. "/4")
                    end
                end
            else
                -- Se TEM missão, procura pelos Bandits e ataca
                for _, inimigo in pairs(workspace.Enemies:GetChildren()) do
                    if inimigo.Name == "Bandit" and inimigo:FindFirstChild("Humanoid") and inimigo.Humanoid.Health > 0 then
                        
                        -- Fica atacando esse inimigo até ele morrer ou a missão acabar
                        repeat task.wait()
                            equiparCombate()
                            
                            -- Posicionamento CFrame: Fica por cima/atrás do inimigo para evitar danos físicos e hitboxes magnéticas
                            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and inimigo:FindFirstChild("HumanoidRootPart") then
                                player.Character.HumanoidRootPart.CFrame = inimigo.HumanoidRootPart.CFrame * CFrame.new(0, 4, 3) 
                            end
                            
                            -- Auto-Clique (Ataca)
                            VirtualUser:CaptureController()
                            VirtualUser:ClickButton1(Vector2.new(0,0))
                            
                            -- Usa skills se quiser (Z, X) - Opcional, descomente para ativar
                            -- VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
                            
                        until not inimigo or not inimigo:FindFirstChild("Humanoid") or inimigo.Humanoid.Health <= 0 or not player.PlayerGui.Main.Quest.Visible
                        
                        -- Quebra o loop para pegar um novo Bandit vivo
                        break
                    end
                end
            end
        else
            -- Condição final: Chegou ao level 10
            print("=====================================================")
            print("META ATINGIDA: Level 10 alcançado!")
            print("4 Missões concluídas (20 Bandits derrotados).")
            print("O Auto-farm parou. Você já pode seguir para a JUNGLE.")
            print("=====================================================")
            break -- Encerra o script para não farmar infinitamente
        end
    end
end)
