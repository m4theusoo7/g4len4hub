-- Portais para evitar Kick por Teleporte Distante
local Portals = {
    Underwater = Vector3.new(3864.85, 6.68, -1926.78),
    Skylands = Vector3.new(-4607.82, 872.54, -1667.56)
}

-- Helpers de Verificação
local function GetCurrentLevel()
    return Player.Data.Level.Value
end

local function HasQuest()
    local questGui = Player.PlayerGui.Main:FindFirstChild("Quest")
    return questGui and questGui.Visible
end

local function GetTargetData()
    local lvl = GetCurrentLevel()
    for _, data in ipairs(Sea1Data) do
        if lvl >= data.min and lvl <= data.max then
            return data
        end
    end
    return Sea1Data[#Sea1Data] -- Retorna o último se passou do 700
end

-- Sistema de Movimentação Seguro (Tween + Portal Bypass)
local function TweenTo(targetVector)
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local distance = (root.Position - targetVector).Magnitude
    
    -- Bypass de Portais (Se tentar ir para Underwater City estando muito longe)
    if targetVector.X > 50000 and root.Position.X < 10000 then
        root.CFrame = CFrame.new(Portals.Underwater)
        task.wait(0.5)
    -- Bypass de Portais (Skylands topo)
    elseif targetVector.Y > 4000 and root.Position.Y < 2000 then
        root.CFrame = CFrame.new(Portals.Skylands)
        task.wait(0.5)
    end
    
    -- Tween principal
    local speed = 300
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(root, info, {CFrame = CFrame.new(targetVector)})
    tween:Play()
    tween.Completed:Wait()
end

-- Funções de Combate
local function EquipWeapon()
    for _, tool in ipairs(Player.Backpack:GetChildren()) do
        if tool.ToolTip == _G.WeaponName or tool.Name == _G.WeaponName then
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

local function Attack()
    if _G.AutoAttack then
        VU:CaptureController()
        VU:ClickButton1(Vector2.new(851, 158), game:GetService("Workspace").CurrentCamera.CFrame)
    end
end

local lastSkillTime = 0
local function UseSkills()
    if _G.AutoSkills and (tick() - lastSkillTime > _G.SkillDelay) then
        local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(keys) do
            VIM:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, key, false, game)
        end
        lastSkillTime = tick()
    end
end

-- Loop Principal do Auto-Farm
task.spawn(function()
    while task.wait() do
        if not _G.AutoFarm or not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then continue end
        
        local data = GetTargetData()
        
        -- 1. Lógica de Missão (Evita travamento no NPC)
        if not HasQuest() then
            -- Vai até o NPC
            if (Player.Character.HumanoidRootPart.Position - data.npc).Magnitude > 10 then
                TweenTo(data.npc)
            else
                -- Tenta disparar o ProximityPrompt ou Remotes para pegar a missão
                local npcModel = workspace.NPCs:FindFirstChild(data.mob .. " Quest Giver") or workspace.NPCs:FindFirstChild("Quest Giver")
                if npcModel and npcModel:FindFirstChild("Head") then
                    Player.Character.HumanoidRootPart.CFrame = npcModel.Head.CFrame
                end
                
                -- Aciona o remoting (Formato genérico CommF_, ajusta a missão pelo nível)
                local args = {
                    [1] = "StartQuest",
                    [2] = data.mob .. "Quest", 
                    [3] = 1 
                }
                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(unpack(args))
                task.wait(1) -- Aguarda a UI da missão atualizar
            end
        else
            -- 2. Lógica de Caça
            local mobFound = false
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if string.find(v.Name, data.mob) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    mobFound = true
                    EquipWeapon()
                    
                    -- Fica acima do inimigo para evitar dano melee
                    local targetPos = v.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
                    Player.Character.HumanoidRootPart.CFrame = targetPos
                    
                    Attack()
                    UseSkills()
                    break
                end
            end
            
            -- Se não encontrar o mob vivo, vai para a área de spawn aguardar
            if not mobFound then
                if (Player.Character.HumanoidRootPart.Position - data.spawn).Magnitude > 15 then
                    TweenTo(data.spawn)
                end
            end
        end
    end
end)

-- Fix para não cair do mapa durante o Tween
