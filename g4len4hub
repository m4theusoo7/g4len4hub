    local level = data and data:FindFirstChild("Level")
    return level and level.Value or 450
end

local function EnableAura()
    if not CommF then return end
    local character = LocalPlayer.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not hum or hum.Health <= 0 then return end

    if not character:FindFirstChild("HasBuso") and (os.clock() - LastAuraCheck) >= 3 then
        LastAuraCheck = os.clock()
        pcall(function()
            CommF:InvokeServer("Buso")
        end)
    end
end

local function CancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTargetPos = nil
end

local function MatchesMobName(actualName, mobNames)
    for _, name in ipairs(mobNames) do
        if actualName == name then
            return true
        end
    end
    return false
end

local function IsValidMobAltitude(targetAltitude, pos)
    if not pos then return false end
    if targetAltitude == "Lower" then
        return pos.Y >= 900 and pos.Y <= 1400
    else
        return pos.Y >= 5200 and pos.Y <= 6200
    end
end

local function IsBossAvailable(taskInfo)
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if MatchesMobName(mob.Name, taskInfo.MobNames) then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                local hrp = mob:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and hrp and IsValidMobAltitude(taskInfo.TargetAltitude, hrp.Position) then
                    return true
                end
            end
        end
    end

    for _, name in ipairs(taskInfo.MobNames) do
        local storedBoss = ReplicatedStorage:FindFirstChild(name)
        if storedBoss then
            local hum = storedBoss:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health > 0 then
                return true
            end
        end
    end

    return false
end

