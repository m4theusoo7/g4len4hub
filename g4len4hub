        if level >= data.min and level <= data.max then return data end
    end
    return Sea1Guide[#Sea1Guide]
end

-- 3. SISTEMA DE VOO SEGURO (Com Anti-Travamento)
local function tweenTo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- [A CORREÇÃO ESTÁ AQUI]: Evita que o Tween fique reiniciando infinitamente
    if currentTween and currentTweenTarget and (currentTweenTarget - targetPos).Magnitude < 15 then
        return -- O boneco já está voando para essa área, não faz nada!
    end

    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 5 then return end
    
    currentTweenTarget = targetPos -- Salva o destino atual
    
    local speed = 300
    local timeToReach = distance / speed
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    
    if currentTween then currentTween:Cancel() end
    currentTween = ts:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    currentTween:Play()
end

local function cancelTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
        currentTweenTarget = nil
    end
end

-- 4. ATAQUES E SKILLS
local function autoAttackAndSkills()
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

-- 5. VARREDURA DE NPCS E MOBS
local function findNPC(npcName)
    if workspace:FindFirstChild("NPCs") then
        for _, npc in pairs(workspace.NPCs:GetChildren()) do
            if string.find(string.lower(npc.Name), string.lower(npcName)) and npc:FindFirstChild("HumanoidRootPart") then
                return npc.HumanoidRootPart.Position
            end
        end
    end
    return nil
end

local function scanForMob(mobName)
    local closestMob = nil
    local shortestDist = math.huge
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    if workspace:FindFirstChild("Enemies") then
        for _, mob in pairs(workspace.Enemies:GetChildren()) do
            if string.find(string.lower(mob.Name), string.lower(mobName)) and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                local dist = (char.HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end
    return closestMob
end

local function hasQuest()
    local gui = player.PlayerGui:FindFirstChild("Main")
    if gui and gui:FindFirstChild("Quest") then return gui.Quest.Visible end
    return false
end

-- 6. LOOP PRINCIPAL (CÉREBRO DO SCRIPT)
task.spawn(function()
    while _G.AutoFarm do
        task.wait(0.1)
        
        pcall(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local myLevel = player.Data.Level.Value
            
            if myLevel >= 700 then
                _G.AutoFarm = false
                cancelTween()
                print("🎉 LEVEL 700 ALCANÇADO! 🎉")
                return
            end
            
            local questData = getQuestData(myLevel)
            local npcPos = findNPC(questData.npc)
            if not npcPos then return end
            
            if not hasQuest() then
                -- FASE 1: PEGAR MISSÃO
                if (hrp.Position - npcPos).Magnitude > 10 then
                    tweenTo(npcPos)
                else
                    cancelTween()
                    task.spawn(function()
                        rs.Remotes.CommF_:InvokeServer("StartQuest", questData.quest, questData.num)
                    end)
                    task.wait(0.5)
                end
            else
                -- FASE 2: MATAR O MONSTRO
                local targetMob = scanForMob(questData.mob)
                
                if targetMob then
                    -- Calcula a posição nas costas do monstro
                    local farmPos = targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 4)
                    
                    if (hrp.Position - farmPos.Position).Magnitude > 12 then
                        tweenTo(farmPos.Position)
                    else
                        cancelTween()
                        -- Trava nas costas e bate
                        if targetMob.Humanoid.Health > 0 then
                            hrp.CFrame = farmPos 
                            autoAttackAndSkills()
                        end
                    end
                else
                    -- Se a missão tá ativa mas não achou o monstro, fica no ar perto do NPC esperando dar spawn
                    local waitPos = npcPos + Vector3.new(0, 50, 0)
                    if (hrp.Position - waitPos).Magnitude > 15 then
                        tweenTo(waitPos)
                    end
                end
            end
        end)
    end
end)
