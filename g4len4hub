local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:FindFirstChild("Humanoid")
local rootPart = character:FindFirstChild("HumanoidRootPart")

-- Configurações
local farmLocation = Vector3.new(100, 50, -200) -- Coordenadas de uma área segura (exemplo: Mar 1 ou 2)
local attackRange = 40
local speed = 16

-- Função para mover o personagem
function moveToFarm()
    local targetPos = farmLocation + Vector3.new(0, math.random(-5, 5), 0) -- Pequena variação para não ficar preso
    rootPart.CFrame = CFrame.new(targetPos) * CFrame.Angles(math.rad(90), 0, 0)
end

-- Função principal de loop
while true do
    -- Aguarda o personagem estar pronto
    if humanoid and humanoid.Health > 0 then
        moveToFarm()
        
        -- Simula um ataque simples (ajuste conforme sua arma/fruta)
        local weapon = character:FindFirstChild("Weapon") or character:FindFirstChild("Fruit")
        if weapon then
            -- Lógica de ataque (exemplo genérico)
            print("Atacando inimigos na área...")
            
            -- Verifica se há inimigos próximos (simplificado)
            local enemies = workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("NPCs")
            if enemies then
                for _, enemy in ipairs(enemies:GetChildren()) do
                    if enemy and enemy.Parent ~= character then
                        local dist = rootPart.Position - enemy.PrimaryPart.Position
                        if mag(dist) < attackRange then
                            -- Tocar animação de ataque (opcional, depende da ferramenta)
                            print("Inimigo detectado!")
                        end
                    end
                end
            else
                print("Área limpa ou sem inimigos detectados.")
            end
            
            -- Pequeno delay para não processar demais
            task.wait(1.5) 
        end
    else
        print("Aguardando personagem...")
        task.wait(2)
    end
    
    -- Opcional: Voltar para spawn se estiver muito baixo de vida (exemplo simples)
    if humanoid and humanoid.Health < 30 then
        moveToFarm()
        task.wait(5)
    end
end
