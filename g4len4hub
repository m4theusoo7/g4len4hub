local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local commF = remotes:WaitForChild("CommF_")

-- Configurações do Usuário
getgenv().Config = {
    AutoFarm = true,
    SelectWeapon = "Combat", -- Altere para sua arma/fruta equipada (ex: Melee, Sword, Blox Fruit)
    SkillZ = true,
    SkillX = true,
    SkillC = true,
    SkillV = true,
}

-- Anti-AFK
local vu = game:GetService("VirtualUser")
player.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

-- Noclip para evitar travamentos em paredes da ilha
RunService.Stepped:Connect(function()
    if getgenv().Config.AutoFarm and player.Character then
        for _, part in pairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Função de Tween (Movimentação suave até o alvo)
local function safeTween(targetCFrame)
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = player.Character.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 300 -- Velocidade segura para evitar anti-cheat
    
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, {CFrame = targetCFrame + Vector3.new(0, 5, 0)})
    tween:Play()
    
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not getgenv().Config.AutoFarm or (hrp.Position - targetCFrame.Position).Magnitude < 10 then
            tween:Cancel()
            connection:Disconnect()
        end
    end)
    tween.Completed:Wait()
end

-- Função para equipar arma selecionada
local function equipWeapon()
    local背包 = player.Backpack
    local char = player.Character
    if char and not char:FindFirstChildOfClass("Tool") then
        for _, tool in pairs(背包:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name == getgenv().Config.SelectWeapon or tool.ToolTip == getgenv().Config.SelectWeapon or true) then
                char.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

