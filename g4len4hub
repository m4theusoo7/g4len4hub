-- Função de Mapeamento da Ilha Atual
local function ScanCurrentIsland()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local closestIsland = nil
    local shortestDist = math.huge
    
    -- Varredura para identificar a ilha mais próxima baseada no level do jogador
    local playerLevel = LocalPlayer.Data.Level.Value
    for _, island in ipairs(Sea1Islands) do
        if playerLevel >= island.MinLevel and playerLevel <= island.MaxLevel then
            closestIsland = island
            break
        end
    end
    
    if not closestIsland then
        closestIsland = Sea1Islands[1] -- Fallback para iniciantes
    end
    
    getgenv().Config.CurrentIsland = closestIsland
    getgenv().Config.TargetMob = closestIsland.MobName
end

-- Sistema de Movimentação por Tween (Seguro contra quedas)
local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (targetPos - hrp.Position).Magnitude
    local speed = 300 -- Velocidade de voo controlada para não bugar o anticheat
    
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    
    getgenv().CurrentTween = tween
    tween:Play()
    return tween
end

-- Simulação de Ativação de Missão via Remote (Sem tocar no NPC)
local function TriggerQuestRemotely()
    pcall(function()
        local island = getgenv().Config.CurrentIsland
        if not island then return end
        
        -- Dispara o evento de recebimento de quest diretamente no servidor
        local questRemote = game:GetService("ReplicatedStorage").Remotes.CommF_
        questRemote:InvokeServer("StartQuest", island.QuestName, 1)
        getgenv().Config.QuestActive = true
    end)
end

