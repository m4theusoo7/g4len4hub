local function makeBtn(text, posX, sizeW, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(sizeW, -5, 0, 32)
    btn.Position = UDim2.new(posX, 3, 1, -38)
    btn.BackgroundColor3 = color
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.Parent = Frame
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local flyBtn
flyBtn = makeBtn("IR ATE ILHA", 0, 0.28, Color3.fromRGB(215, 130, 35), function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local targetPos = detectedIslandPos + Vector3.new(0, 40, 0)
    local dist = (hrp.Position - targetPos).Magnitude
    flyBtn.Text = "VOANDO..."

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    local noclip = RunService.Stepped:Connect(function()
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)

    local tween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / 240, 0.2), Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(targetPos)
    })
    tween:Play()
    tween.Completed:Connect(function()
        noclip:Disconnect()
        bv:Destroy()
        flyBtn.Text = "CHEGOU!"
        OutputBox.Text = OutputBox.Text .. "\n\n" .. RunScan()
        Scroll.CanvasSize = UDim2.new(0, 0, 0, 2400)
        OutputBox.Size = UDim2.new(1, -8, 0, 2400)
        task.delay(1.5, function()
            if flyBtn then flyBtn.Text = "IR ATE ILHA" end
        end)
    end)
end)

makeBtn("RE-ESCANEAR", 0.28, 0.27, Color3.fromRGB(45, 110, 210), function()
