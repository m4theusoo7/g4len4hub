local function GetCurrentFarmData()
    local myLevel = player.Data.Level.Value
    for _, data in ipairs(FarmGuide) do
        if myLevel >= data.min and myLevel <= data.max then return data end
    end
    return FarmGuide[#FarmGuide]
end

-- 3. MOVIMENTAÇÃO INTELIGENTE (Rota Aérea Segura)
local function TweenTo(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local targetPos = targetCFrame.Position
    local distance = (hrp.Position - targetPos).Magnitude
    local speed = 300 
    
    if distance < 10 then
        hrp.CFrame = targetCFrame
        return
    end
    
    if distance > 300 then
        hrp.CFrame = CFrame.new(hrp.Position.X, 600, hrp.Position.Z)
        task.wait(0.1)
        
        local skyTarget = CFrame.new(targetPos.X, 600, targetPos.Z)
        local skyTweenInfo = TweenInfo.new((hrp.Position - skyTarget.Position).Magnitude / speed, Enum.EasingStyle.Linear)
        local skyTween = tweenService:Create(hrp, skyTweenInfo, {CFrame = skyTarget})
        
        skyTween:Play()
        skyTween.Completed:Wait()
    end
    
    local finalTweenInfo = TweenInfo.new((hrp.Position - targetPos).Magnitude / speed, Enum.EasingStyle.Linear)
    local finalTween = tweenService:Create(hrp, finalTweenInfo, {CFrame = targetCFrame})
    finalTween:Play()
    finalTween.Completed:Wait()
end

