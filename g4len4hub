-- Anti-AFK para evitar desconexão durante o farm longo
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Função de Mapeamento Dinâmico por Level
local function ScanAndGetIsland()
    local playerLevel = 1
    pcall(function()
        playerLevel = LocalPlayer.Data.Level.Value
    end)
    
    for _, island in ipairs(Sea1Islands) do
        if playerLevel >= island.MinLevel and playerLevel <= island.MaxLevel then
            getgenv().OmegaConfig.CurrentIsland = island
            getgenv().OmegaConfig.TargetMob = island.MobName
            return island
        end
    end
    -- Fallback padrão
    getgenv().OmegaConfig.CurrentIsland = Sea1Islands[1]
    getgenv().OmegaConfig.TargetMob = Sea1Islands[1].MobName
    return Sea1Islands[1]
end

-- Movimentação Suave (Tween)
local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    local distance = (targetPos - hrp.Position).Magnitude
    local speed = 310 -- Velocidade segura para Delta Executor
    
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
end

-- Resgate Remoto da Missão (Sem encostar no NPC físico)
local function TriggerQuestRemotely()
    if tick() - getgenv().OmegaConfig.LastQuestCheck < 15 then return end
    getgenv().OmegaConfig.LastQuestCheck = tick()
    
    pcall(function()
        local island = getgenv().OmegaConfig.CurrentIsland
        if not island then return end
        
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            -- Envia o comando direto para iniciar a missão do level correspondente
            commF:InvokeServer("StartQuest", island.QuestName, 1)
        end
    end)
end

-- Sistema de Disparo de Habilidades (Z, X, C, V)
local function UseCombatSkills()
    if not getgenv().OmegaConfig.UseSkills then return end
    
    local vim = game:GetService("VirtualInputManager")
    local skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    
    task.spawn(function()
        for _, key in ipairs(skills) do
            pcall(function()
                vim:SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                vim:SendKeyEvent(false, key, false, game)
                task.wait(0.1)
            end)
        end
    end)
end

-- Loop Principal de Varredura e Combate Automatizado
task.spawn(function()
    while task.wait(0.3) do
        if getgenv().OmegaConfig.AutoFarm then
            local island = ScanAndGetIsland()
            TriggerQuestRemotely()
            
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local targetFound = false
                
                -- Varredura em tempo real dos inimigos na pasta Workspace.Enemies
                local enemiesFolder = Workspace:FindFirstChild("Enemies")
                if enemiesFolder then
                    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                        if enemy.Name == getgenv().OmegaConfig.TargetMob then
                            local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
                            local enemyHum = enemy:FindFirstChild("Humanoid")
                            
                            if enemyHRP and enemyHum and enemyHum.Health > 0 then
                                targetFound = true
                                
                                -- Posição estratégica acima do mob (evita dano corpo a corpo inimigo)
                                local combatPos = enemyHRP.Position + Vector3.new(0, 25, 0)
                                
                                if (hrp.Position - combatPos).Magnitude > 12 then
                                    TweenTo(combatPos)
                                else
                                    -- Manter CFrame travado em cima do alvo
                                    hrp.CFrame = CFrame.new(combatPos)
                                    
                                    -- Executar Ataque Básico contínuo
                                    pcall(function()
                                        VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                    end)
                                    
                                    -- Disparar Habilidades
                                    UseCombatSkills()
                                end
                                break
                            end
                        end
                    end
                end
                
                -- Se não houver monstros na mira, viaja para o spawn padrão da ilha mapeada
                if not targetFound and island and island.Spawn then
                    if (hrp.Position - island.Spawn).Magnitude > 20 then
                        TweenTo(island.Spawn)
                    end
                end
            end
        end
    end
end)

print("OmegaCore Sea 1 Mapper + Auto-Farm & Skills ativado com sucesso!")
