-- Auto Buy Water Kung Fu (Sea 1) - Delta Executor
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

-- Coordenadas Sea 1
local WhirlpoolPos = Vector3.new(3864.688, 6.736, -1926.214)       -- Entrada na superfície
local UnderwaterSpawn = Vector3.new(61163.851, 11.679, 1819.784)   -- Ponto interno após entrar
local TeacherPos = Vector3.new(61273.5, 18.4, 1565.2)              -- NPC Water Kung Fu Teacher

local TweenSpeed = 300

-- NoClip para evitar ficar preso em paredes/água durante o deslocamento
local noclipConnection
local function setNoClip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- Movimentação suave via Tween
local function tweenTo(targetVector)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    
    local distance = (hrp.Position - targetVector).Magnitude
    if distance < 5 then
        hrp.CFrame = CFrame.new(targetVector)
        return
    end

    local duration = distance / TweenSpeed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetVector)})
    
    tween:Play()
    tween.Completed:Wait()
end

-- Verifica se já está dentro da Underwater City (X > 50000 no Sea 1)
local function isInsideUnderwaterCity()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position.X > 50000
end

-- Execução Principal
task.spawn(function()
    local beli = LocalPlayer:WaitForChild("Data"):WaitForChild("Beli").Value
    if beli < 750000 then
        warn("[OmegaCore] Beli insuficiente! Você precisa de $750,000 (Atual: $" .. tostring(beli) .. ")")
        return
    end

    setNoClip(true)

    -- Passo 1: Entrar na Underwater City se ainda estiver na superfície
    if not isInsideUnderwaterCity() then
        -- Tenta o teleporte direto pelo Remote oficial do redemoinho
        CommF:InvokeServer("requestEntrance", UnderwaterSpawn)
        task.wait(1.2)

        -- Fallback: se o Remote não teleportar à distância, vai até o redemoinho e ativa
        if not isInsideUnderwaterCity() then
            tweenTo(WhirlpoolPos)
            task.wait(0.5)
            CommF:InvokeServer("requestEntrance", UnderwaterSpawn)
            task.wait(1.2)
        end
    end

    -- Passo 2: Ir até o NPC Water Kung Fu Teacher e comprar
    if isInsideUnderwaterCity() then
        tweenTo(TeacherPos)
        task.wait(0.5)
        
        local result = CommF:InvokeServer("BuyFishmanKarate")
        print("[OmegaCore] Resposta da compra:", result)
    else
        warn("[OmegaCore] Falha ao entrar na Underwater City.")
    end

    setNoClip(false)
end)
