-- OmegaCore Auto-Farm: Brutes (Pirate Village) até Level 55
local player = game.Players.LocalPlayer
local tweenService = game:GetService("TweenService")
local vim = game:GetService("VirtualInputManager")

local mobName = "Brute"
local questName = "PirateQuest"
local questLevel = 2 -- A quest dos Brutes é a número 2 na Pirate Village
local questGiverCFrame = CFrame.new(-1139.5, 4.7, 3824.5) -- CFrame do NPC de Quest da Pirate Village
local bruteSpawnCFrame = CFrame.new(-1145, 40, 4250) -- Posição de espera caso os Brutes não tenham spawnado

-- Anti-AFK
for _, connection in pairs(getconnections(player.Idled)) do
    connection:Disable()
end

local function noclip()
    for _, part in pairs(player.Character:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end

local function tweenTo(targetCFrame)
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local distance = (player.Character.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
        local speed = 300 -- Ajuste a velocidade se o anti-cheat der teleport back (padrão seguro 300)
        local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
        local tween = tweenService:Create(player.Character.HumanoidRootPart, info, {CFrame = targetCFrame})
        tween:Play()
        tween.Completed:Wait()
    end
end

local function hasQuest()
    return player.PlayerGui.Main.Quest.Visible
end

local function getQuest()
    if not hasQuest() then
        tweenTo(questGiverCFrame)
        task.wait(0.5)
        -- Invoca o servidor para pegar a quest 2 (Brutes)
        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
    end
end

local function useSkills()
    local skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(skills) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

local function attackMob(mob)
    if mob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
        -- Fica acima do Brute virado para baixo para evitar dano
        tweenTo(mob.HumanoidRootPart.CFrame * CFrame.new(0, 8, 0) * CFrame.Angles(math.rad(-90), 0, 0))
        
        -- Auto Click
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.05)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
        
        -- Rotação de Skills
        useSkills()
    end
end

spawn(function()
    while task.wait() do
        pcall(function()
            local level = player.Data.Level.Value
            
            if level < 55 then
                noclip() -- Impede de enganchar nas casas da vila
                
                if hasQuest() then
                    local foundMob = false
                    
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if v.Name == mobName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                            foundMob = true
                            attackMob(v)
                            break -- Foca em um Brute por vez
                        end
                    end
                    
                    if not foundMob then
                        -- Se matou todos, fica esperando no ar em cima do spawn point
                        tweenTo(bruteSpawnCFrame) 
                    end
                else
                    getQuest()
                end
            else
                print("[OmegaCore] Level 55 atingido! Finalizando o farm dos Brutes. Hora de ir pro Bobby ou Desert Island.")
            end
        end)
    end
end)
