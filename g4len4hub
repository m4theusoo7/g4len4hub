local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

local function fmtVec(v)
    return string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
end

local function isSkyRelated(name)
    local low = string.lower(name or "")
    local keywords = {
        "sky", "upper", "mole", "shanda", "warlord", "wysper",
        "royal", "lightning", "thunder", "god", "guard", "portal",
        "cloud", "temple", "yard", "teleport", "entrance", "warp"
    }
    for _, kw in ipairs(keywords) do
        if string.find(low, kw, 1, true) then
            return true
        end
    end
    return false
end

local function RunScan()
    local lines = {}
    local function add(txt)
        table.insert(lines, txt)
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local playerPos = hrp and hrp.Position or Vector3.zero

    add("=== OMEGACORE SCANNER (UPPER SKYLANDS) ===")
    add("[PLAYER] " .. fmtVec(playerPos))

    -- 1. Locations
    add("\n[LOCATIONS]")
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local locations = worldOrigin and worldOrigin:FindFirstChild("Locations")
    if locations then
        for _, loc in ipairs(locations:GetChildren()) do
            if loc:IsA("BasePart") and (isSkyRelated(loc.Name) or loc.Position.Y > 300) then
                add(string.format("- %s | %s", loc.Name, fmtVec(loc.Position)))
            end
        end
    end

    -- 2. NPCs (Workspace + ReplicatedStorage)
    add("\n[NPCS]")
    local seenNpcs = {}
    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            local nHrp = npc:FindFirstChild("HumanoidRootPart")
            if nHrp and (isSkyRelated(npc.Name) or nHrp.Position.Y > 300 or (nHrp.Position - playerPos).Magnitude <= 1200) then
                seenNpcs[npc.Name] = true
                add(string.format("- [WS] %s | %s", npc.Name, fmtVec(nHrp.Position)))
            end
        end
    end
    for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and isSkyRelated(obj.Name) and not seenNpcs[obj.Name] then
            add(string.format("- [RS] %s | %s", obj.Name, fmtVec(obj.HumanoidRootPart.Position)))
        end
    end

    -- 3. Portais, TouchTransmitters, ProximityPrompts e ClickDetectors
    add("\n[PORTAIS / INTERACOES]")
    local seenParts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("TouchTransmitter") or obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
            local parent = obj.Parent
            local part = parent and (parent:IsA("BasePart") and parent or parent:FindFirstChildWhichIsA("BasePart"))
            if part and not seenParts[part] then
                local lowFull = string.lower(part:GetFullName())
                local isChest = string.find(lowFull, "chest", 1, true)
                local nearOrHigh = (part.Position.Y > 300) or ((part.Position - playerPos).Magnitude <= 800) or isSkyRelated(part:GetFullName())
                if not isChest and nearOrHigh then
                    seenParts[part] = true
                    add(string.format("- [%s] %s | %s | Size: %s", obj.ClassName, part:GetFullName(), fmtVec(part.Position), fmtVec(part.Size)))
                end
            end
        end
    end

    -- 4. EnemySpawns agrupados
    add("\n[ENEMY SPAWNS]")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        local groups = {}
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if sp:IsA("BasePart") and (isSkyRelated(sp.Name) or sp.Position.Y > 300) then
                groups[sp.Name] = groups[sp.Name] or {}
                table.insert(groups[sp.Name], sp.Position)
            end
        end
        for mobName, posList in pairs(groups) do
            local sum = Vector3.zero
            local minY, maxY = math.huge, -math.huge
            for _, p in ipairs(posList) do
                sum += p
                if p.Y < minY then minY = p.Y end
                if p.Y > maxY then maxY = p.Y end
            end
            local avg = sum / #posList
            add(string.format("- %s (x%d) | Centro: %s | Y: %.1f..%.1f", mobName, #posList, fmtVec(avg), minY, maxY))
        end
    end

    -- 5. Enemies ativos no momento
    add("\n[ENEMIES ATIVOS]")
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        local seenEnemies = {}
        for _, mob in ipairs(enemies:GetChildren()) do
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            if mHrp and not seenEnemies[mob.Name] and (isSkyRelated(mob.Name) or mHrp.Position.Y > 300) then
                seenEnemies[mob.Name] = true
                add(string.format("- %s | %s", mob.Name, fmtVec(mHrp.Position)))
            end
        end
    end

    return table.concat(lines, "\n")
end

