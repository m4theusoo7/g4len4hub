-- Configuração Principal
_G.AutoFarmPirateStarter = true

local Settings = {
    MaxLevel = 10,
    TweenSpeed = 200,
    DistanceFarm = 20,
    FastAttack = true,
    AttackDelay = 0.08,
    BringMob = true,
    BringRadius = 250,
    QuestName = "BanditQuest1",
    QuestLevel = 1,
    QuestNPCName = "Bandit Quest Giver",
    MobName = "Bandit",
    QuestNPC_Fallback = CFrame.new(1059.37, 16.5, 1550.42),
    MobSpawn_CFrame = CFrame.new(1145.0, 17.0, 1634.0)
}

-- Serviços
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer
local CurrentTween = nil

-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Cancela o Tween ativo
local function StopTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
end

-- Noclip + Anti-Gravidade (impede o avatar de afundar pelo chão)
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if _G.AutoFarmPirateStarter then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        if hum then
            hum.PlatformStand = true
        end

        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero

            local bv = hrp:FindFirstChild("OmegaAntiGravity")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaAntiGravity"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            else
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
            end
        end
    else
        if hum and hum.PlatformStand then
            hum.PlatformStand = false
        end
        if hrp then
            local bv = hrp:FindFirstChild("OmegaAntiGravity")
            if bv then
                bv:Destroy()
            end
        end
    end
end)

-- Movimentação suave com Tween 200
local function MoveTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    -- Curta distância: posiciona direto sem reiniciar Tween
    if distance <= 25 then
        StopTween()
        hrp.CFrame = targetCFrame
        return
    end

    StopTween()
    local duration = distance / Settings.TweenSpeed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    CurrentTween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCFrame })
    CurrentTween:Play()
end

-- Equipa Combat / Melee automaticamente
local function EquipMelee()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(tool)
                return tool
            end
        end
    end
    return equipped
end

-- Bring Mob ancorado acima do solo (evita que os mobs caiam no limbo)
local function BringEnemies(mainTarget)
    if not Settings.BringMob or not mainTarget then return end
    local mainHRP = mainTarget:FindFirstChild("HumanoidRootPart")
    if not mainHRP then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    -- Garante que a âncora nunca fique abaixo do nível do chão da ilha
    local safeY = math.max(mainHRP.Position.Y, 16.5)
    local anchorCFrame = CFrame.new(mainHRP.Position.X, safeY, mainHRP.Position.Z)
    mainHRP.CFrame = anchorCFrame
    mainHRP.AssemblyLinearVelocity = Vector3.zero

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if mob ~= mainTarget and string.find(mob.Name, Settings.MobName) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                local dist = (mobHRP.Position - anchorCFrame.Position).Magnitude
                if dist <= Settings.BringRadius then
                    mobHRP.CFrame = anchorCFrame
                    mobHRP.AssemblyLinearVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

-- Busca apenas Bandits vivos que estejam acima do chão (Y > 5)
local function GetClosestBandit()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not hrp or not enemiesFolder then return nil end

    local closestMob = nil
    local shortestDist = math.huge

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if string.find(mob.Name, Settings.MobName) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                local dist = (hrp.Position - mobHRP.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

-- Localiza a frente do NPC da missão
local function GetQuestNPCCFrame()
    local wsNPCs = workspace:FindFirstChild("NPCs")
    local rsNPCs = ReplicatedStorage:FindFirstChild("NPCs")
    local questNPC = (wsNPCs and wsNPCs:FindFirstChild(Settings.QuestNPCName))
        or (rsNPCs and rsNPCs:FindFirstChild(Settings.QuestNPCName))

    local npcHRP = questNPC and questNPC:FindFirstChild("HumanoidRootPart")
    if npcHRP then
        return npcHRP.CFrame * CFrame.new(0, 0, -4)
    end
    return Settings.QuestNPC_Fallback
end

-- Pega a missão e aguarda confirmação visual
local function EnsureQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")

    if questFrame and questFrame.Visible then
        return true
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local npcCFrame = GetQuestNPCCFrame()
    local distToNPC = (hrp.Position - npcCFrame.Position).Magnitude

    if distToNPC > 6 then
        MoveTo(npcCFrame)
        return false
    end

    StopTween()
    hrp.CFrame = npcCFrame
    task.wait(0.15)

    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", Settings.QuestName, Settings.QuestLevel)
    end)

    for _ = 1, 20 do
        if questFrame and questFrame.Visible then
            task.wait(0.15)
            return true
        end
        task.wait(0.1)
    end

    return false
end

-- Loop separado para Fast Attack
task.spawn(function()
    while _G.AutoFarmPirateStarter do
        if Settings.FastAttack then
            pcall(function()
                local data = LocalPlayer:FindFirstChild("Data")
                if data and data.Level.Value >= Settings.MaxLevel then return end

                local target = GetClosestBandit()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if target and hrp then
                    local targetHRP = target:FindFirstChild("HumanoidRootPart")
                    if targetHRP and (hrp.Position - targetHRP.Position).Magnitude <= (Settings.DistanceFarm + 15) then
                        local tool = EquipMelee()
                        if tool then
                            tool:Activate()
                        end
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(1280, 672))
                    end
                end
            end)
        end
        task.wait(Settings.AttackDelay)
    end
end)

-- Loop Principal de Farm (Level 1 ao 10)
task.spawn(function()
    while _G.AutoFarmPirateStarter do
        pcall(function()
            local data = LocalPlayer:FindFirstChild("Data")
            if not data then return end

            if data.Level.Value >= Settings.MaxLevel then
                _G.AutoFarmPirateStarter = false
                StopTween()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hum then hum.PlatformStand = false end
                if hrp and hrp:FindFirstChild("OmegaAntiGravity") then
                    hrp.OmegaAntiGravity:Destroy()
                end
                print("[OmegaCore] Level 10 atingido! Auto-farm finalizado.")
                return
            end

            if EnsureQuest() then
                local target = GetClosestBandit()
                if target then
                    local targetHRP = target:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        EquipMelee()
                        BringEnemies(target)
                        local safeY = math.max(targetHRP.Position.Y, 16.5)
                        local farmPos = Vector3.new(targetHRP.Position.X, safeY + Settings.DistanceFarm, targetHRP.Position.Z)
                        local farmCFrame = CFrame.new(farmPos) * CFrame.Angles(math.rad(-90), 0, 0)
                        MoveTo(farmCFrame)
                    end
                else
                    MoveTo(Settings.MobSpawn_CFrame * CFrame.new(0, Settings.DistanceFarm, 0))
                end
            end
        end)
        task.wait(0.1)
    end
end)
