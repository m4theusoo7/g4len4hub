-- ====================================================
-- Blox Fruits Auto Farm - Frozen Village (Lv. 90 - 120) [Versão Corrigida]
-- Compatível com Delta Executor
-- ====================================================

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

getgenv().AutoFarmFrozen = true

-- Variável para controlar o Tween atual e evitar sobreposição
local currentTween = nil

local function stopCurrentTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
end

-- Criar UI Flutuante com "Stop Tween"
local ScreenGui = Instance.new("ScreenGui")
local StopButton = Instance.new("TextButton")

ScreenGui.Name = "AutoFarmUI"
ScreenGui.Parent = game.CoreGui
ScreenGui.ResetOnSpawn = false

StopButton.Name = "StopTweenButton"
StopButton.Parent = ScreenGui
StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
StopButton.Position = UDim2.new(0, 20, 0, 50)
StopButton.Size = UDim2.new(0, 110, 0, 45)
StopButton.Font = Enum.Font.SourceSansBold
StopButton.Text = "Stop Tween"
StopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
StopButton.TextSize = 16
StopButton.Active = true
StopButton.Draggable = true

StopButton.MouseButton1Click:Connect(function()
    getgenv().AutoFarmFrozen = not getgenv().AutoFarmFrozen
    if getgenv().AutoFarmFrozen then
        StopButton.Text = "Stop Tween"
        StopButton.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
    else
        StopButton.Text = "Resumir Farm"
        StopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        stopCurrentTween()
    end
end)

-- Anti-AFK seguro
pcall(function()
    for _, connection in ipairs(getconnections(LocalPlayer.Idled)) do
        connection:Disable()
    end
end)

-- Configuração de alvos por nível na Frozen Village
local function getTargetData()
    local level = (LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level")) and LocalPlayer.Data.Level.Value or 90
    if level < 100 then
        return {
            Name = "Snow Bandit",
            QuestName = "SnowQuest",
            QuestIndex = 1,
            NPC_CFrame = CFrame.new(1385, 105, -1300),
            Farm_CFrame = CFrame.new(1345, 105, -1320)
        }
    elseif level < 110 then
        return {
            Name = "Snow Trooper",
            QuestName = "SnowQuest",
            QuestIndex = 2,
            NPC_CFrame = CFrame.new(1150, 145, -1540),
            Farm_CFrame = CFrame.new(1150, 145, -1540)
        }
    else
        return {
            Name = "Yeti",
            QuestName = "SnowQuest",
            QuestIndex = 3,
            NPC_CFrame = CFrame.new(1185, 110, -1580),
            Farm_CFrame = CFrame.new(1185, 110, -1580)
        }
    end
end

-- Função para encontrar o inimigo mais próximo
local function getNearestEnemy(name)
    local targetEnemy = nil
    local shortestDist = math.huge
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    if Workspace:FindFirstChild("Enemies") then
        for _, v in pairs(Workspace.Enemies:GetChildren()) do
            local enemyRoot = v:FindFirstChild("HumanoidRootPart")
            local humanoid = v:FindFirstChild("Humanoid")
            if enemyRoot and humanoid and humanoid.Health > 0 and string.find(v.Name, name) then
                local dist = (rootPart.Position - enemyRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetEnemy = v
                end
            end
        end
    end
    return targetEnemy
end

local lastQuestTick = 0

-- Loop Principal de Farm Otimizado
task.spawn(function()
    while task.wait(0.1) do
        if getgenv().AutoFarmFrozen then
            pcall(function()
                local character = LocalPlayer.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                local rootPart = character.HumanoidRootPart
                
                local target = getTargetData()
                
                -- Ativar Haki (Buso) automaticamente se não estiver ativo
                if not rootPart:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end

                local questGui = LocalPlayer.PlayerGui.Main.Quest
                
                -- Se não tem quest ativa
                if not questGui.Visible then
                    if tick() - lastQuestTick > 3 then
                        lastQuestTick = tick()
                        stopCurrentTween()
                        
                        local dist = (rootPart.Position - target.NPC_CFrame.Position).Magnitude
                        if dist > 15 then
                            currentTween = TweenService:Create(rootPart, TweenInfo.new(dist / 280, Enum.EasingStyle.Linear), {CFrame = target.NPC_CFrame})
                            currentTween:Play()
                            currentTween.Completed:Wait()
                        else
                            rootPart.CFrame = target.NPC_CFrame
                        end
                        task.wait(0.3)
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", target.QuestName, target.QuestIndex)
                        task.wait(0.5)
                    end
                else
                    -- Quest ativa: procurar inimigos
                    local enemy = getNearestEnemy(target.Name)
                    if enemy and enemy:FindFirstChild("HumanoidRootPart") then
                        local enemyRoot = enemy.HumanoidRootPart
                        local dist = (rootPart.Position - enemyRoot.Position).Magnitude
                        
                        if dist > 15 then
                            stopCurrentTween()
                            currentTween = TweenService:Create(rootPart, TweenInfo.new(dist / 280, Enum.EasingStyle.Linear), {CFrame = enemyRoot.CFrame * CFrame.new(0, 25, 3)})
                            currentTween:Play()
                        else
                            stopCurrentTween()
                            rootPart.CFrame = enemyRoot.CFrame * CFrame.new(0, 15, 2)
                            
                            -- Usar ferramenta equipada (ataque básico) e soltar skills via VirtualUser
                            local vu = game:GetService("VirtualUser")
                            vu:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                            
                            for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
                                vu:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
                                task.wait(0.02)
                                game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
                            end
                        end
                    else
                        -- Aguardar spawn na área da ilha
                        stopCurrentTween()
                        local dist = (rootPart.Position - target.Farm_CFrame.Position).Magnitude
                        if dist > 15 then
                            currentTween = TweenService:Create(rootPart, TweenInfo.new(dist / 280, Enum.EasingStyle.Linear), {CFrame = target.Farm_CFrame})
                            currentTween:Play()
                        else
                            rootPart.CFrame = target.Farm_CFrame
                        end
                    end
                end
            end)
        end
    end
end)
