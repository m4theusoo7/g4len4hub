-- Função para encontrar o inimigo correto baseado no nível do jogador na Jungle
local function getTargetByLevel(playerLevel)
    local targetName = "Monkey"
    
    if playerLevel >= 15 then
        targetName = "Gorilla"
    end
    
    -- Prioridade especial para o Boss Gorilla King se o jogador tiver level 15+ e ele estiver vivo
    if playerLevel >= 15 then
        if workspace:FindFirstChild("Enemies") then
            for _, obj in pairs(workspace.Enemies:GetChildren()) do
                if obj.Name == "Gorilla King" and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                    return obj
                end
            end
        end
    end

    -- Procura o inimigo comum designado
    if workspace:FindFirstChild("Enemies") then
        for _, obj in pairs(workspace.Enemies:GetChildren()) do
            if obj.Name == targetName and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                return obj
            end
        end
    end
    
    return nil
end

-- Loop Principal
task.spawn(function()
    while _G.AutoFarm do
        task.wait()
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        
