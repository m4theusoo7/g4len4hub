-- ==========================================
-- SCRIPT AUTO FARM C/ MISSÃO (LVL 1 AO 10) 
-- Fix: Anti-Travamento (Sem Yield e com Pcall)
-- ==========================================

local player = game.Players.LocalPlayer
local vim = game:GetService("VirtualInputManager")
local ts = game:GetService("TweenService")
local rs = game:GetService("ReplicatedStorage")

_G.AutoFarm = true

-- Coordenadas
local banditSpawns = {
    Vector3.new(1000.87, 13.18, 1568.19),
    Vector3.new(922.15, 13.18, 1528.03),
    Vector3.new(1310.66, 13.47, 1593.06),
    Vector3.new(928.00, 13.18, 1597.26)
}

local junglePos = CFrame.new(-1246, 15, 1551)
local questGiverPos = Vector3.new(1060, 16.5, 1549)

-- Variável para controlar o Tween atual
local currentTween = nil

local function tweenTo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local distance = (char.HumanoidRootPart.Position - targetPos).Magnitude
    if distance < 3 then return end -- Já está no local
    
    local speed = 300
    local timeToReach = distance / speed
    
    -- Cancela o tween anterior se houver
    if currentTween then currentTween:Cancel() end
    
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    currentTween = ts:Create(char.HumanoidRootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    currentTween:Play()
end

local function cancelTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
end

local function autoAttackAndSkills()
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

local function getClosestBandit()
    local closest = nil
    local shortestDist = math.huge
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    for _, obj in pairs(workspace.Enemies:GetChildren()) do
        if obj.Name == "Bandit" and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 and obj:FindFirstChild("HumanoidRootPart") then
            local dist = (char.HumanoidRootPart.Position - obj.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closest = obj
            end
        end
    end
    return closest
end

local function hasQuest()
    local mainGui = player.PlayerGui:FindFirstChild("Main")
    if mainGui then
        local quest = mainGui:FindFirstChild("Quest")
        if quest and quest.Visible then
            return true
        end
    end
    return false
end

-- Loop Principal Seguro
task.spawn(function()
    while _G.AutoFarm do
        task.wait(0.1) -- Evita crash de FPS no executor
        
        -- O pcall impede que o script desligue se um bicho morrer do nada
        pcall(function()
            local char = player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local playerLevel = player.Data.Level.Value
            
            if playerLevel < 10 then
                if not hasQuest() then
                    -- 1. FASE DE MISSÃO
                    if (hrp.Position - questGiverPos).Magnitude > 8 then
                        tweenTo(questGiverPos)
                    else
                        cancelTween()
                        -- task.spawn evita que o InvokeServer trave o seu Executor
                        task.spawn(function()
                            rs.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                        end)
                        task.wait(1)
                    end
                else
                    -- 2. FASE DE FARM
                    local target = getClosestBandit()
                    
                    if target and target:FindFirstChild("HumanoidRootPart") then
                        local farmPos = target.HumanoidRootPart.CFrame * CFrame.new(0, 5, 4)
                        
                        if (hrp.Position - farmPos.Position).Magnitude > 8 then
                            tweenTo(farmPos.Position)
                        else
                            cancelTween() -- Chegou no bicho, para o tween
                            if target.Humanoid.Health > 0 then
                                hrp.CFrame = farmPos -- Trava nas costas do bicho
                                autoAttackAndSkills()
                            end
                        end
                    else
                        tweenTo(banditSpawns[1]) -- Vai pro meio se não achar bicho
                    end
                end
            else
                -- 3. VAI PARA A JUNGLE
                cancelTween()
                print("Level 10 alcançado! Teleportando para a Jungle...")
                hrp.CFrame = junglePos
                _G.AutoFarm = false 
            end
        end)
    end
end)
