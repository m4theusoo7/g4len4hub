local function fmtVec(v)
    return string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
end

local function isSea2QuestRelated(name)
    local low = string.lower(name or "")
    local keywords = {
        "detective", "military", "prison", "impel", "frozen", "ice",
        "admiral", "door", "gate", "key", "captain", "experienced",
        "middle", "dressrosa", "second", "sea", "warden", "chief"
    }
    for _, kw in ipairs(keywords) do
        if string.find(low, kw, 1, true) then
            return true
        end
    end
    return false
end

local detectedPositions = {
    Prison = Vector3.new(4854.17, 25.00, 740.19),
    IceAdmiral = Vector3.new(1347.70, 50.00, -1385.00),
    MiddleTown = Vector3.new(-651.00, 25.00, 1581.00)
}

local function RunScan()
    local lines = {}
    local function add(txt)
        table.insert(lines, txt)
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local playerPos = hrp and hrp.Position or Vector3.zero
    local data = LocalPlayer:FindFirstChild("Data")
    local lvl = data and data:FindFirstChild("Level") and data.Level.Value or 0

    add("=== OMEGACORE SCANNER (UNLOCK SEA 2) ===")
    add(string.format("[PLAYER] Lv.%d | %s", lvl, fmtVec(playerPos)))

    -- 0. Estado da DressrosaQuestProgress
    add("\n[QUEST STATUS]")
    if CommF then
        local ok, res = pcall(function()
            return CommF:InvokeServer("DressrosaQuestProgress")
        end)
        if ok then
            if type(res) == "table" then
                local parts = {}
                for k, v in pairs(res) do
                    table.insert(parts, tostring(k) .. "=" .. tostring(v))
                end
                add("- DressrosaQuestProgress: { " .. table.concat(parts, ", ") .. " }")
            else
                add("- DressrosaQuestProgress: " .. tostring(res))
            end
        else
            add("- DressrosaQuestProgress ERRO: " .. tostring(res))
        end
    end

    -- 1. Todas as Locations (para detectar nomes novos do Update 30)
    add("\n[LOCATIONS]")
    local worldOrigin = workspace:FindFirstChild("_WorldOrigin")
    local locations = worldOrigin and worldOrigin:FindFirstChild("Locations")
    if locations then
        for _, loc in ipairs(locations:GetChildren()) do
            if loc:IsA("BasePart") then
                add(string.format("- %s | %s", loc.Name, fmtVec(loc.Position)))
                local low = string.lower(loc.Name)
                if string.find(low, "prison", 1, true) or string.find(low, "impel", 1, true) then
                    detectedPositions.Prison = loc.Position + Vector3.new(0, 35, 0)
                elseif string.find(low, "frozen", 1, true) or string.find(low, "ice", 1, true) then
                    detectedPositions.IceAdmiral = loc.Position + Vector3.new(0, 35, 0)
                elseif string.find(low, "middle", 1, true) then
                    detectedPositions.MiddleTown = loc.Position + Vector3.new(0, 35, 0)
                end
            end
        end
    end

    -- 2. NPCs (Workspace + ReplicatedStorage)
    add("\n[NPCS]")
    local seenNpcs = {}
    local npcsFolder = workspace:FindFirstChild("NPCs")
    if npcsFolder then
        for _, npc in ipairs(npcsFolder:GetChildren()) do
            local nHrp = npc:FindFirstChild("HumanoidRootPart")
            if nHrp and (isSea2QuestRelated(npc.Name) or (nHrp.Position - playerPos).Magnitude <= 1500) then
                seenNpcs[npc.Name] = true
                add(string.format("- [WS] %s | %s", npc.Name, fmtVec(nHrp.Position)))
            end
        end
    end
    for _, obj in ipairs(ReplicatedStorage:GetChildren()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") and isSea2QuestRelated(obj.Name) and not seenNpcs[obj.Name] then
            add(string.format("- [RS] %s | %s", obj.Name, fmtVec(obj.HumanoidRootPart.Position)))
        end
    end

    -- 3. EnemySpawns (Ice Admiral / Prison / Frozen)
    add("\n[ENEMY SPAWNS]")
    local enemySpawns = worldOrigin and worldOrigin:FindFirstChild("EnemySpawns")
    if enemySpawns then
        local groups = {}
        for _, sp in ipairs(enemySpawns:GetChildren()) do
            if sp:IsA("BasePart") and (isSea2QuestRelated(sp.Name) or (sp.Position - playerPos).Magnitude <= 1200) then
                groups[sp.Name] = groups[sp.Name] or {}
                table.insert(groups[sp.Name], sp.Position)
            end
        end
        for mobName, posList in pairs(groups) do
            local sum = Vector3.zero
            for _, p in ipairs(posList) do sum += p end
            local avg = sum / #posList
            add(string.format("- %s (x%d) | Centro: %s", mobName, #posList, fmtVec(avg)))
            if string.find(string.lower(mobName), "ice admiral", 1, true) then
                detectedPositions.IceAdmiral = avg + Vector3.new(0, 20, 0)
            end
        end
    end

    -- 4. Portas / TouchTransmitters / ProximityPrompts proximos
    add("\n[PORTAS / INTERACOES]")
    local seenParts = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        local isDoorName = obj:IsA("BasePart") and (string.lower(obj.Name) == "door" or string.find(string.lower(obj:GetFullName()), "ice", 1, true))
        if obj:IsA("TouchTransmitter") or obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") or isDoorName then
            local part = obj:IsA("BasePart") and obj or (obj.Parent and (obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart")))
            if part and not seenParts[part] then
                local lowFull = string.lower(part:GetFullName())
                local isChest = string.find(lowFull, "chest", 1, true)
                local nearPlayer = (part.Position - playerPos).Magnitude <= 450
                local nearAdmiral = (part.Position - detectedPositions.IceAdmiral).Magnitude <= 350
                if not isChest and (nearPlayer or nearAdmiral) then
                    seenParts[part] = true
                    add(string.format("- [%s] %s | %s | CanCollide:%s", obj.ClassName, part:GetFullName(), fmtVec(part.Position), tostring(part.CanCollide)))
                end
            end
        end
    end

    -- 5. Enemies ativos
    add("\n[ENEMIES ATIVOS]")
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            local mHrp = mob:FindFirstChild("HumanoidRootPart")
            if mHrp and (isSea2QuestRelated(mob.Name) or (mHrp.Position - playerPos).Magnitude <= 800) then
                add(string.format("- %s | %s", mob.Name, fmtVec(mHrp.Position)))
            end
        end
    end

    return table.concat(lines, "\n")
end

