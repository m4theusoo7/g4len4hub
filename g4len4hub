-- Controle de Sessão (encerra loops e conexões de execuções anteriores no Delta)
local SessionId = tick()
_G.OmegaSessionId = SessionId
_G.AutoFarmPirateStarter = true

if _G.OmegaConnections then
    for _, conn in ipairs(_G.OmegaConnections) do
        pcall(function() conn:Disconnect() end)
    end
end
_G.OmegaConnections = {}

local Settings = {
    MaxLevel = 10,
    TweenSpeed = 200,
    DistanceFarm = 20,
    FastAttack = true,
    AttackDelay = 0.08,
    BringMob = true,
    BringRadius = 250,
    QuestName = "BanditQuest1",
    QuestLevel = 1,
    QuestNPCName = "Bandit Quest Giver",
    MobName = "Bandit",
    QuestNPC_Fallback = Vector3.new(1059.37, 16.5, 1550.42),
    MobSpawn_Pos = Vector3.new(1145.0, 17.0, 1634.0)
}

-- Serviços
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local LocalPlayer = Players.LocalPlayer

-- Estados de controle do avatar
local FlyActive = false
local GoalPos = nil
local LookDown = false

-- Anti-AFK
table.insert(_G.OmegaConnections, LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end))

-- Deixa o avatar 100% livre (remove forças de voo, Noclip e PlatformStand)
local function ReleaseAvatar()
    FlyActive = false
    GoalPos = nil
    LookDown = false

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.PlatformStand = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaFlyBV")
        if bv then bv:Destroy() end
        local bg = hrp:FindFirstChild("OmegaFlyBG")
        if bg then bg:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    for _, name in ipairs({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}) do
        local part = char:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

-- Noclip ativo APENAS enquanto FlyActive estiver ligado
table.insert(_G.OmegaConnections, RunService.Stepped:Connect(function()
    if _G.OmegaSessionId ~= SessionId or not _G.AutoFarmPirateStarter then return end
    if not FlyActive then return end

    local char = LocalPlayer.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and not hum.PlatformStand then
        hum.PlatformStand = true
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end))

-- Deslocamento suave a 200 studs/s apenas quando FlyActive = true
table.insert(_G.OmegaConnections, RunService.Heartbeat:Connect(function(dt)
    if _G.OmegaSessionId ~= SessionId or not _G.AutoFarmPirateStarter then
        ReleaseAvatar()
        return
    end

    if not FlyActive or not GoalPos then
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bv = hrp:FindFirstChild("OmegaFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "OmegaFlyBV"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.P = 9e9
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    else
        bv.Velocity = Vector3.zero
    end

    local bg = hrp:FindFirstChild("OmegaFlyBG")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "OmegaFlyBG"
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P = 9e9
        bg.Parent = hrp
    end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local currentPos = hrp.Position
    local diff = GoalPos - currentPos
    local dist = diff.Magnitude
    local step = Settings.TweenSpeed * dt

    local nextPos = (dist <= step or dist <= 2) and GoalPos or (currentPos + (diff.Unit * step))
    local targetCF = CFrame.new(nextPos)
    if LookDown then
        targetCF = targetCF * CFrame.Angles(math.rad(-90), 0, 0)
    end

    hrp.CFrame = targetCF
    bg.CFrame = targetCF
end))

-- Equipa Combat / Melee automaticamente
local function EquipMelee()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (equipped.ToolTip == "Melee" or equipped.Name == "Combat") then
        return equipped
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.Name == "Combat") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(tool)
                return tool
            end
        end
    end
    return equipped
end

-- Bring Mob ancorado acima do solo
local function BringEnemies(mainTarget)
    if not Settings.BringMob or not mainTarget then return end
    local mainHRP = mainTarget:FindFirstChild("HumanoidRootPart")
    if not mainHRP then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local safeY = math.max(mainHRP.Position.Y, 16.5)
    local anchorCFrame = CFrame.new(mainHRP.Position.X, safeY, mainHRP.Position.Z)
    mainHRP.CFrame = anchorCFrame
    mainHRP.AssemblyLinearVelocity = Vector3.zero

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return end

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if mob ~= mainTarget and string.find(mob.Name, Settings.MobName) then
            local mobHum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if mobHum and mobHum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                local dist = (mobHRP.Position - anchorCFrame.Position).Magnitude
                if dist <= Settings.BringRadius then
                    mobHRP.CFrame = anchorCFrame
                    mobHRP.AssemblyLinearVelocity = Vector3.zero
                    mobHum.WalkSpeed = 0
                    mobHum.JumpPower = 0
                end
            end
        end
    end
end

-- Busca o Bandit vivo mais próximo acima do chão
local function GetClosestBandit()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not hrp or not enemiesFolder then return nil end

    local closestMob = nil
    local shortestDist = math.huge

    for _, mob in ipairs(enemiesFolder:GetChildren()) do
        if string.find(mob.Name, Settings.MobName) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local mobHRP = mob:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and mobHRP and mobHRP.Position.Y > 5 then
                local dist = (hrp.Position - mobHRP.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = mob
                end
            end
        end
    end

    return closestMob
end

-- Retorna posição na frente do Bandit Quest Giver
local function GetQuestNPCPos()
    local wsNPCs = workspace:FindFirstChild("NPCs")
    local rsNPCs = ReplicatedStorage:FindFirstChild("NPCs")
    local questNPC = (wsNPCs and wsNPCs:FindFirstChild(Settings.QuestNPCName))
        or (rsNPCs and rsNPCs:FindFirstChild(Settings.QuestNPCName))

    local npcHRP = questNPC and questNPC:FindFirstChild("HumanoidRootPart")
    if npcHRP then
        return (npcHRP.CFrame * CFrame.new(0, 0, -4)).Position
    end
    return Settings.QuestNPC_Fallback
end

-- Verifica se a missão já está ativa na tela
local function HasActiveQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
    return questFrame and questFrame.Visible == true
end

-- Loop separado para Fast Attack (só ataca quando estiver na etapa de farm)
task.spawn(function()
    while _G.AutoFarmPirateStarter and _G.OmegaSessionId == SessionId do
        if Settings.FastAttack and HasActiveQuest() then
            pcall(function()
                local data = LocalPlayer:FindFirstChild("Data")
                if data and data.Level.Value >= Settings.MaxLevel then return end

                local target = GetClosestBandit()
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if target and hrp then
                    local targetHRP = target:FindFirstChild("HumanoidRootPart")
                    if targetHRP and (hrp.Position - targetHRP.Position).Magnitude <= (Settings.DistanceFarm + 15) then
                        local tool = EquipMelee()
                        if tool then
                            tool:Activate()
                        end
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton1(Vector2.new(1280, 672))
                    end
                end
            end)
        end
        task.wait(Settings.AttackDelay)
    end
end)

-- Loop Principal em Etapas (Ir ao NPC -> Soltar Avatar e Pegar Missão -> Farmar)
task.spawn(function()
    while _G.AutoFarmPirateStarter and _G.OmegaSessionId == SessionId do
        pcall(function()
            local data = LocalPlayer:FindFirstChild("Data")
            if not data then return end

            -- Finaliza ao atingir Level 10 e deixa o avatar livre
            if data.Level.Value >= Settings.MaxLevel then
                _G.AutoFarmPirateStarter = false
                ReleaseAvatar()
                print("[OmegaCore] Level 10 atingido! Avatar liberado.")
                return
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            if not HasActiveQuest() then
                -- ETAPA 1: Leva o avatar até a frente do NPC
                local npcPos = GetQuestNPCPos()
                local distToNPC = (hrp.Position - npcPos).Magnitude

                if distToNPC > 6 then
                    LookDown = false
                    GoalPos = npcPos
                    FlyActive = true
                else
                    -- ETAPA 2: Chegou no NPC -> Solta o avatar completamente e pega a missão
                    ReleaseAvatar()
                    task.wait(0.15)

                    pcall(function()
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", Settings.QuestName, Settings.QuestLevel)
                    end)

                    -- Aguarda até 2s a missão aparecer com o avatar livre
                    for _ = 1, 20 do
                        if HasActiveQuest() then break end
                        task.wait(0.1)
                    end
                end
            else
                -- ETAPA 3: Missão ativa -> Parte para o farm dos Bandits
                local target = GetClosestBandit()
                if target then
                    local targetHRP = target:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        EquipMelee()
                        BringEnemies(target)
                        local safeY = math.max(targetHRP.Position.Y, 16.5)
                        GoalPos = Vector3.new(targetHRP.Position.X, safeY + Settings.DistanceFarm, targetHRP.Position.Z)
                        LookDown = true
                        FlyActive = true
                    end
                else
                    -- Aguarda respawn 20 studs acima do centro dos Bandits
                    GoalPos = Settings.MobSpawn_Pos + Vector3.new(0, Settings.DistanceFarm, 0)
                    LookDown = false
                    FlyActive = true
                end
            end
        end)
        task.wait(0.1)
    end
end)
