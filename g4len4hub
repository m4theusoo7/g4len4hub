-- Anti-AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

local function ScanAndGetIsland()
    local playerLevel = 1
    pcall(function() playerLevel = LocalPlayer.Data.Level.Value end)
    for _, island in ipairs(Sea1Islands) do
        if playerLevel >= island.MinLevel and playerLevel <= island.MaxLevel then
            getgenv().OmegaConfig.CurrentIsland = island
            getgenv().OmegaConfig.TargetMob = island.MobName
            return island
        end
    end
    return Sea1Islands[1]
end

local function TweenTo(targetPos)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local distance = (targetPos - hrp.Position).Magnitude
    local speed = 310
    local tween = TweenService:Create(hrp, TweenInfo.new(distance / speed, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
    tween:Play()
end

-- FUNÇÃO CORRIGIDA: Força o equipamento da arma no inventário
local function EquipWeapon()
    pcall(function()
        local backpack = LocalPlayer.Backpack
        local char = LocalPlayer.Character
        if not char then return end
        
        -- Verifica se já tem algo na mão
        local currentTool = char:FindFirstChildOfClass("Tool")
        if not currentTool then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then
                    if tool.ToolTip == getgenv().OmegaConfig.WeaponType or tool.Name:find("Combat") or tool.Name:find("Melee") or #backpack:GetChildren() > 0 then
                        local humanoid = char:FindFirstChildOfClass("Humanoid")
                        if humanoid then
                            humanoid:EquipTool(tool)
                            break
                        end
                    end
                end
            end
        end
    end)
end

local function TriggerQuestRemotely()
    if tick() - getgenv().OmegaConfig.LastQuestCheck < 15 then return end
    getgenv().OmegaConfig.LastQuestCheck = tick()
    pcall(function()
        local island = getgenv().OmegaConfig.CurrentIsland
        if not island then return end
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        if commF then
            commF:InvokeServer("StartQuest", island.QuestName, 1)
        end
    end)
end

-- Disparo de Habilidades Seguro via VirtualUser
local function UseSkills()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(keys) do
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            vim:SendKeyEvent(false, key, false, game)
            task.wait(0.08)
        end
    end)
end

-- Loop Principal
task.spawn(function()
    while task.wait(0.3) do
        if getgenv().OmegaConfig.AutoFarm then
            local island = ScanAndGetIsland()
            TriggerQuestRemotely()
            EquipWeapon() -- Garante que a arma está sempre equipada
            
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local targetFound = false
                
                local enemiesFolder = Workspace:FindFirstChild("Enemies")
                if enemiesFolder then
                    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
                        if enemy.Name == getgenv().OmegaConfig.TargetMob then
                            local enemyHRP = enemy:FindFirstChild("HumanoidRootPart")
                            local enemyHum = enemy:FindFirstChild("Humanoid")
                            
                            if enemyHRP and enemyHum and enemyHum.Health > 0 then
                                targetFound = true
                                local combatPos = enemyHRP.Position + Vector3.new(0, 25, 0)
                                
                                if (hrp.Position - combatPos).Magnitude > 12 then
                                    TweenTo(combatPos)
                                else
                                    hrp.CFrame = CFrame.new(combatPos)
                                    
                                    -- Ataque básico contínuo otimizado para mobile
                                    VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                    
                                    -- Executa as skills Z, X, C, V
                                    UseSkills()
                                end
                                break
                            end
                        end
                    end
                end
                
                if not targetFound and island and island.Spawn then
                    if (hrp.Position - island.Spawn).Magnitude > 20 then
                        TweenTo(island.Spawn)
                    end
                end
            end
        end
    end
end)

