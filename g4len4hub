local _G = {
    AutoFarm = true,
    Distance = 300, -- Velocidade do voo (Tween)
}

-- Coordenadas Fornecidas:
local coords = {
    ProximaIlha = Vector3.new(-1141.2, 4.8, 3828.3),
    NPCQuest = Vector3.new(-1255.4, 11.8, 2154.2), -- Cabana Principal
    MonkeySpawn = Vector3.new(-1445.8, 50.8, 48.2),
    GorillaSpawn = Vector3.new(-1236.1, 6.2, 452.1),
    GorillaKingSpawn = Vector3.new(-1135.2, 23.9, 412.6)
}

-- ANTI-AFK: Previne que o Roblox desconecte
player.Idled:Connect(function()
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)

-- FUNÇÃO: Retorna o Nível Atual
local function getLevel()
    return player.Data.Level.Value
end

-- FUNÇÃO: Equipar Arma (Melee, Sword ou Blox Fruit)
local function equipWeapon()
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            player.Character.Humanoid:EquipTool(tool)
            break
        end
    end
end

-- FUNÇÃO: Movimentação suave (Tween) para evitar kick do Anti-Cheat
local function tweenTo(targetPos)
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")
    local distance = (hrp.Position - targetPos).Magnitude
    
    -- Se estiver perto, só usa CFrame direto para ser mais rápido
    if distance < 15 then
        hrp.CFrame = CFrame.new(targetPos)
        return
    end

    local info = TweenInfo.new(distance / _G.Distance, Enum.EasingStyle.Linear)
    local tween = ts:Create(hrp, info, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

-- FUNÇÃO: Verificar se já possui missão ativa
local function hasQuest()
    local questGui = player.PlayerGui.Main.Quest
    return questGui.Visible
end

-- FUNÇÃO: Pegar Missão via RemoteEvent
local function getQuest(questName, questNum)
    if not hasQuest() then
        -- Vai até o NPC
        tweenTo(coords.NPCQuest)
        task.wait(0.5)
        -- Envia o comando para o servidor te dar a missão
        game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questNum)
        task.wait(1) -- Aguarda a interface atualizar
    end
end

-- FUNÇÕES DE COMBATE: Ataque e Skills
local function autoAttack()
    vu:CaptureController()
    vu:ClickButton1(Vector2.new(800, 800))
end

local function useSkills()
    local skills = {"Z", "X", "C", "V"}
    for _, key in ipairs(skills) do
        vim:SendKeyEvent(true, Enum.KeyCode[key], false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, Enum.KeyCode[key], false, game)
    end
end

-- FUNÇÃO PRINCIPAL: Lógica de travar no inimigo e bater
local function farmEnemy(enemyName, fallbackPos)
    equipWeapon()
    
    local target = nil
    -- Procura o inimigo no workspace
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v.Name == enemyName and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            target = v
            break
        end
    end

    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if target and target:FindFirstChild("HumanoidRootPart") then
        -- Trava o personagem nas costas do inimigo (evita apanhar)
        hrp.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 2, 3)
        autoAttack()
        useSkills()
    else
        -- Se não achou o inimigo, vai para o respawn dele esperar
        tweenTo(fallbackPos)
    end
end
