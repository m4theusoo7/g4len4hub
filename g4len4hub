-- Auto Buy Water Kung Fu (Rota Aérea + Busca Real do NPC)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

local WhirlpoolPos = Vector3.new(3864.688, 6.736, -1926.214)
local UnderwaterEntrance = Vector3.new(61163.851, 11.679, 1819.784)
local FallbackTeacherPos = Vector3.new(61273.5, 18.4, 1565.2)

local TweenSpeed = 280
local activeConnection = nil

local function setMovementLock(state)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if state then
        if hum then
            hum.PlatformStand = true
        end
        if not activeConnection then
            activeConnection = RunService.Stepped:Connect(function()
                local c = LocalPlayer.Character
                local hrp = c and c:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
                if c then
                    for _, part in ipairs(c:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if activeConnection then
            activeConnection:Disconnect()
            activeConnection = nil
        end
        if hum then
            hum.PlatformStand = false
        end
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and (part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso") then
                    part.CanCollide = true
                end
            end
        end
    end
end

local function tweenTo(targetCFrame)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 4 then
        hrp.CFrame = targetCFrame
        return
    end

    local duration = distance / TweenSpeed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

local function isInsideUnderwater()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position.X > 50000
end

-- Procura o NPC tanto no Workspace quanto no ReplicatedStorage
local function findTeacherCFrame()
    local containers = {workspace:FindFirstChild("NPCs"), ReplicatedStorage:FindFirstChild("NPCs")}
    for _, folder in ipairs(containers) do
        if folder then
            for _, npc in ipairs(folder:GetChildren()) do
                if string.find(npc.Name, "Water Kung Fu") and npc:FindFirstChild("HumanoidRootPart") then
                    -- Fica 3 studs na frente e 2 acima para não enterrar no piso
                    return npc.HumanoidRootPart.CFrame * CFrame.new(0, 2, -3)
                end
            end
        end
    end
    return CFrame.new(FallbackTeacherPos + Vector3.new(0, 3, 0))
end

task.spawn(function()
    local beli = LocalPlayer:WaitForChild("Data"):WaitForChild("Beli").Value
    if beli < 750000 then
        warn("[OmegaCore] Beli insuficiente: $" .. tostring(beli))
        return
    end

    setMovementLock(true)

    -- 1. Entra na Underwater City
    if not isInsideUnderwater() then
        CommF:InvokeServer("requestEntrance", UnderwaterEntrance)
        task.wait(1.5)

        if not isInsideUnderwater() then
            tweenTo(CFrame.new(WhirlpoolPos + Vector3.new(0, 5, 0)))
            task.wait(0.3)
            CommF:InvokeServer("requestEntrance", UnderwaterEntrance)
            task.wait(1.5)
        end
    end

    -- 2. Rota aérea para não entrar no chão da praça do King Neptune
    if isInsideUnderwater() then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local targetCF = findTeacherCFrame()

        if hrp then
            -- Sobe para Y = 65 na posição atual
            tweenTo(CFrame.new(hrp.Position.X, 65, hrp.Position.Z))
            -- Voa por cima até ficar acima do NPC
            tweenTo(CFrame.new(targetCF.Position.X, 65, targetCF.Position.Z))
            -- Desce exatamente na frente do NPC
            tweenTo(targetCF)
        end

        task.wait(0.4)
        local response = CommF:InvokeServer("BuyFishmanKarate")
        print("[OmegaCore] Resposta da compra:", response)
    else
        warn("[OmegaCore] Falha ao entrar na Underwater City.")
    end

    task.wait(0.3)
    setMovementLock(false)
end)
