-- OmegaCore | Módulo: Desert Auto-Farm (Lv. 60 ao 90 - Missão + Sobrevivência)

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local TargetLevel = 90
local FarmHeight = 7 -- Distância vertical segura acima do NPC
local TweenSpeed = 250
local LowHealthThreshold = 60 -- HP mínimo para manter farmando; abaixo disso o módulo para

local SpawnPoints = {
    ["Desert Bandit"] = CFrame.new(932.5, 25.0, 4488.0),
    ["Desert Officer"] = CFrame.new(1572.0, 15.0, 4373.0),
}

local QuestNPCs = {
    ["Desert Bandit"] = CFrame.new(932.5, 25.0, 4488.0),
    ["Desert Officer"] = CFrame.new(1572.0, 15.0, 4373.0),
}

local Skills = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }
local AutoFarm = true

local farmTask
local skillTask
local noclipConnection

-- Para o módulo completamente: flag + noclip + tasks
local function stopAutoFarm()
    AutoFarm = false
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if farmTask then task.cancel(farmTask) farmTask = nil end
    if skillTask then task.cancel(skillTask) skillTask = nil end
end

-- Noclip enquanto o farm estiver ativo
noclipConnection = RunService.Stepped:Connect(function()
    if not AutoFarm then
        if noclipConnection then noclipConnection:Disconnect() end
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            part.CanCollide = false
        end
    end
end)

-- Leitura única do nível do jogador
local function getPlayerLevel()
    local data = LocalPlayer:FindFirstChild("Data")
    local level = data and data:FindFirstChild("Level")
    return level and level.Value or nil
end

local function getEnemyName(currentLevel)
    if currentLevel < 70 then
        return "Desert Bandit"
    end
    return "Desert Officer"
end

local function findEnemy(enemyName)
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        if enemy.Name == enemyName
            and enemy:FindFirstChild("Humanoid")
            and enemy.Humanoid.Health > 0
            and enemy:FindFirstChild("HumanoidRootPart") then
            return enemy
        end
    end
    return nil
end

local function equipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.Name == "Combat") then
            char.Humanoid:EquipTool(tool)
            break
        end
    end
end

local function moveTo(targetCFrame)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return
    end

    local info = TweenInfo.new(distance / TweenSpeed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, info, { CFrame = targetCFrame })
    tween:Play()
    tween.Completed:Wait()
end

local function basicAttack()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

-- CFrame de ataque: FarmHeight studs acima, olhando para o NPC
local function getAttackCFrame(enemy)
    local hrp = enemy:FindFirstChild("HumanoidRootPart")
    local pos = hrp.Position + Vector3.new(0, FarmHeight, 0)
    return CFrame.lookAt(pos, hrp.Position, Vector3.new(0, 1, 0))
end

-- ===== Missões =====
local function hasQuest(questKey)
    local data = LocalPlayer:FindFirstChild("Data")
    local quest = data and data:FindFirstChild("Quest")
    if not quest then return false end
    return quest.Value == questKey
end

local function acceptQuest(questKey)
    local npcPos = QuestNPCs[questKey]
    if not npcPos then return false end

    moveTo(npcPos)
    task.wait(2.5) -- tempo de chegada / prompt de interação

    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    task.wait(3) -- aguarda o diálogo/aceite

    return true
end

local function waitForQuest(questKey, timeout)
    local waited = 0
    while waited < timeout do
        task.wait(1)
        waited = waited + 1
        if hasQuest(questKey) then return true end
    end
    return false
end

-- ===== Loop de Skills =====
skillTask = task.spawn(function()
    while AutoFarm do
        local currentLevel = getPlayerLevel()
        if currentLevel and currentLevel >= TargetLevel then break end

        for _, key in ipairs(Skills) do
            if not AutoFarm then break end
            VirtualInputManager:SendKeyEvent(true, key, false, game)
            task.wait(0.1)
            VirtualInputManager:SendKeyEvent(false, key, false, game)
            task.wait(0.4)
        end
        task.wait(1)
    end
end)

-- ===== Loop Principal de Farm =====
farmTask = task.spawn(function()
    while AutoFarm do
        local currentLevel = getPlayerLevel() or 60

        -- Para o script automaticamente ao atingir o Level 90
        if currentLevel >= TargetLevel then
            AutoFarm = false
            print("[OmegaCore] Level 90 atingido! Auto-Farm do Deserto finalizado.")
            break
        end

        local enemyName = getEnemyName(currentLevel)

        -- [Missão] Coletar missão do NPC antes de farmar
        if not hasQuest(enemyName) then
            acceptQuest(enemyName)
            if not waitForQuest(enemyName, 20) then
                task.wait(2)
            end
        end

        local targetEnemy = findEnemy(enemyName)

        if not targetEnemy then
            -- Se não encontrar o NPC renderizado, vai até a área de spawn dele
            local spawnPos = SpawnPoints[enemyName]
            if spawnPos then
                moveTo(spawnPos)
            end
            task.wait(0.5)
        else
            equipWeapon()
            moveTo(getAttackCFrame(targetEnemy))

            -- Mantém travado em cima enquanto ataca
            while AutoFarm and targetEnemy and targetEnemy.Parent
                and targetEnemy:FindFirstChild("Humanoid")
                and targetEnemy.Humanoid.Health > 0 do

                local currentLevel = getPlayerLevel() or 60

                if currentLevel >= TargetLevel then
                    AutoFarm = false
                    break
                end

                -- Troca para Desert Officer assim que bater Level 70
                if getEnemyName(currentLevel) ~= enemyName then
                    break
                end

                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local humanoid = char and char:FindFirstChildWhichIsA("Humanoid")

                -- [Sobrevivência] Desliga o farm se a HP estiver crítica
                if humanoid and humanoid.Health <= LowHealthThreshold then
                    AutoFarm = false
                    break
                end

                if hrp and targetEnemy:FindFirstChild("HumanoidRootPart") then
                    hrp.CFrame = getAttackCFrame(targetEnemy)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end

                equipWeapon()
                basicAttack()

                -- [Eficiência] Sai do loop se o inimigo morreu
                if not (targetEnemy:FindFirstChild("Humanoid") and targetEnemy.Humanoid.Health > 0) then
                    break
                end

                task.wait(0.15)
            end
        end

        task.wait(0.1)
    end
end)
