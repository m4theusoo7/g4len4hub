--[[
    OmegaCore | Módulo: Brute (Vila dos Piratas)
    Nível Recomendado: 40 - 55
    Executor: Delta Executor
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

-- Configurações do Módulo
local Config = {
    Enabled = true,
    TargetNPC = "Brute",
    QuestName = "BuggyQuest1",
    QuestLevel = 2, -- 1 = Pirate, 2 = Brute, 3 = Bobby
    QuestCFrame = CFrame.new(-1141.07, 4.75, 3827.44), -- Pirate Adventurer
    SpawnWaitCFrame = CFrame.new(-1145.0, 14.8, 4300.0), -- Área central dos Brutes
    FarmOffset = CFrame.new(0, 7.5, 0) * CFrame.Angles(math.rad(-90), 0, 0), -- Fica acima do NPC atacando para baixo
    TweenSpeed = 300,
    UseSkills = true,
    Skills = {"Z", "X", "C", "V"}
}

-- Anti-AFK integrado
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Noclip contínuo enquanto o farm estiver ativo
RunService.Stepped:Connect(function()
    if Config.Enabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Movimentação suave via TweenService
local function TweenTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    
    if distance < 15 then
        hrp.CFrame = targetCFrame
        return
    end
    
    local duration = distance / Config.TweenSpeed
    local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- Verifica se a missão já está ativa na UI
local function HasQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    
    local mainGui = playerGui:FindFirstChild("Main")
    if mainGui and mainGui:FindFirstChild("Quest") then
        local questFrame = mainGui.Quest
        if questFrame.Visible and string.find(questFrame.Container.QuestTitle.Title.Text, Config.TargetNPC) then
            return true
        end
    end
    return false
end

-- Pega a missão diretamente via RemoteFunction
local function GetQuest()
    TweenTo(Config.QuestCFrame)
    task.wait(0.2)
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", Config.QuestName, Config.QuestLevel)
    end)
end

-- Equipa o estilo de luta / espada principal automaticamente
local function EquipWeapon()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not char or not backpack then return end
    
    -- Se já estiver segurando uma ferramenta de combate, mantém
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            return
        end
    end
    
    -- Prioriza Melee na mochila
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then
            char.Humanoid:EquipTool(tool)
            return
        end
    end
end

-- Dispara ataques básicos e skills
local function AttackAndSkills()
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(1280, 672))
    
    if Config.UseSkills then
        for _, key in ipairs(Config.Skills) do
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
        end
    end
end

-- Busca o Brute vivo mais próximo
local function FindNearestBrute()
    local enemies = workspace:FindFirstChild("Enemies")
    local char = LocalPlayer.Character
    if not enemies or not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    
    local hrp = char.HumanoidRootPart
    local closest = nil
    local shortestDist = math.huge
    
    for _, npc in ipairs(enemies:GetChildren()) do
        if string.find(npc.Name, Config.TargetNPC) then
            local hum = npc:FindFirstChild("Humanoid")
            local npcHrp = npc:FindFirstChild("HumanoidRootPart")
            if hum and npcHrp and hum.Health > 0 then
                local dist = (hrp.Position - npcHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = npc
                end
            end
        end
    end
    
    return closest
end

-- Loop Principal
task.spawn(function()
    while Config.Enabled do
        task.wait(0.1)
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                return
            end
            
            if not HasQuest() then
                GetQuest()
            else
                local target = FindNearestBrute()
                if target and target:FindFirstChild("HumanoidRootPart") then
                    EquipWeapon()
                    
                    -- Mantém o personagem travado acima do Brute enquanto ele estiver vivo
                    while Config.Enabled and HasQuest() and target.Parent and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 do
                        local targetPos = target.HumanoidRootPart.CFrame * Config.FarmOffset
                        char.HumanoidRootPart.CFrame = targetPos
                        
                        -- Trava o NPC no lugar para facilitar o acerto
                        target.HumanoidRootPart.CanCollide = false
                        target.HumanoidRootPart.Size = Vector3.new(40, 40, 40)
                        
                        AttackAndSkills()
                        task.wait(0.1)
                    end
                else
                    -- Caso todos os Brutes estejam mortos, aguarda no ponto de spawn
                    TweenTo(Config.SpawnWaitCFrame)
                end
            end
        end)
    end
end)
