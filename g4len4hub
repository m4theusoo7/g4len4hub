local Portals = {
    Underwater = Vector3.new(3864.85, 6.68, -1926.78),
    Skylands = Vector3.new(-4607.82, 872.54, -1667.56)
}

local function GetTargetData()
    local lvl = Player.Data.Level.Value
    for _, data in ipairs(Sea1Data) do
        if lvl >= data.min and lvl <= data.max then return data end
    end
    return Sea1Data[#Sea1Data]
end

local function HasQuest()
    local questGui = Player.PlayerGui.Main:FindFirstChild("Quest")
    return questGui and questGui.Visible
end

-- Novo Tween com sistema de Timeout para desbugar se travar
local isTweening = false
local function TweenTo(targetVector)
    local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if not root or isTweening then return end
    
    local distance = (root.Position - targetVector).Magnitude
    if distance < 15 then return end -- Já chegou
    
    -- Bypass Portais
    if targetVector.X > 50000 and root.Position.X < 10000 then
        root.CFrame = CFrame.new(Portals.Underwater)
        task.wait(0.5)
    elseif targetVector.Y > 4000 and root.Position.Y < 2000 then
        root.CFrame = CFrame.new(Portals.Skylands)
        task.wait(0.5)
    end
    
    isTweening = true
    local speed = 300
    local info = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = game:GetService("TweenService"):Create(root, info, {CFrame = CFrame.new(targetVector)})
    
    tween:Play()
    tween.Completed:Connect(function()
        isTweening = false
    end)
    
    -- Timeout de segurança (se a viagem demorar mais que o tempo calculado + 2s, ele reseta o estado)
    task.delay((distance / speed) + 2, function()
        isTweening = false
    end)
    
    -- Espera o tween terminar sem travar o loop completamente
    repeat task.wait() until not isTweening or not _G.AutoFarm
end

local function EquipWeapon()
    for _, tool in ipairs(Player.Backpack:GetChildren()) do
        if tool.ToolTip == _G.WeaponName or tool.Name == _G.WeaponName then
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

local lastSkillTime = 0
local function AutoCombat(targetHRP)
    EquipWeapon()
    -- Posiciona exatos 5 studs ACIMA do inimigo
    Player.Character.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 5, 0)
    
    if _G.AutoAttack then
        VU:CaptureController()
        VU:ClickButton1(Vector2.new(851, 158), workspace.CurrentCamera.CFrame)
    end
    
    if _G.AutoSkills and (tick() - lastSkillTime > _G.SkillDelay) then
        local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
        for _, key in ipairs(keys) do
            VIM:SendKeyEvent(true, key, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, key, false, game)
        end
        lastSkillTime = tick()
    end
end

-- O Segredo: Loop no RunService (NoClip + Flutuar perfeito)
RunService.Stepped:Connect(function()
    if _G.AutoFarm and Player.Character then
        local hrp = Player.Character:FindFirstChild("HumanoidRootPart")
        
        -- NOCLIP ATIVO: Atravessa ilhas e paredes sem bater
        for _, part in pairs(Player.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
        
        -- FLOAT FIX: Impede o boneco de cair no mar
        if hrp and not hrp:FindFirstChild("Float") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "Float"
            bv.Parent = hrp
            bv.MaxForce = Vector3.new(0, 100000, 0)
            bv.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Loop Mestre de Farm
task.spawn(function()
    while task.wait() do
        if not _G.AutoFarm or not Player.Character or not Player.Character:FindFirstChild("HumanoidRootPart") then continue end
        if isTweening then continue end -- Espera chegar antes de agir
        
        local data = GetTargetData()
        
        if not HasQuest() then
            local hrp = Player.Character.HumanoidRootPart
            if (hrp.Position - data.npc).Magnitude > 15 then
                TweenTo(data.npc)
            else
                local npcModel = workspace.NPCs:FindFirstChild(data.mob .. " Quest Giver") or workspace.NPCs:FindFirstChild("Quest Giver")
                if npcModel and npcModel:FindFirstChild("Head") then
                    hrp.CFrame = npcModel.Head.CFrame
                end
                
                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", data.mob .. "Quest", 1)
                task.wait(1)
            end
        else
            local mobFound = false
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if string.find(v.Name, data.mob) and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                    mobFound = true
                    AutoCombat(v.HumanoidRootPart)
                    break
                end
            end
            
            if not mobFound then
                local hrp = Player.Character.HumanoidRootPart
                if (hrp.Position - data.spawn).Magnitude > 15 then
                    TweenTo(data.spawn)
                end
            end
        end
    end
end)
