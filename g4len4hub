-- 2. LEITURA DE LEVEL
local function GetCurrentFarmData()
    local myLevel = player.Data.Level.Value
    for _, data in ipairs(FarmGuide) do
        if myLevel >= data.min and myLevel <= data.max then
            return data
        end
    end
    return FarmGuide[#FarmGuide]
end

-- 3. MOVIMENTAÇÃO (TWEEN)
local function TweenTo(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local speed = 320 -- Velocidade otimizada para o Delta
    
    -- Se estiver muito perto, teletransporta direto para não bugar o Tween
    if distance < 5 then
        hrp.CFrame = targetCFrame
        return
    end
    
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = tweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tween:Play()
    tween.Completed:Wait()
end

-- 4. VARREDURA DE INIMIGOS
local function GetClosestMob(mobName)
    local closestMob = nil
    local shortestDist = math.huge
    local char = player.Character
    
    if char and char:FindFirstChild("HumanoidRootPart") then
        local myPos = char.HumanoidRootPart.Position
        for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
            if enemy.Name == mobName and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                local dist = (myPos - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestMob = enemy
                end
            end
        end
    end
    return closestMob
end

-- 5. VALIDAÇÃO DE MISSÃO
local function HasActiveQuest()
    local gui = player.PlayerGui
    if gui:FindFirstChild("Main") and gui.Main:FindFirstChild("Quest") then
        return gui.Main.Quest.Visible
    end
    return false
end

-- 6. MOTOR DE COMBATE
local function AutoAttack()
    virtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    virtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

local function FireSkill(key)
    virtualInput:SendKeyEvent(true, Enum.KeyCode[key], false, game)
    task.wait(0.1)
    virtualInput:SendKeyEvent(false, Enum.KeyCode[key], false, game)
end

local function EquipWeapon()
    local char = player.Character
    if not char then return end
    for _, tool in ipairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == getgenv().OmegaConfig.WeaponType then
            char.Humanoid:EquipTool(tool)
        end
    end
end

-- 7. NOCLIP CONSTANTE (Prevenção de travamento no mapa)
runService.Stepped:Connect(function()
    if getgenv().OmegaConfig.AutoFarm then
        local char = player.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            -- Trava a câmera e a queda caso esteja caindo no void
            if char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Velocity.Y < -50 then
                char.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
            end
        end
    end
end)

