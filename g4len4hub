local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local TweenSpeed = 200
local QuestName = "BanditQuest1"
local QuestLevel = 1
local FallbackNPC_CFrame = CFrame.new(1062, 16, 1546)

-- Verifica se a missão já está ativa
local function HasQuest()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("Main")
    local questFrame = mainGui and mainGui:FindFirstChild("Quest")
    return questFrame and questFrame.Visible == true
end

-- Retorna a posição na frente do NPC (ou a coordenada fixa de reserva)
local function GetNPCTargetCFrame()
    local wsNPCs = workspace:FindFirstChild("NPCs")
    local rsNPCs = ReplicatedStorage:FindFirstChild("NPCs")
    local npc = (wsNPCs and wsNPCs:FindFirstChild("Bandit Quest Giver"))
        or (rsNPCs and rsNPCs:FindFirstChild("Bandit Quest Giver"))

    local npcHRP = npc and npc:FindFirstChild("HumanoidRootPart")
    if npcHRP then
        return npcHRP.CFrame * CFrame.new(0, 0, -4)
    end
    return FallbackNPC_CFrame
end

-- Libera 100% o avatar (remove antigravidade, restaura colisão e solta o Humanoid)
local function ReleaseAvatar(char, noclipConn)
    if noclipConn then
        noclipConn:Disconnect()
    end
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.PlatformStand = false
    end

    if hrp then
        local bv = hrp:FindFirstChild("TempQuestBV")
        if bv then bv:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    for _, partName in ipairs({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso"}) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

-- Execução única
local function RunOnce()
    if HasQuest() then
        print("[OmegaCore] Missão já está ativa. Script encerrado.")
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    local targetCF = GetNPCTargetCFrame()
    local distance = (hrp.Position - targetCF.Position).Magnitude

    if distance > 6 then
        -- Ativa Noclip + antigravidade apenas durante o trajeto
        local noclipConn = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)

        local bv = Instance.new("BodyVelocity")
        bv.Name = "TempQuestBV"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp

        local duration = distance / TweenSpeed
        local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCF })
        tween:Play()
        tween.Completed:Wait()

        -- Solta o avatar assim que chega no NPC
        ReleaseAvatar(char, noclipConn)
    end

    task.wait(0.15)

    -- Pega a missão uma única vez
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", QuestName, QuestLevel)
    end)

    -- Aguarda até 2 segundos pela confirmação visual e encerra o script
    for _ = 1, 20 do
        if HasQuest() then
            break
        end
        task.wait(0.1)
    end

    print("[OmegaCore] Missão pega e avatar livre. Script finalizado.")
end

RunOnce()
