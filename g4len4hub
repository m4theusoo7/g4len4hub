		parentTarget = LocalPlayer:WaitForChild("PlayerGui")
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "IceAdmiralCompactHUD"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 999
	gui.Parent = parentTarget

	local frame = Instance.new("Frame")
	frame.Name = "Container"
	frame.Size = UDim2.fromOffset(310, 74)
	frame.Position = UDim2.new(0.5, -155, 0, 8)
	frame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
