local TweenService = game:GetService("TweenService")
local player = game.Players.LocalPlayer

local function irAteNPC(Bandit [Lv. 5])
    -- Procura o NPC na pasta de NPCs ou de Inimigos
    local npc = workspace.NPCs:FindFirstChild(nomeDoNPC) or workspace.Enemies:FindFirstChild(nomeDoNPC)
    
    if npc and npc:FindFirstChild("HumanoidRootPart") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local destino = npc.HumanoidRootPart.CFrame
        
        -- Calcula o tempo baseado na distância para não ser pego pelo anti-cheat
        local distancia = (hrp.Position - destino.Position).Magnitude
        local velocidade = 300 -- Velocidade do voo (ajuste se necessário)
        local tempo = distancia / velocidade
        
        local tweenInfo = TweenInfo.new(tempo, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destino})
        
        tween:Play()
        return tween -- Retorna o tween caso queira usar tween.Completed:Wait()
    else
        warn("NPC não encontrado no mapa.")
    end
end

-- Exemplo de uso:
irAteNPC("Bandit Quest Giver") -- Substitua pelo nome exato do NPC
