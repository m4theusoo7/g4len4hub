local player = game.Players.LocalPlayer
local vim = game:GetService("VirtualInputManager")
local ts = game:GetService("TweenService")
local rs = game:GetService("ReplicatedStorage")

_G.AutoFarm = true

-- Coordenadas extraídas da sua varredura (Bandits)
local banditSpawns = {
    Vector3.new(1000.87, 13.18, 1568.19),
    Vector3.new(922.15, 13.18, 1528.03),
    Vector3.new(1310.66, 13.47, 1593.06),
    Vector3.new(928.00, 13.18, 1597.26),
    Vector3.new(1280.75, 13.47, 1528.91),
    Vector3.new(1254.71, 13.18, 1623.05),
    Vector3.new(1203.57, 13.18, 1563.34),
    Vector3.new(1147.22, 13.18, 1676.80),
    Vector3.new(1210.01, 13.18, 1673.53),
    Vector3.new(1114.26, 13.18, 1590.18)
}

local junglePos = Vector3.new(-1246, 15, 1551) -- Coordenada padrão da Jungle

-- Função de movimentação segura (Tween)
local function tweenTo(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local distance = (char.HumanoidRootPart.Position - targetPos).Magnitude
    local speed = 300 -- Velocidade do Tween
    local timeToReach = distance / speed
    
    local tweenInfo = TweenInfo.new(timeToReach, Enum.EasingStyle.Linear)
    local tween = ts:Create(char.HumanoidRootPart, tweenInfo, {CFrame = CFrame.new(targetPos)})
    tween:Play()
    tween.Completed:Wait()
end

-- Função para usar Skills e Ataque Básico
local function autoAttackAndSkills()
    -- Clica para atacar
    vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    
    -- Ativa as skills Z, X, C, V
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(keys) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.1)
        vim:SendKeyEvent(false, key, false, game)
    end
end

-- Função para encontrar um Bandit vivo perto das coordenadas mapeadas
local function getClosestBandit()
    for _, obj in pairs(workspace.Enemies:GetChildren()) do
        if obj.Name == "Bandit" and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
            return obj
        end
    end
    return nil
end

-- Verifica se a interface de Quest está ativa na tela do jogador
local function hasQuest()
    local gui = player.PlayerGui:FindFirstChild("Main")
    if gui and gui:FindFirstChild("Quest") then
        return gui.Quest.Visible
    end
    return false
end

-- Função para pegar a Missão dos Bandits via Remote Event
local function takeQuest()
    -- Voa para perto do Quest Giver por segurança (usando a coordenada que você escaneou)
    tweenTo(Vector3.new(1059.3, 16.1, 1549.2)) 
    
    local args = {
        [1] = "StartQuest",
        [2] = "BanditQuest1",
        [3] = 1
    }
    rs.Remotes.CommF_:InvokeServer(unpack(args))
end

-- Loop Principal
task.spawn(function()
    while _G.AutoFarm do
        task.wait()
        
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then continue end
        
        local playerLevel = player.Data.Level.Value
        
        if playerLevel < 10 then
            -- Verifica se TEM a missão, caso não, ele pega
            if not hasQuest() then
                takeQuest()
                task.wait(0.5) -- Pausa rápida para a missão registrar
            else
                -- Lógica de Farm nos Bandits (só executa se já tiver com a missão)
                local target = getClosestBandit()
                
                if target and target:FindFirstChild("HumanoidRootPart") then
                    -- Voa para trás das costas do Bandit para não tomar dano
                    local farmPos = target.HumanoidRootPart.CFrame * CFrame.new(0, 5, 4)
                    tweenTo(farmPos.Position)
                    
                    -- Bate e solta skill enquanto o bicho estiver vivo
                    if target.Humanoid.Health > 0 then
                        char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, target.HumanoidRootPart.Position)
                        autoAttackAndSkills()
                    end
                else
                    -- Se não achar nenhum vivo, voa para o primeiro ponto de spawn e aguarda
                    tweenTo(banditSpawns[1])
                    task.wait(1)
                end
            end
        else
            -- Chegou ao Level 10 - Vai para a Jungle
            print("Level 10 alcançado! Indo para a Jungle...")
            tweenTo(junglePos)
            _G.AutoFarm = false -- Desliga o loop para você continuar manualmente na Jungle
        end
    end
end)
