_G.OmegaSea2_Missao3_Boss = true

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
local CommF = Remotes and Remotes:FindFirstChild("CommF_")

local Config = {
    IceAdmiralFallback = Vector3.new(1347.70, 37.30, -1385.00),
    TweenSpeed = 225,
    SafeHoverHeight = 7.5 -- Alto o suficiente para nao tomar dano e perto para skills acertarem
}

local CurrentTween = nil
local LastTweenTarget = nil
local LastSkillTime = 0
local SkillIndex = 1
local SkillKeys = { Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }

-- Barra de status no topo
local parentGui = (gethui and gethui()) or game:GetService("CoreGui")
if parentGui:FindFirstChild("OmegaSea2Missao3UI") then
    parentGui.OmegaSea2Missao3UI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "OmegaSea2Missao3UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = parentGui

local StatusBox = Instance.new("TextLabel")
StatusBox.Size = UDim2.new(0, 370, 0, 56)
StatusBox.Position = UDim2.new(0.5, -185, 0, 12)
StatusBox.BackgroundColor3 = Color3.fromRGB(18, 20, 26)
StatusBox.TextColor3 = Color3.fromRGB(120, 255, 160)
StatusBox.Font = Enum.Font.GothamBold
StatusBox.TextSize = 11
StatusBox.TextWrapped = true
StatusBox.BorderSizePixel = 0
StatusBox.Text = "[Missao 3] Iniciando..."
StatusBox.Parent = ScreenGui

local function setStatus(msg, color)
    StatusBox.Text = msg
    if color then
        StatusBox.TextColor3 = color
    end
end

local function checkAndEnableAura()
    local char = LocalPlayer.Character
    if not char then return false end
    if char:FindFirstChild("HasBuso") then
        return true
    end
    if CommF then
        pcall(function()
            CommF:InvokeServer("Buso")
        end)
        task.wait(0.25)
    end
    return char:FindFirstChild("HasBuso") ~= nil
end

local function getToolsByCategory()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    local list = {}
    for _, container in ipairs({ char, bp }) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    list[item.ToolTip] = item
                    if item.Name == "Combat" then
                        list["Melee"] = item
                    end
                end
            end
        end
    end
    return list
end

local function cancelTween()
    if CurrentTween then
        CurrentTween:Cancel()
        CurrentTween = nil
    end
    LastTweenTarget = nil
end

local function setPhysics(character, enabled)
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and enabled then hum.Sit = false end

    if hrp then
        local bv = hrp:FindFirstChild("OmegaBossBV")
        if enabled then
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "OmegaBossBV"
                bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                bv.Velocity = Vector3.zero
                bv.Parent = hrp
            end
        elseif bv then
            bv:Destroy()
        end
    end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not enabled
        end
    end
end

local function tweenToCFrame(hrp, targetCFrame, snapAtEnd)
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist <= 4 then
        cancelTween()
        if snapAtEnd then hrp.CFrame = targetCFrame end
        return true
    end
    if CurrentTween and CurrentTween.PlaybackState == Enum.PlaybackState.Playing and LastTweenTarget and (LastTweenTarget - targetCFrame.Position).Magnitude <= 4 then
        return false
    end
    cancelTween()
    LastTweenTarget = targetCFrame.Position
    CurrentTween = TweenService:Create(hrp, TweenInfo.new(math.max(dist / Config.TweenSpeed, 0.06), Enum.EasingStyle.Linear), {
        CFrame = targetCFrame
    })
    CurrentTween:Play()
    return false
end

local function getActiveIceAdmiral()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end
    for _, mob in ipairs(enemies:GetChildren()) do
        if string.find(string.lower(mob.Name), "ice admiral", 1, true) then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                return mob
            end
        end
    end
    return nil
end

local noclipConn = RunService.Stepped:Connect(function()
    if not _G.OmegaSea2_Missao3_Boss then return end
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    local hasAura = checkAndEnableAura()
    local tools = getToolsByCategory()

    -- Se nao tiver Haki (Aura), prioriza Fruta (que acerta Logia) ou avisa para comprar Aura
    if not hasAura and not tools["Blox Fruit"] then
        setStatus("VOCE NAO TEM HAKI (AURA)! Compre Aura por $25.000 no Ability Teacher da caverna de gelo para acertar o Ice Admiral.", Color3.fromRGB(255, 110, 90))
        _G.OmegaSea2_Missao3_Boss = false
        noclipConn:Disconnect()
        return
    end

    local preferredTool = (not hasAura and tools["Blox Fruit"]) or tools["Melee"] or tools["Sword"] or tools["Blox Fruit"]

    while _G.OmegaSea2_Missao3_Boss do
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = char:WaitForChild("HumanoidRootPart")
        local hum = char:WaitForChild("Humanoid")

        if hum.Health <= 0 then
            cancelTween()
            task.wait(0.5)
        else
            setPhysics(char, true)
            if hasAura and not char:FindFirstChild("HasBuso") then
                checkAndEnableAura()
            end

            local boss = getActiveIceAdmiral()
            if boss and boss:FindFirstChild("HumanoidRootPart") and boss:FindFirstChildOfClass("Humanoid") then
                local bossHrp = boss.HumanoidRootPart
                local bossHum = boss:FindFirstChildOfClass("Humanoid")

                -- Posicao segura acima do boss para evitar os golpes dele
                local hoverPos = bossHrp.Position + Vector3.new(0, Config.SafeHoverHeight, 0)
                local arrived = tweenToCFrame(hrp, CFrame.lookAt(hoverPos, bossHrp.Position), true)

                if arrived or (hrp.Position - bossHrp.Position).Magnitude <= 14 then
                    if preferredTool and preferredTool.Parent ~= char then
                        hum:EquipTool(preferredTool)
                    end

                    local cam = workspace.CurrentCamera
                    if cam then
                        cam.CFrame = CFrame.new(cam.CFrame.Position, bossHrp.Position)
                    end

                    -- Ataque basico nativo da Tool (se tiver Aura)
                    if hasAura and preferredTool then
                        pcall(function()
                            preferredTool:Activate()
                        end)
                    end

                    -- Dispara skills Z, X, C, V
                    if (os.clock() - LastSkillTime) >= 0.9 then
                        LastSkillTime = os.clock()
                        local key = SkillKeys[SkillIndex]
                        SkillIndex = (SkillIndex % #SkillKeys) + 1
                        pcall(function()
                            VirtualInputManager:SendKeyEvent(true, key, false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, key, false, game)
                        end)
                    end

                    setStatus(
                        string.format("Atacando Ice Admiral | HP: %d/%d | Aura: %s | Item: %s",
                            math.floor(bossHum.Health), math.floor(bossHum.MaxHealth),
                            hasAura and "ATIVA" or "SEM AURA (Usando Fruta)",
                            preferredTool and preferredTool.Name or "Nenhum"),
                        Color3.fromRGB(120, 200, 255)
                    )
                end
            else
                if CommF then
                    local ok, prog = pcall(function()
                        return CommF:InvokeServer("DressrosaQuestProgress")
                    end)
                    if ok and type(prog) == "table" and prog.KilledIceAdmiral then
                        cancelTween()
                        setStatus("SUCESSO! Ice Admiral derrotado. Me avise para a Parte 4!", Color3.fromRGB(120, 255, 160))
                        break
                    end
                end

                local waitPos = Config.IceAdmiralFallback + Vector3.new(0, 12, 0)
                if (hrp.Position - waitPos).Magnitude > 10 then
                    setStatus("Indo ate a caverna de Frozen Village...", Color3.fromRGB(255, 215, 90))
                    tweenToCFrame(hrp, CFrame.new(waitPos), false)
                else
                    cancelTween()
                    hrp.CFrame = CFrame.new(waitPos)
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    setStatus("Na caverna. Aguardando respawn do Ice Admiral...", Color3.fromRGB(255, 215, 90))
                end
            end

            RunService.Heartbeat:Wait()
        end
    end

    _G.OmegaSea2_Missao3_Boss = false
    if noclipConn then noclipConn:Disconnect() end
    cancelTween()
    setPhysics(LocalPlayer.Character, false)
end)
