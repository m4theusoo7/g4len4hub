                local questCFrame = CFrame.new(pos_Pirate_Adventurer)
                TP(questCFrame)
                
                -- Se chegou no NPC, pega a quest
                if (char.HumanoidRootPart.Position - pos_Pirate_Adventurer).Magnitude < 15 then
                    PegarQuest()
                    task.wait(0.5) -- Pausa rápida para o servidor registrar a quest
                end
            else
                -- 3. Procura o Monstro Vivo
                local mobTarget = nil
                
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
