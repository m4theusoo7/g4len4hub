local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local char = LocalPlayer.Character
local hrp = char:WaitForChild("HumanoidRootPart")

-- 1. Procura a cortina real dentro do mapa do Deserto
local desert = workspace:WaitForChild("Map"):WaitForChild("Desert")
local burnPart = nil

for _, obj in ipairs(desert:GetDescendants()) do
    if obj.Name == "Burn" and obj:IsA("BasePart") then
        burnPart = obj
        break
    end
end

if not burnPart then
    warn("[OmegaCore] Objeto 'Burn' não encontrado no Desert! A cortina já pode estar queimada.")
    return
end

print("[OmegaCore] Cortina encontrada em:", burnPart.Position)

-- 2. Equipa a Tocha
local torch = char:FindFirstChild("Torch") or LocalPlayer.Backpack:FindFirstChild("Torch")
if not torch then
    warn("[OmegaCore] Você não está com a Torch no inventário!")
    return
end
char.Humanoid:EquipTool(torch)
task.wait(0.3)

-- 3. Cola exatamente na cortina e força o toque usando a Handle da Tocha e o HRP
hrp.CFrame = burnPart.CFrame
task.wait(0.2)

local handle = torch:FindFirstChild("Handle")
for i = 1, 5 do
    hrp.CFrame = burnPart.CFrame
    if firetouchinterest then
        pcall(function()
            if handle then
                firetouchinterest(handle, burnPart, 0)
                task.wait(0.05)
                firetouchinterest(handle, burnPart, 1)
            end
            firetouchinterest(hrp, burnPart, 0)
            task.wait(0.05)
            firetouchinterest(hrp, burnPart, 1)
        end)
    end
    task.wait(0.3)
end

print("[OmegaCore] Tentativa de queimar concluída! Transparência da cortina:", burnPart.Transparency)
