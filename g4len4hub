-- =======================================================
-- BLOX FRUITS - AUTO FARM PIRATE STARTER V2 (CORRIGIDO)
-- Foco: Pegar missão e ATACAR de verdade (Level 1 ao 10)
-- =======================================================

local player = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- [1] Anti-AFK Otimizado
local vu = game:GetService("VirtualUser")
player.Idled:Connect(function()
    vu:CaptureController()
    vu:ClickButton2(Vector2.new())
end)

-- [2] Função para Equipar e Retornar o Estilo de Luta
local function equiparMelee()
    -- Procura na mochila
    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then
            player.Character.Humanoid:EquipTool(tool)
            return tool
        end
    end
    -- Procura se já está na mão
    for _, tool in pairs(player.Character:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then
            return tool
        end
    end
    return nil
end

-- [3] Função para Checar se a Missão está Ativa
local function temMissao()
    local questGui = player.PlayerGui.Main:FindFirstChild("Quest")
    if questGui and questGui.Visible then
        return true
    end
    return false
end

-- [4] Função para Encontrar o Bandit VIVO mais próximo
local function acharBandit()
    for _, inimigo in pairs(workspace.Enemies:GetChildren()) do
        -- string.find resolve o problema do "[Lv. 5]" no nome
        if string.find(inimigo.Name, "Bandit") and inimigo:FindFirstChild("Humanoid") and inimigo.Humanoid.Health > 0 and inimigo:FindFirstChild("HumanoidRootPart") then
            return inimigo
        end
    end
    return nil
end

local farmAtivo = true

-- [5] Loop de Farm (Usando task.spawn para não travar o jogo)
task.spawn(function()
    while farmAtivo and task.wait() do
        
        -- Verifica se atingiu a meta (Level 10)
        if player.Data.Level.Value >= 10 then
            farmAtivo = false
            print("===================================")
            print("NÍVEL 10 ATINGIDO! Pode ir pra Jungle.")
            print("===================================")
            break
        end

        if not temMissao() then
            -- PEGAR A MISSÃO
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                -- Fica de frente pro NPC
                player.Character.HumanoidRootPart.CFrame = CFrame.new(1060, 16, 1547)
                task.wait(0.5)
                -- Chama o servidor para iniciar a quest 1
                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", "BanditQuest1", 1)
                task.wait(1)
            end
        else
            -- FAZER A MISSÃO (ATACAR)
            local alvo = acharBandit()
            
            if alvo and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                local alvoHrp = alvo.HumanoidRootPart
                
                -- Pega a arma de combate
                local arma = equiparMelee()
                
                -- Se posiciona 5 studs exatamente ACIMA do inimigo e olha para baixo
                hrp.CFrame = alvoHrp.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                
                -- Trava a gravidade/movimento para o personagem não escorregar e bugar o ataque
                hrp.Velocity = Vector3.new(0, 0, 0)
                
                -- Ataca usando a função nativa da ferramenta (Funciona liso no Delta Executor)
                if arma then
                    arma:Activate()
                end
            end
        end
    end
end)
