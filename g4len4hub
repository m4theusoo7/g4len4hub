-- OmegaCore: Módulo Ilha da Selva (Níveis 10 ao 30)
-- Otimizado para Delta Executor

_G.AutoFarm_Selva = true
_G.DistanciaAtaque = 7 -- Altura ideal acima do mob para evitar ficar preso no hitbox do chão

local plr = game.Players.LocalPlayer
local rs = game:GetService("RunService")
local vu = game:GetService("VirtualUser")
local vim = game:GetService("VirtualInputManager")

-- Anti-AFK
plr.Idled:Connect(function()
    vu:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    task.wait(1)
    vu:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

-- Noclip Constante para evitar travar nas árvores da selva
rs.Stepped:Connect(function()
    if _G.AutoFarm_Selva and plr.Character then
        for _, part in pairs(plr.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Movimentação Híbrida (Tween/CFrame)
local function MoverPara(alvoCFrame)
    if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = plr.Character.HumanoidRootPart
    local distancia = (hrp.Position - alvoCFrame.Position).Magnitude

    if distancia > 250 then
        local tweenInfo = TweenInfo.new(distancia / 300, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = alvoCFrame})
        tween:Play()
    else
        hrp.CFrame = alvoCFrame
    end
end

-- Auto Equipar Melee/Espada
local function EquiparArma()
    for _, tool in pairs(plr.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword") then
            plr.Character.Humanoid:EquipTool(tool)
        end
    end
end

-- Spam de Skills do OmegaCore
local function UsarSkills()
    local skills = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}
    for _, key in ipairs(skills) do
        vim:SendKeyEvent(true, key, false, game)
        task.wait(0.05)
        vim:SendKeyEvent(false, key, false, game)
    end
end

-- Loop de Farm da Selva
task.spawn(function()
    while task.wait() do
        if not _G.AutoFarm_Selva then break end
        
        pcall(function()
            local nivel = plr.Data.Level.Value
            local questNome = "Jungle Quest"
            local mobNome = ""
            local questId = 1
            local npcQuestCFrame = CFrame.new(-1602.5, 36.8, 152.4) -- Jungle Adventurer

            -- Sistema de Progressão de Nível
            if nivel >= 10 and nivel < 15 then
                mobNome = "Monkey"
                questId = 1
            elseif nivel >= 15 and nivel <= 30 then
                mobNome = "Gorilla"
                questId = 2
            else
                _G.AutoFarm_Selva = false
                print("[OmegaCore] Nível fora da rota da Selva. Preparando transição para Vila Pirata.")
                return
            end

            -- Validação de Missão
            local questContainer = plr.PlayerGui.Main.Quest.Container
            local temMissao = questContainer.Visible
            local missaoCorreta = false
            
            if temMissao then
                local titulo = questContainer.QuestTitle.Title.Text
                if string.find(titulo, mobNome) then
                    missaoCorreta = true
                else
                    -- Cancela missão errada
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("AbandonQuest")
                end
            end

            if not missaoCorreta then
                MoverPara(npcQuestCFrame)
                if (plr.Character.HumanoidRootPart.Position - npcQuestCFrame.Position).Magnitude < 10 then
                    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questNome, questId)
                end
            else
                -- Lógica de Combate
                local mobEncontrado = false
                
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
                    if string.find(mob.Name, mobNome) and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                        mobEncontrado = true
                        
                        -- CFrame offset fixo apontando para baixo
                        local posAtaque = mob.HumanoidRootPart.CFrame * CFrame.new(0, _G.DistanciaAtaque, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                        MoverPara(posAtaque)
                        
                        EquiparArma()
                        vu:ClickButton1(Vector2.new()) -- Auto-click
                        UsarSkills()
                        
                        break -- Focar em 1 mob por vez
                    end
                end
                
                -- Ponto de espera (mobPos) seguro acima do respawn para evitar o bug de flutuação infinita
                if not mobEncontrado then
                    local waitPos = (mobNome == "Monkey") and CFrame.new(-1620, 60, 140) or CFrame.new(-1160, 60, 330)
                    MoverPara(waitPos)
                end
            end
        end)
    end
end)
