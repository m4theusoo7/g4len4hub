-- 5. MISSÃO E COMBATE
local function HasActiveQuest()
    local gui = player.PlayerGui
    if gui:FindFirstChild("Main") and gui.Main:FindFirstChild("Quest") then
        return gui.Main.Quest.Visible
    end
    return false
end

local function AutoAttack()
    virtualInput:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    task.wait(0.05)
    virtualInput:SendMouseButtonEvent(0, 0, 0, false, game, 1)
end

local function FireSkill(key)
    virtualInput:SendKeyEvent(true, Enum.KeyCode[key], false, game)
    task.wait(0.1)
    virtualInput:SendKeyEvent(false, Enum.KeyCode[key], false, game)
end

local function EquipWeapon()
    local char = player.Character
    if not char then return end
    for _, tool in ipairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == getgenv().OmegaConfig.WeaponType then
            char.Humanoid:EquipTool(tool)
        end
    end
end

