local player = game.Players.LocalPlayer
local runService = game:GetService("RunService")

-- As coordenadas exatas que tu mapeou
local coords = {
    PirateAdventurer = CFrame.new(-1151.6, 16.6, 3863.1),
    PirateSpawn = CFrame.new(-1122.8, 35.0, 3965.9), 
    BruteSpawn = CFrame.new(-942.4, 45.0, 4387.2)   
}

_G.AutoFarmPirate = true
_G.TargetMob = "Pirate" -- Muda pra "Brute" no level 45

-- Noclip e Antigravidade (rodando em background)
runService.Stepped:Connect(function()
    if _G.AutoFarmPirate and player.Character then
        for _, v in pairs(player.Character:GetDescendants()) do
            if v:IsA("BasePart") and v.CanCollide then
                v.CanCollide = false
            end
        end
        if player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Loop Principal Agressivo (Sem Tween)
spawn(function()
    while task.wait() do
        if _G.AutoFarmPirate and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            
            -- Checa se a UI da Missão está ativa na tela
            local hasQuest = player.PlayerGui.Main.Quest.Visible
            
            if not hasQuest then
                -- 1. Se NÃO tem quest, teleporta pro NPC e puxa a missão
                player.Character.HumanoidRootPart.CFrame = coords.PirateAdventurer
                task.wait(0.3) -- Pausa rápida pra dar tempo de renderizar
                
                local questName = _G.TargetMob == "Pirate" and "PirateQuest" or "PirateQuest2"
                local questLevel = _G.TargetMob == "Pirate" and 1 or 2
                game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
            else
                -- 2. Já tem quest, vai pro farm
                local targetSpawn = _G.TargetMob == "Pirate" and coords.PirateSpawn or coords.BruteSpawn
                local mob = game:GetService("Workspace").Enemies:FindFirstChild(_G.TargetMob)
                
                if mob and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                    -- O bicho tá vivo: gruda em cima da cabeça dele
                    player.Character.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 12, 0)
                    
                    -- Equipa a primeira arma/estilo de luta do inventário sem travar o código
                    pcall(function()
                        local tool = player.Character:FindFirstChildOfClass("Tool")
                        if not tool then
                            for _, v in pairs(player.Backpack:GetChildren()) do
                                if v:IsA("Tool") then
                                    player.Character.Humanoid:EquipTool(v)
                                    break
                                end
                            end
                        end
                    end)
                    
                    -- Desce a porrada
                    game:GetService("VirtualUser"):CaptureController()
                    game:GetService("VirtualUser"):ClickButton1(Vector2.new(851, 158))
                else
                    -- O bicho morreu ou não spawnou: fica flutuando no local exato esperando ele nascer
                    player.Character.HumanoidRootPart.CFrame = targetSpawn
                end
            end
        end
    end
end)
