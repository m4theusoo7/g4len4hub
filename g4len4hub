-- Auto Buy Water Kung Fu (Fix Entrada Redemoinho - Delta Executor)
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")

local FALLBACK_ENTRADA = Vector3.new(3864.688, 6.737, -1926.214)
local POS_TEACHER      = Vector3.new(61577.125, 18.497, 989.399)
local TWEEN_SPEED      = 280
local noclipConn       = nil

local function setNoClip(state)
    if state then
        if noclipConn then return end
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
    end
end

local function clearBV(hrp)
    if not hrp then return end
    for _, obj in ipairs(hrp:GetChildren()) do
        if obj:IsA("BodyVelocity") then
            obj:Destroy()
        end
    end
end

local function tweenTo(targetPos)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local distance = (hrp.Position - targetPos).Magnitude
    if distance < 5 then return end

    local bv = hrp:FindFirstChild("AntiGravity") or Instance.new("BodyVelocity")
    bv.Name = "AntiGravity"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp

    local time = distance / TWEEN_SPEED
    local tween = TweenService:Create(
        hrp,
        TweenInfo.new(time, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(targetPos) }
    )
    tween:Play()
    tween.Completed:Wait()

    clearBV(hrp)
end

-- Procura a Part física real da entrada (Whirlpool / Underwater) no Workspace
local function findWhirlpoolPart()
    local bestPart = nil
    local bestDist = 400 -- raio de busca perto da coordenada conhecida

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local dist = (obj.Position - FALLBACK_ENTRADA).Magnitude
            if dist < bestDist and (obj:FindFirstChildOfClass("TouchTransmitter") or name:find("whirl") or name:find("underwater") or name:find("portal") or name:find("entrance")) then
                bestDist = dist
                bestPart = obj
            end
        end
    end
    return bestPart
end

local function hasWaterKungFu()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    return (backpack and backpack:FindFirstChild("Water Kung Fu"))
        or (char and char:FindFirstChild("Water Kung Fu"))
end

task.spawn(function()
    if hasWaterKungFu() then
        warn("[OmegaCore] Você já possui o Water Kung Fu!")
        return
    end

    local beli = LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Beli")
    if beli and beli.Value < 750000 then
        warn("[OmegaCore] Beli insuficiente! Necessário: $750.000 | Atual: $" .. tostring(beli.Value))
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    -- Passo 1: Entrar na Underwater City se estiver na superfície
    if hrp.Position.X < 50000 then
        setNoClip(true)
        -- Sobe para viajar sem bater em ilhas
        if hrp.Position.Y < 120 then
            tweenTo(Vector3.new(hrp.Position.X, 150, hrp.Position.Z))
        end
        tweenTo(Vector3.new(FALLBACK_ENTRADA.X, 150, FALLBACK_ENTRADA.Z))
        tweenTo(Vector3.new(FALLBACK_ENTRADA.X, 15, FALLBACK_ENTRADA.Z))

        -- Solta a física e NoClip para o jogo registrar o contato no redemoinho
        setNoClip(false)
        clearBV(hrp)
        task.wait(0.2)

        local portalPart = findWhirlpoolPart()
        local targetEntrancePos = portalPart and portalPart.Position or FALLBACK_ENTRADA

        local attempts = 0
        while hrp.Position.X < 50000 and attempts < 15 do
            attempts += 1

            -- Método A: Remote com a posição real da peça do portal
            pcall(function()
                CommF:InvokeServer("requestEntrance", targetEntrancePos)
            end)

            -- Método B: Se encontrou a hitbox física do redemoinho, força o TouchInterest
            if portalPart and firetouchinterest then
                pcall(function()
                    firetouchinterest(hrp, portalPart, 0)
                    task.wait(0.05)
                    firetouchinterest(hrp, portalPart, 1)
                end)
            end

            -- Método C: Encosta fisicamente no centro do redemoinho
            if hrp.Position.X < 50000 then
                hrp.CFrame = CFrame.new(targetEntrancePos + Vector3.new(0, 2, 0))
            end

            task.wait(0.35)
        end
    end

    -- Passo 2: Já dentro da Underwater City (X > 50000), vai até o Water Kung Fu Teacher
    if hrp.Position.X > 50000 then
        setNoClip(true)
        task.wait(0.3)

        tweenTo(Vector3.new(hrp.Position.X, 55, hrp.Position.Z))
        tweenTo(Vector3.new(POS_TEACHER.X, 55, POS_TEACHER.Z))
        tweenTo(POS_TEACHER)

        setNoClip(false)
        clearBV(hrp)
        task.wait(0.3)

        local result = CommF:InvokeServer("BuyFishmanKarate")
        print("[OmegaCore] Compra executada! Resposta:", tostring(result))
    else
        setNoClip(false)
        clearBV(hrp)
        warn("[OmegaCore] Não entrou no redemoinho após 15 tentativas.")
    end
end)
