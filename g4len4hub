-- A Tabela de Coordenadas que você gerou
local JungleConfig = {
    QuestNPC = { Position = Vector3.new(-1680, 48, 175) },
    Mobs = {
        Monkey = { LevelReq = 10, Position = Vector3.new(-1479, 29, 319), Name = "Monkey" },
        Gorilla = { LevelReq = 15, Position = Vector3.new(-1402, 26, -464), Name = "Gorilla" },
        GorillaKing = { LevelReq = 20, Position = Vector3.new(-1194, 10, -550), Name = "The Gorilla King" }
    }
}

-- Função de Teleporte Suave (Tween) para evitar Anti-Cheat
local function TweenTo(targetPos)
    local char = Player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetPos).Magnitude
    local speed = 300 -- Velocidade do voo
    
    local tweenInfo = TweenInfo.new(distance / speed, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPos + Vector3.new(0, 5, 0))}) -- Fica um pouco acima do alvo
    
    tween:Play()
    return tween
end

-- Função para Equipar a Arma (Melee/Soco por padrão)
local function EquipWeapon()
    for _, tool in pairs(Player.Backpack:GetChildren()) do
        if tool:IsA("Tool") and tool.ToolTip == "Melee" then -- Mude "Melee" para "Sword" se quiser usar espada
            Player.Character.Humanoid:EquipTool(tool)
        end
    end
end

-- Função para Auto-Clique (Ataque)
local function AutoClick()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton1(Vector2.new(851, 158))
end

-- Determina qual inimigo farmar com base no seu nível
local function GetTargetMob()
    local myLevel = Player.Data.Level.Value
    if myLevel >= 20 then
        return JungleConfig.Mobs.GorillaKing
    elseif myLevel >= 15 then
        return JungleConfig.Mobs.Gorilla
    else
        return JungleConfig.Mobs.Monkey
    end
end

-- Loop Principal do Auto-Farm
task.spawn(function()
    while task.wait() do
        if not getgenv().AutoFarm then break end
        
        pcall(function()
            local char = Player.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            
            local targetMobInfo = GetTargetMob()
            local targetEnemy = workspace.Enemies:FindFirstChild(targetMobInfo.Name)
            
            if targetEnemy and targetEnemy:FindFirstChild("HumanoidRootPart") and targetEnemy.Humanoid.Health > 0 then
                -- Inimigo está vivo, vai até ele e ataca
                EquipWeapon()
                TweenTo(targetEnemy.HumanoidRootPart.Position)
                AutoClick()
            else
                -- Inimigo não está na tela, vai para a coordenada de spawn aguardar
                TweenTo(targetMobInfo.Position)
            end
        end)
    end
end)

